#!/usr/bin/env bash
# Development-checkout adapter. Published installs execute the packaged native
# binary directly; this small shell boundary only finds a locally built binary.

set -euo pipefail
CDPATH=

source=${BASH_SOURCE[0]}
hops=0
while [[ -L $source ]]; do
  hops=$((hops + 1))
  [[ $hops -le 40 ]] || {
    printf 'dot: launcher symlink chain is too deep\n' >&2
    exit 1
  }
  directory=$(cd -P -- "$(dirname "$source")" && pwd -P)
  target=$(readlink "$source")
  case $target in
    /*) source=$target ;;
    *) source=$directory/$target ;;
  esac
done
root=$(cd -P -- "$(dirname "$source")/.." && pwd -P)

for profile in debug release; do
  binary=$root/target/$profile/dot
  if [[ -f $binary && ! -L $binary && -x $binary ]]; then
    exec "$binary" "$@"
  fi
done

# shellcheck disable=SC2016 # Backticks are literal user-facing command syntax.
printf 'dot: native development binary is missing; run `cargo build --locked`\n' >&2
exit 1
