    local = parent = rendezvous = None
    try:
        os.set_inheritable(control_fds[0], False)
        local_fd, parent_fd = protocol_socketpair()
        local = socket.socket(fileno=local_fd)
        local_fd = None
        parent = socket.socket(fileno=parent_fd)
        parent_fd = None
        rendezvous = socket.socket(fileno=control_fds[0])
        rights = array.array("i", [parent.fileno()])
        try:
            written = rendezvous.sendmsg(
                [frame],
                [(socket.SOL_SOCKET, socket.SCM_RIGHTS, rights)],
                getattr(socket, "MSG_DONTWAIT", 0) | getattr(socket, "MSG_NOSIGNAL", 0),
            )
        except BlockingIOError as error:
            raise OSError(errno.EAGAIN, "supervisor registration would block") from error
        if written != len(frame):
            raise OSError(errno.EIO, "short supervisor registration")
        parent.close()
        parent = None
        local.setblocking(False)
        # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
        _temp_diag(f"TEMP-DIAG-180 NESTED-PUBLISH sent pid={os.getpid()} token={token}")
        deadline = time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS
        with selectors.DefaultSelector() as selector:
            selector.register(local, selectors.EVENT_READ)
            while True:
                if interrupted_signal is not None:
                    raise InterruptedError("nested-supervisor registration interrupted")
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
                    _temp_diag(f"TEMP-DIAG-180 NESTED-PUBLISH ack timeout pid={os.getpid()}")
                    raise TimeoutError("nested-supervisor registration timed out")
                if not selector.select(min(remaining, PROCESS_POLL_SECONDS)):
                    continue
                reply = local.recv(2)
                if reply == b"\1":
                    # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
                    _temp_diag(f"TEMP-DIAG-180 NESTED-PUBLISH acked pid={os.getpid()}")
                    return local
                # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
                _temp_diag(f"TEMP-DIAG-180 NESTED-PUBLISH rejected pid={os.getpid()} reply={reply!r}")
                raise OSError(errno.EPROTO, "nested-supervisor registration was rejected")
    finally:
        if rendezvous is not None:
            rendezvous.detach()
        if parent is not None:
            parent.close()
        close_fd(parent_fd)
        close_fd(local_fd)
        if sys.exc_info()[0] is not None and local is not None:
            local.close()


def invalidate_nested_control() -> None:
    """Revoke every delegation hint after incomplete or invalid control input."""
    global nested_control_complete
    nested_control_complete = False
    for _pid, link in nested_supervisors.values():
        link.close()
    nested_supervisors.clear()


def nested_supervisor_belongs_to_session(supervisor: int, leader: int) -> bool:
    """Validate one authenticated peer inside the retained target session."""
    if supervisor == leader:
        return True
    try:
        return os.getsid(supervisor) == leader
    except (PermissionError, ProcessLookupError, OSError):
        return False


def drain_nested_supervisors(deadline: float | None = None) -> bool:
    """Incorporate every published nested owner before attributing processes."""
    global nested_control_complete
    if control_reader is None:
        return nested_control_complete
    closed = []
    for token, (_pid, link) in nested_supervisors.items():
        try:
            payload = link.recv(1, getattr(socket, "MSG_PEEK", 0))
        except BlockingIOError:
            continue
        except InterruptedError:
            continue
        except OSError:
            closed.append(token)
            continue
        if payload:
            invalidate_nested_control()
            return False
        closed.append(token)
    for token in closed:
        _pid, link = nested_supervisors.pop(token)
        link.close()
    for _ in range(128):
        if deadline is not None and time.monotonic() >= deadline:
            invalidate_nested_control()
            return False
        try:
            endpoint = socket.socket(fileno=control_reader)
            try:
                frame, ancillary, flags, _address = endpoint.recvmsg(
                    CONTROL_FRAME_BYTES + 1,
                    socket.CMSG_SPACE(array.array("i").itemsize),
                    getattr(socket, "MSG_DONTWAIT", 0),
                )
            finally:
                endpoint.detach()
        except BlockingIOError:
            return nested_control_complete
        except InterruptedError:
            continue
        except ConnectionResetError:
            # Darwin reports ECONNRESET (not EAGAIN) when the datagram
            # queue is empty: the child closes the CLOEXEC control
            # writer at exec, so a session with no nested supervisor
            # deterministically resets while Linux reports EAGAIN for
            # the same state. A reset carries no bytes and cannot
            # forge a delegation, so treat it as "no data this tick"
            # exactly like the native supervisor does.
            return nested_control_complete
        except OSError:
            invalidate_nested_control()
            return False
        received_fds: list[int] = []
        for level, kind, payload in ancillary:
            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                values = array.array("i")
                values.frombytes(payload[: len(payload) - len(payload) % values.itemsize])
                received_fds.extend(values)
        if (
            not frame
            or len(frame) != CONTROL_FRAME_BYTES
            or not frame.startswith(CONTROL_FRAME_MAGIC)
            or flags & getattr(socket, "MSG_CTRUNC", 0)
            or len(received_fds) != 1
        ):
            for descriptor in received_fds:
                close_fd(descriptor)
            invalidate_nested_control()
            return False
        supervisor = struct.unpack("!I", frame[len(CONTROL_FRAME_MAGIC):8])[0]
        token = frame[8:].decode("ascii", errors="ignore")
        link_fd = received_fds.pop()
        try:
            link_fd = normalize_internal_fd(link_fd)
            link = socket.socket(fileno=link_fd)
            link_fd = -1
            link.setblocking(False)
            if sys.platform.startswith("linux"):
                peer = struct.unpack(
                    "3i",
                    link.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12),
                )[0]
            elif sys.platform == "darwin":
                peer = struct.unpack(
                    "i",
                    link.getsockopt(
                        getattr(socket, "SOL_LOCAL", 0),
                        getattr(socket, "LOCAL_PEERPID", 2),
                        4,
                    ),
                )[0]
            else:
                raise OSError(errno.ENOTSUP, "supervisor peer identity unavailable")
        except BaseException:
            close_fd(link_fd)
            invalidate_nested_control()
            return False
        expected = process.pid if process is not None else 0
        # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
        _temp_diag(
            f"TEMP-DIAG-180 NESTED-DRAIN frame supervisor={supervisor} peer={peer} "
            f"expected={expected} token={token} dup={token in nested_supervisors}"
        )
        if (
            supervisor <= 0
            or not nested_supervisor_belongs_to_session(supervisor, expected)
            or peer != supervisor
            or not valid_boundary_token(token)
            or token in nested_supervisors
            or len(nested_supervisors) >= 1024
        ):
            # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
            _temp_diag(
                f"TEMP-DIAG-180 NESTED-DRAIN rejected supervisor={supervisor}"
            )
            link.close()
            invalidate_nested_control()
            return False
        try:
            link.sendall(b"\1")
        except OSError:
            # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
            _temp_diag(
                f"TEMP-DIAG-180 NESTED-DRAIN ack failed supervisor={supervisor}"
            )
            link.close()
            invalidate_nested_control()
            return False
        # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
        _temp_diag(f"TEMP-DIAG-180 NESTED-DRAIN acked supervisor={supervisor}")
        nested_supervisors[token] = (supervisor, link)
    # The fixed loop count is a per-call work budget, not a protocol error.
    # Every accepted supervisor is recorded before its ACK; any registration
    # still queued remains authorization-gated and cannot have launched target
    # code. The next supervision tick resumes draining.
    return nested_control_complete


def stream_requires_relay(fd: int) -> bool:
    """Return whether inheriting this caller stream can prolong pipe lifetime."""
    if 0 <= fd <= 2 and ENTRY_STDIO_MASK & (1 << fd) == 0:
        return False
    try:
        mode = os.fstat(fd).st_mode
    except OSError:
        return False
    return stat.S_ISFIFO(mode) or stat.S_ISSOCK(mode)


