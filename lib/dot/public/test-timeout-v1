    if not valid_boundary_token(token):
        raise OSError(errno.EINVAL, "invalid nested-supervisor boundary")
    frame = CONTROL_FRAME_MAGIC + struct.pack("!I", os.getpid()) + token.encode("ascii")
    if len(frame) != CONTROL_FRAME_BYTES:
        raise OSError(errno.EINVAL, "invalid nested-supervisor registration")
