#!/bin/sh
""":"
# Capture the caller's actual descriptor state before a language runtime can
# reserve a closed standard descriptor, then restart without site hooks.
exec 9>/dev/null || exit 126
dot_stdio_mask=0
if (: <&0 2>&9); then dot_stdio_mask=$((dot_stdio_mask + 1)); fi
if (: >&1 2>&9); then dot_stdio_mask=$((dot_stdio_mask + 2)); fi
if (: 3>&2 2>&9); then dot_stdio_mask=$((dot_stdio_mask + 4)); fi
exec 9>&-
exec python3 -I -S "$0" --dot-python-entry-v1 "$dot_stdio_mask" "$@"
exit 126
":"""

from __future__ import annotations

import os as _entry_os
import sys as _entry_sys
import fcntl as _entry_fcntl

# Capture stdio before this module opens any descriptors. A numeric fd that
# was closed at the wrapper boundary stays absent even if a later internal open
# reuses 0, 1, or 2.
if len(_entry_sys.argv) >= 3 and _entry_sys.argv[1] == "--dot-python-entry-v1":
    try:
        ENTRY_STDIO_MASK = int(_entry_sys.argv[2])
    except ValueError:
        _entry_os._exit(126)
    if ENTRY_STDIO_MASK < 0 or ENTRY_STDIO_MASK > 7:
        _entry_os._exit(126)
    del _entry_sys.argv[1:3]
    # Some /bin/sh implementations open the shebang script on the lowest
    # available descriptor.  If stderr was closed, that can be fd 2.  An
    # O_RDONLY descriptor for this exact script cannot be a usable caller
    # stderr, so remove the interpreter artifact without guessing about valid
    # writable redirects such as /dev/null.
    if ENTRY_STDIO_MASK & (1 << 2):
        try:
            _entry_stderr = _entry_os.fstat(2)
            _entry_script = _entry_os.stat(__file__)
            _entry_flags = _entry_fcntl.fcntl(2, _entry_fcntl.F_GETFL)
            if (
                (_entry_stderr.st_dev, _entry_stderr.st_ino)
                == (_entry_script.st_dev, _entry_script.st_ino)
                and _entry_flags & _entry_os.O_ACCMODE == _entry_os.O_RDONLY
            ):
                ENTRY_STDIO_MASK &= ~(1 << 2)
        except OSError:
            pass
    for _entry_fd in range(3):
        if ENTRY_STDIO_MASK & (1 << _entry_fd) == 0:
            try:
                _entry_os.close(_entry_fd)
            except OSError:
                pass
else:
    ENTRY_STDIO_MASK = 0
    for _entry_fd in range(3):
        try:
            _entry_os.fstat(_entry_fd)
        except OSError:
            continue
        ENTRY_STDIO_MASK |= 1 << _entry_fd

