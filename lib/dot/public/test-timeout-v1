class SessionProcess(NamedTuple):
    """One observed process-table identity inside the owned session."""

    pid: int
    group: int
    session: int
    live: bool
    start: int | None
    parent: int = 0
    delegated: bool = False
    ambiguous: bool = False


class MemberHandle:
    """A Linux pidfd that pins one exact observed process identity."""

    def __init__(self, process: SessionProcess, fd: int):
        self.process = process
        self.fd = fd
        self.signaled = False

    def close(self) -> None:
        """Release the retained kernel identity."""
        os.close(self.fd)

    def refresh(self) -> bool:
        """Refresh liveness without changing which identity the pidfd owns."""
        current = proc_process(self.process.pid)
        if current is None:
            sender = getattr(signal, "pidfd_send_signal", None)
            if sender is None:
                # An observation failure is never proof that the retained
                # identity exited. Keep it live so cleanup fails closed.
                self.process = self.process._replace(live=True)
                return True
            try:
                sender(self.fd, 0, None, 0)
            except ProcessLookupError:
                self.process = self.process._replace(live=False)
            except (PermissionError, OSError, TypeError):
                self.process = self.process._replace(live=True)
            else:
                self.process = self.process._replace(live=True)
        elif not same_process_identity(current, self.process):
            self.process = self.process._replace(live=False)
        else:
            self.process = current._replace(
                delegated=self.process.delegated,
                ambiguous=self.process.ambiguous,
            )
        return self.process.live

    def reap_if_adopted(self) -> bool:
        """Reap a direct subreaper adoptee without releasing PID authority first."""
        if self.process.parent != os.getpid() or self.process.live:
            return True
        try:
            waited, _status = os.waitpid(self.process.pid, os.WNOHANG)
        except ChildProcessError:
            current = proc_process(self.process.pid)
            return current is None or not same_process_identity(current, self.process)
        except (InterruptedError, OSError):
            return False
        return waited == self.process.pid


class CleanupResult(NamedTuple):
    """Leader status plus proof that no live session member remained."""

    status: int
    complete: bool


class CleanupIncompleteError(RuntimeError):
    """A launch failed and its owned child could not be proven reaped."""


def parse_timeout(value: str) -> float:
    """Convert a timeout value with an optional s, m, h, or d suffix."""
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    multiplier = units.get(value[-1:], 1)
    if value[-1:] in units:
        value = value[:-1]
    timeout = float(value) * multiplier
    if not math.isfinite(timeout) or timeout <= 0:
        raise ValueError("timeout must be finite and positive")
    return timeout


def capture_signal(signum: int, _frame: FrameType | None) -> None:
    """Record the first cancellation signal for the polling owner."""
    global interrupted_signal
    if interrupted_signal is None:
        interrupted_signal = signum


def drain_pending_signals() -> None:
    """Synchronously latch handled signals blocked on the current thread."""
    waiter = getattr(signal, "sigtimedwait", None)
    if waiter is not None:
        while True:
            pending = waiter(handled_signals, 0)
            if pending is None:
                return
            capture_signal(pending.si_signo, None)
    pending_reader = getattr(signal, "sigpending", None)
    pending_waiter = getattr(signal, "sigwait", None)
    if pending_reader is None or pending_waiter is None:
        return
    while True:
        pending = set(pending_reader()).intersection(handled_signals)
        if not pending:
            return
        capture_signal(pending_waiter(pending), None)


def install_signal_handlers() -> None:
    """Install one process-entry signal owner and remember caller state."""
    global previous_sigchld_handler
    previous_signal_handlers.clear()
    previous_sigchld_handler = signal.getsignal(signal.SIGCHLD)
    # The supervisor must retain wait status even when its caller ignored
    # SIGCHLD. The target disposition is restored in the authorized helper
    # immediately before exec.
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    for handled_signal in handled_signals:
        previous_signal_handlers[handled_signal] = signal.getsignal(handled_signal)
        signal.signal(handled_signal, capture_signal)


def finish(status: int, cleanup_complete: bool = True) -> int:
    """Close signal ownership without losing a signal in the handoff window."""
    global ancestor_registration, control_reader, lease_reader
    global terminal_cleanup_incomplete
    old_mask = None
    if hasattr(signal, "pthread_sigmask"):
        old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
    drain_pending_signals()
    if lease_reader is not None:
        try:
            os.close(lease_reader)
        except OSError:
            pass
        lease_reader = None
    if control_reader is not None:
        close_fd(control_reader)
        control_reader = None
    relays_complete = stop_stdio_relays(
        time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS
    )
    if status == 0 and stdio_relay_status is not None:
        status = stdio_relay_status
    cleanup_complete = cleanup_complete and relays_complete
    # Keep the immediate parent's delegation registration live until this
    # wrapper has reaped both its target and its private relays.  Closing it
    # earlier would invite the ancestor to promote and signal relay identities
    # whose statuses are still owned here.
    if ancestor_registration is not None:
        ancestor_registration.close()
        ancestor_registration = None
    for _pid, link in nested_supervisors.values():
        link.close()
    nested_supervisors.clear()
    terminal_cleanup_incomplete = not cleanup_complete
    if terminal_handoff_required:
        # The single-threaded process-entry path keeps handled signals blocked
        # and captured until terminal_exit installs final _exit handlers.
        return resolved_status(status)
    signal.signal(signal.SIGCHLD, previous_sigchld_handler)
    for handled_signal, previous in previous_signal_handlers.items():
        signal.signal(handled_signal, previous)
    drain_pending_signals()
    result = resolved_status(status)
    if old_mask is not None:
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
    previous_signal_handlers.clear()
    return result


def resolved_status(status: int, current_signal: int | None = None) -> int:
    """Apply cleanup, first-signal, then fallback-status precedence."""
    if terminal_cleanup_incomplete:
        return 125
    if interrupted_signal is not None:
        return 128 + interrupted_signal
    if current_signal is not None:
        return 128 + current_signal
    return status


def terminal_exit(status: int) -> None:
    """Atomically hand blocked cancellation signals to default disposition."""
    if hasattr(signal, "pthread_sigmask"):
        signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
    drain_pending_signals()
    for handled_signal in handled_signals:
        signal.signal(handled_signal, signal.SIG_DFL)
    drain_pending_signals()
    if terminal_cleanup_incomplete:
        os._exit(125)
    if interrupted_signal is not None:
        os._exit(128 + interrupted_signal)
    if hasattr(signal, "pthread_sigmask"):
        # Default dispositions are kernel actions, unlike Python callbacks.
        # A pending signal terminates synchronously during unmask; a new one in
        # the final instruction window likewise observes SIG_DFL.
        signal.pthread_sigmask(signal.SIG_UNBLOCK, handled_signals)
    os._exit(status)


def mark_timeout_expired() -> None:
    """Record that the supervisor, rather than the child, produced status 124."""
    marker = os.environ.get("DOT_TEST_TIMEOUT_EXPIRED_FILE")
    if not marker:
        return
    try:
        Path(marker).write_text("", encoding="utf-8")
    except OSError:
        # Failure to publish optional retry metadata must not replace the
        # command's authoritative timeout status.
        pass


def clear_timeout_marker() -> bool:
    """Remove stale marker state before starting a new supervised command."""
    marker = os.environ.get("DOT_TEST_TIMEOUT_EXPIRED_FILE")
    if not marker:
        return True
    try:
        Path(marker).unlink(missing_ok=True)
    except OSError:
        return False
    return True


def adopt_descendants() -> bool:
    """Enable required Linux orphan ownership; report portable capability."""
    if not sys.platform.startswith("linux"):
        return False
    try:
        import ctypes
    except ImportError as error:
        raise OSError(errno.ENOSYS, "Linux subreaper support is unavailable") from error

    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        raise OSError(ctypes.get_errno(), "prctl(PR_SET_CHILD_SUBREAPER) failed")
    return True


def bind_linux_parent_death(expected_parent: int) -> None:
    """Make a relay die even while blocked if its owning wrapper disappears."""
    if not sys.platform.startswith("linux"):
        return
    try:
        import ctypes
    except ImportError:
        os._exit(125)
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(1, signal.SIGKILL, 0, 0, 0) != 0:  # PR_SET_PDEATHSIG
        os._exit(125)
    # Close the fork-to-prctl race: parent death before prctl does not enqueue
    # the requested signal retroactively.
    if os.getppid() != expected_parent:
        os._exit(0)


def lease_closed() -> bool:
    """Return whether every ordinary descendant closed its inherited lease."""
    if lease_reader is None:
        return True
    try:
        return os.read(lease_reader, 1) == b""
    except BlockingIOError:
        return False
    except InterruptedError:
        return False
    except OSError:
        return False


def authorize_launch(_pid: int) -> bool:
    """Consume a signal pending in the fork-to-exec window before authorization."""
    if interrupted_signal is not None:
        return False
    drain_pending_signals()
    return interrupted_signal is None


def write_all_fd(fd: int, payload: bytes) -> None:
    """Write one small launch-protocol frame."""
    offset = 0
    while offset < len(payload):
        try:
            written = os.write(fd, payload[offset:])
        except InterruptedError:
            continue
        if written <= 0:
            raise OSError(errno.EPIPE, "launch protocol pipe closed")
        offset += written


def read_exact_fd(fd: int, size: int, deadline: float) -> bytes:
    """Read one fixed-size launch frame under an absolute deadline."""
    os.set_blocking(fd, False)
    payload = bytearray()
    with selectors.DefaultSelector() as selector:
        selector.register(fd, selectors.EVENT_READ)
        while len(payload) < size:
            if interrupted_signal is not None:
                raise InterruptedError("launch interrupted while reading protocol state")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("launch protocol exceeded its deadline")
            if not selector.select(min(remaining, PROCESS_POLL_SECONDS)):
                continue
            try:
                chunk = os.read(fd, size - len(payload))
            except (BlockingIOError, InterruptedError):
                continue
            if not chunk:
                raise OSError(errno.EPIPE, "launch protocol closed early")
            payload.extend(chunk)
    return bytes(payload)


def write_all_fd_until(fd: int, payload: bytes, deadline: float) -> None:
    """Write a bounded launch payload without defeating its deadline."""
    os.set_blocking(fd, False)
    offset = 0
    with selectors.DefaultSelector() as selector:
        selector.register(fd, selectors.EVENT_WRITE)
        while offset < len(payload):
            if interrupted_signal is not None:
                raise InterruptedError("launch interrupted while transferring target state")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("launch protocol exceeded its deadline")
            if not selector.select(min(remaining, PROCESS_POLL_SECONDS)):
                continue
            try:
                written = os.write(fd, payload[offset:])
            except (BlockingIOError, InterruptedError):
                continue
            if written <= 0:
                raise OSError(errno.EPIPE, "launch protocol pipe closed")
            offset += written


def encode_launch_config(
    argv: Sequence[str], child_env: dict[str, str]
) -> bytes:
    """Encode target argv/env without exposing them to helper startup."""
    arguments = [os.fsencode(value) for value in argv]
    environment = [(os.fsencode(key), os.fsencode(value)) for key, value in child_env.items()]
    if not arguments or len(arguments) + len(environment) > MAX_LAUNCH_CONFIG_ITEMS:
        raise OSError(errno.E2BIG, "target launch configuration is too large")
    body = bytearray()

    def append(value: bytes) -> None:
        if b"\0" in value or len(value) > MAX_LAUNCH_CONFIG_BYTES:
            raise OSError(errno.EINVAL, "invalid target launch value")
        body.extend(struct.pack("!I", len(value)))
        body.extend(value)
        if len(body) > MAX_LAUNCH_CONFIG_BYTES:
            raise OSError(errno.E2BIG, "target launch configuration is too large")

    for argument in arguments:
        append(argument)
    for key, value in environment:
        if not key or b"=" in key:
            raise OSError(errno.EINVAL, "invalid target environment key")
        append(key)
        append(value)
    return struct.pack(
        "!4sIII", LAUNCH_CONFIG_MAGIC, len(arguments), len(environment), len(body)
    ) + body


def decode_launch_config(fd: int) -> tuple[list[bytes], dict[bytes, bytes]]:
    """Decode one bounded target configuration inside the fresh helper."""
    deadline = time.monotonic() + LAUNCH_PROTOCOL_TIMEOUT_SECONDS
    header = read_exact_fd(fd, struct.calcsize("!4sIII"), deadline)
    magic, argument_count, environment_count, body_size = struct.unpack("!4sIII", header)
    if (
        magic != LAUNCH_CONFIG_MAGIC
        or argument_count == 0
        or argument_count + environment_count > MAX_LAUNCH_CONFIG_ITEMS
        or body_size > MAX_LAUNCH_CONFIG_BYTES
    ):
        raise OSError(errno.EINVAL, "invalid target launch configuration")
    body = read_exact_fd(fd, body_size, deadline)
    offset = 0

    def take() -> bytes:
        nonlocal offset
        if offset + 4 > len(body):
            raise OSError(errno.EINVAL, "truncated target launch configuration")
        size = struct.unpack("!I", body[offset : offset + 4])[0]
        offset += 4
        if offset + size > len(body):
            raise OSError(errno.EINVAL, "truncated target launch configuration")
        value = body[offset : offset + size]
        offset += size
        if b"\0" in value:
            raise OSError(errno.EINVAL, "invalid target launch value")
        return value

    arguments = [take() for _ in range(argument_count)]
    environment: dict[bytes, bytes] = {}
    for _ in range(environment_count):
        key = take()
        value = take()
        if not key or b"=" in key or key in environment:
            raise OSError(errno.EINVAL, "invalid target environment")
        environment[key] = value
    if offset != len(body):
        raise OSError(errno.EINVAL, "oversized target launch configuration")
    return arguments, environment


def read_exec_result(fd: int, deadline: float) -> tuple[bool, int | None]:
    """Read explicit exec-attempt state and an optional structured errno."""
    os.set_blocking(fd, False)
    payload = bytearray()
    with selectors.DefaultSelector() as selector:
        selector.register(fd, selectors.EVENT_READ)
        while True:
            if interrupted_signal is not None:
                raise InterruptedError("launch interrupted before target exec completed")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("target exec did not finish before launch deadline")
            if not selector.select(min(remaining, PROCESS_POLL_SECONDS)):
                continue
            try:
                chunk = os.read(fd, 2 + LAUNCH_PROTOCOL_BYTES - len(payload))
            except (BlockingIOError, InterruptedError):
                continue
            if not chunk:
                if payload == b"A":
                    return True, None
                failure = payload[1:] if payload.startswith(b"A") else payload
                if len(failure) != 1 + LAUNCH_PROTOCOL_BYTES or failure[:1] != b"E":
                    raise OSError(errno.EPROTO, "invalid target exec result frame")
                return payload.startswith(b"A"), struct.unpack("!i", failure[1:])[0]
            payload.extend(chunk)
            if len(payload) > 2 + LAUNCH_PROTOCOL_BYTES:
                raise OSError(errno.EPROTO, "oversized target exec error frame")


def close_fd(fd: int | None) -> None:
    """Close one optional launch-protocol endpoint."""
    if fd is None or fd < 0:
        return
    try:
        os.close(fd)
    except OSError:
        pass


def normalize_internal_fd(descriptor: int) -> int:
    """Move one owned internal descriptor above stdio or close it on failure."""
    replacement: int | None = None
    try:
        if descriptor < 3:
            duplicate_command = getattr(fcntl, "F_DUPFD_CLOEXEC", fcntl.F_DUPFD)
            replacement = fcntl.fcntl(descriptor, duplicate_command, 3)
            os.set_inheritable(replacement, False)
            os.close(descriptor)
            descriptor = replacement
            replacement = None
        else:
            os.set_inheritable(descriptor, False)
        return descriptor
    except BaseException:
        close_fd(replacement)
        close_fd(descriptor)
        raise


def normalize_internal_pair(left: int, right: int) -> tuple[int, int]:
    """Normalize an owned descriptor pair with all-or-nothing cleanup."""
    normalized_left: int | None = None
    try:
        owned_left = left
        left = -1
        normalized_left = normalize_internal_fd(owned_left)
        owned_right = right
        right = -1
        normalized_right = normalize_internal_fd(owned_right)
        return normalized_left, normalized_right
    except BaseException:
        close_fd(normalized_left)
        close_fd(left)
        close_fd(right)
        raise


def protocol_pipe() -> tuple[int, int]:
    """Create a CLOEXEC pipe whose endpoints cannot alias standard streams."""
    left, right = os.pipe()
    return normalize_internal_pair(left, right)


def protocol_socketpair(kind: int = socket.SOCK_STREAM) -> tuple[int, int]:
    """Create a CLOEXEC socket pair whose endpoints cannot alias stdio."""
    left_socket = right_socket = None
    left = right = -1
    try:
        left_socket, right_socket = socket.socketpair(type=kind)
        left = left_socket.detach()
        right = right_socket.detach()
        owned_left, owned_right = left, right
        left = right = -1
        return normalize_internal_pair(owned_left, owned_right)
    except BaseException:
        close_fd(left)
        close_fd(right)
        if left_socket is not None:
            left_socket.close()
        if right_socket is not None:
            right_socket.close()
        raise


def valid_boundary_token(token: str) -> bool:
    """Validate one unforgeable boundary component."""
    return len(token) == 64 and all(character in "0123456789abcdefABCDEF" for character in token)


def extend_boundary_chain(existing: str | None, current: str) -> str:
    """Append one boundary without truncating or accepting invalid ancestry."""
    if not valid_boundary_token(current):
        raise OSError(errno.EINVAL, "invalid owned-session boundary")
    ancestors = [] if not existing else existing.split(":")
    if any(not valid_boundary_token(token) for token in ancestors):
        raise OSError(errno.EINVAL, "invalid inherited owned-session boundary")
    if len(ancestors) >= MAX_ANCESTOR_BOUNDARIES:
        raise OSError(errno.E2BIG, "too many inherited owned-session boundaries")
    return ":".join([*ancestors, current])


def validate_socket_fds(value: str | None, description: str) -> list[int]:
    """Validate a bounded inherited socket descriptor list."""
    if not value:
        return []
    fields = value.split(":")
    if len(fields) > MAX_ANCESTOR_BOUNDARIES:
        raise OSError(errno.EINVAL, f"too many inherited {description} descriptors")
    descriptors: list[int] = []
    for field in fields:
        if not field.isdecimal() or str(int(field)) != field:
            raise OSError(errno.EINVAL, f"invalid inherited {description} descriptor")
        descriptor = int(field)
        if descriptor < 3 or descriptor in descriptors:
            raise OSError(errno.EINVAL, f"invalid inherited {description} descriptor")
        try:
            metadata = os.fstat(descriptor)
        except OSError as error:
            raise OSError(
                errno.EINVAL, f"invalid inherited {description} descriptor"
            ) from error
        if not stat.S_ISSOCK(metadata.st_mode):
            raise OSError(errno.EINVAL, f"inherited {description} descriptor is not a socket")
        descriptors.append(descriptor)
    return descriptors


def validate_lease_fds(value: str | None) -> list[int]:
    """Validate a bounded ancestor-lease descriptor list without widening it."""
    return validate_socket_fds(value, "session lease")


def validate_control_fds(value: str | None) -> list[int]:
    """Validate the immediate-parent supervisor rendezvous."""
    descriptors = validate_socket_fds(value, "supervisor control")
    if len(descriptors) > 1:
        raise OSError(errno.EINVAL, "nested supervision requires one parent control")
    return descriptors


def publish_nested_supervisor(
    control_fds: list[int], chain: str
) -> socket.socket | None:
    """Register one private session link with the immediate parent."""
    if not control_fds:
        return None
    if len(control_fds) != 1:
        raise OSError(errno.EINVAL, "nested supervision requires one parent control")
