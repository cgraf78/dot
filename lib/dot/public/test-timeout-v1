            close_fd(parent_write)
            close_fd(source if source >= 3 else None)
            close_fd(destination if destination >= 3 else None)
            close_relay_specs(relay_specs)
            relay_specs.clear()
            raise
        if pid == 0:
            try:
                close_fd(state_read)
                close_fd(parent_write)
                stdio_relay_watchdog(
                    direction,
                    source,
                    destination,
                    state_write,
                    parent_read,
                    boundary_chain,
                )
            except BaseException:
                os._exit(1)
        stdio_relay_pids[pid] = direction
        stdio_relay_state_fds[pid] = state_read
        stdio_relay_states[pid] = b""
        stdio_relay_parent_fds[pid] = parent_write
        close_fd(state_write)
        close_fd(parent_read)
        if source >= 3:
            close_fd(source)
        if destination >= 3:
            close_fd(destination)


def close_relay_specs(relay_specs: list[tuple[str, int, int]]) -> None:
    """Close prepared internal endpoints when target launch never completes."""
    for _direction, source, destination in relay_specs:
        if source >= 3:
            close_fd(source)
        if destination >= 3:
            close_fd(destination)


def poll_stdio_relay_states() -> None:
    """Drain bounded relay-state datagrams without delaying supervision."""
    for pid, descriptor in list(stdio_relay_state_fds.items()):
        endpoint = socket.socket(fileno=descriptor)
        try:
            for _ in range(128):
                try:
                    state = endpoint.recv(2)
                except BlockingIOError:
                    break
                except InterruptedError:
                    continue
                except OSError:
                    stdio_relay_states[pid] = b"X"
                    break
                if state not in (b"R", b"W", b"C", b"E"):
                    stdio_relay_states[pid] = b"X"
                    break
                stdio_relay_states[pid] = state
        finally:
            endpoint.detach()


def stop_stdio_relays(deadline: float) -> bool:
    """Boundedly drain, then kill and reap all wrapper-owned relay processes."""
    global stdio_relay_status
    pending = dict(stdio_relay_pids)
    intentionally_killed: set[int] = set()
    complete = True

    def forget_relay(pid: int) -> None:
        stdio_relay_pids.pop(pid, None)
        close_fd(stdio_relay_state_fds.pop(pid, None))
        stdio_relay_states.pop(pid, None)
        close_fd(stdio_relay_parent_fds.pop(pid, None))

    def record_status(pid: int, status: int) -> None:
        global stdio_relay_status
        if (
            pid in intentionally_killed
            and os.WIFSIGNALED(status)
            and os.WTERMSIG(status) == signal.SIGKILL
        ):
            return
        if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0:
            return
        if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 128 + signal.SIGPIPE:
            failure = 128 + signal.SIGPIPE
        elif os.WIFSIGNALED(status) and os.WTERMSIG(status) == signal.SIGPIPE:
            failure = 128 + signal.SIGPIPE
        else:
            failure = 1
        if stdio_relay_status is None:
            stdio_relay_status = failure

    # Observe already-terminal input relays before issuing our own SIGKILL so
    # an independent exec/I/O failure cannot be mislabeled intentional.
    poll_stdio_relay_states()
    for pid in list(pending):
        try:
            waited, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            waited, status = pid, 0
        except (InterruptedError, OSError):
            continue
        if waited == pid:
            record_status(pid, status)
            pending.pop(pid)
            forget_relay(pid)
    for pid, direction in pending.items():
        if direction != "input":
            continue
        # Closing the private liveness writer asks the isolated watchdog to
        # kill and reap its possibly blocked relay.  The wrapper never has to
        # wait on the process that performs external I/O.
        close_fd(stdio_relay_parent_fds.pop(pid, None))
        intentionally_killed.add(pid)
    while pending and time.monotonic() < deadline:
        poll_stdio_relay_states()
        for pid in list(pending):
            try:
                waited, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                waited = pid
                status = 0
            except (InterruptedError, OSError):
                continue
            if waited == pid:
                record_status(pid, status)
                pending.pop(pid)
                forget_relay(pid)
        if pending:
            time.sleep(min(PROCESS_POLL_SECONDS, max(0.0, deadline - time.monotonic())))
    for pid, direction in pending.items():
        if direction == "output":
            relay_state = stdio_relay_states.get(pid, b"")
            if relay_state == b"C" and stdio_relay_status is None:
                stdio_relay_status = 1
            elif relay_state != b"C":
                complete = False
        close_fd(stdio_relay_parent_fds.pop(pid, None))
    kill_deadline = time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS
    while pending and time.monotonic() < kill_deadline:
        poll_stdio_relay_states()
        for pid in list(pending):
            try:
                waited, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                waited = pid
                status = 0
            except (InterruptedError, OSError):
                continue
            if waited == pid:
                record_status(pid, status)
                pending.pop(pid)
                forget_relay(pid)
        if pending:
            time.sleep(
                min(PROCESS_POLL_SECONDS, max(0.0, kill_deadline - time.monotonic()))
            )
    for pid in pending:
        # The watchdog is a retained session leader.  A final group KILL is
        # safe even on platforms without pidfds and cannot target the caller's
        # foreground process group.
        try:
            os.killpg(pid, signal.SIGKILL)
        except (PermissionError, ProcessLookupError):
            pass
    return complete and not pending


def stop_launch_helper(child: subprocess.Popen) -> None:
    """Kill and reap a helper that never completed safe target exec."""
    try:
        child.kill()
    except (PermissionError, ProcessLookupError):
        pass
    try:
        child.wait(timeout=PROCESS_SNAPSHOT_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired as error:
        raise CleanupIncompleteError(
            "launch helper did not reap before its deadline"
        ) from error


def launch_helper(argv: Sequence[str]) -> None:
    """Fresh single-threaded process that establishes an authorized session."""
    if not sys.flags.isolated or not sys.flags.no_site:
        os._exit(126)
    if len(argv) != 11:
        os._exit(126)
    try:
        ready_write = int(argv[2])
        authorize_read = int(argv[3])
        lease_write = int(argv[4])
        error_write = int(argv[5])
        config_read = int(argv[6])
        encoded_mask = argv[7]
        lease_fds = validate_lease_fds(argv[8])
        target_sigchld = argv[9]
        control_fds = validate_control_fds(argv[10])
    except ValueError:
        os._exit(126)
    exec_attempted = False
    try:
        # Popen passed only these five descriptors. Protocol/error endpoints
        # close on target exec; the lifetime lease alone intentionally remains.
        os.set_inheritable(ready_write, False)
        os.set_inheritable(authorize_read, False)
        os.set_inheritable(error_write, False)
        os.set_inheritable(config_read, False)
        if lease_write not in lease_fds:
            raise OSError(errno.EINVAL, "own session lease is missing")
        for descriptor in lease_fds:
            os.set_inheritable(descriptor, True)
        for descriptor in control_fds:
            os.set_inheritable(descriptor, True)
        if os.getsid(0) != os.getpid():
            raise OSError(errno.EPERM, "launch helper did not become session leader")
        target, target_env = decode_launch_config(config_read)
        close_fd(config_read)
        config_read = -1
        write_all_fd(ready_write, struct.pack("!I", os.getpid()))
        close_fd(ready_write)
        ready_write = -1
        decision = read_exact_fd(
            authorize_read,
            1,
            time.monotonic() + LAUNCH_PROTOCOL_TIMEOUT_SECONDS,
        )
        close_fd(authorize_read)
        authorize_read = -1
        if decision != b"\1":
            os._exit(125)
        old_mask = (
            set()
            if encoded_mask == "-"
            else {int(value) for value in encoded_mask.split(",") if value}
        )
        write_all_fd(error_write, b"A")
        exec_attempted = True
        for restored_signal in handled_signals + subprocess_restored_signals:
            signal.signal(restored_signal, signal.SIG_DFL)
        signal.signal(
            signal.SIGCHLD,
            signal.SIG_IGN if target_sigchld == "I" else signal.SIG_DFL,
        )
        if hasattr(signal, "pthread_sigmask"):
            signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
        os.execvpe(target[0], target, target_env)
    except BaseException as error:
        error_number = (
            error.errno if isinstance(error, OSError) and error.errno else errno.EIO
        )
        try:
            write_all_fd(error_write, b"E" + struct.pack("!i", error_number))
        except BaseException:
            pass
        os._exit(127 if error_number == errno.ENOENT else 126)


def launch_process(argv: Sequence[str], child_env: dict[str, str]) -> subprocess.Popen | None:
    """Launch through a freshly execed, single-threaded authorization helper."""
    global ancestor_registration, control_reader, lease_reader, process
    if interrupted_signal is not None:
        return None
    old_mask = None
    if hasattr(signal, "pthread_sigmask"):
        old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
    ready_read = ready_write = None
    authorize_read = authorize_write = None
    read_fd = lease_write = None
    control_read = control_write = None
    error_read = error_write = None
    config_read = config_write = None
    child: subprocess.Popen | None = None
    authorized = False
    lease_fds: list[int] = []
    popen_stdio: dict[str, int] = {}
    relay_specs: list[tuple[str, int, int]] = []
    child_endpoints: list[int] = []
    try:
        popen_stdio, relay_specs, child_endpoints = prepare_stdio_relays()
        ready_read, ready_write = protocol_pipe()
        authorize_read, authorize_write = protocol_pipe()
        inherited_lease_fds = validate_lease_fds(child_env.get(SESSION_LEASE_FDS_ENV))
        inherited_control_fds = validate_control_fds(
            child_env.get(SESSION_CONTROL_FDS_ENV)
        )
        ancestor_registration = publish_nested_supervisor(
            inherited_control_fds, child_env[SESSION_BOUNDARY_ENV]
        )
        read_fd, lease_write = protocol_socketpair()
        control_read, control_write = protocol_socketpair(socket.SOCK_DGRAM)
        os.set_blocking(control_read, False)
        control_reader = control_read
        control_read = None
        lease_fds = [*inherited_lease_fds, lease_write]
        # The target receives only this wrapper's immediate-parent
        # rendezvous.  Ancestor controls and the private registration link
        # remain supervisor-owned and close on wrapper failure.
        control_fds = [control_write]
        child_env = child_env.copy()
        child_env[SESSION_LEASE_FDS_ENV] = ":".join(str(fd) for fd in lease_fds)
        child_env[SESSION_CONTROL_FDS_ENV] = ":".join(str(fd) for fd in control_fds)
        boundary_count = len(child_env[SESSION_BOUNDARY_ENV].split(":"))
        if (
            boundary_count != len(lease_fds)
            or len(inherited_control_fds) != int(boundary_count > 1)
            or len(control_fds) != 1
        ):
            raise OSError(errno.EINVAL, "owned-session boundary and lease chains differ")
        launch_config = encode_launch_config(argv, child_env)
        error_read, error_write = protocol_pipe()
        config_read, config_write = protocol_pipe()
        os.set_blocking(read_fd, False)
        lease_reader = read_fd
        read_fd = None
        encoded_mask = (
            "-"
            if old_mask is None
            else ",".join(str(int(signum)) for signum in sorted(old_mask))
        )
        helper = [
            sys.executable,
            "-I",
            "-S",
            str(Path(__file__).resolve()),
            LAUNCH_HELPER_MODE,
            str(ready_write),
            str(authorize_read),
            str(lease_write),
            str(error_write),
            str(config_read),
            encoded_mask,
            child_env[SESSION_LEASE_FDS_ENV],
            "I" if previous_sigchld_handler == signal.SIG_IGN else "D",
            child_env[SESSION_CONTROL_FDS_ENV],
        ]
        child = subprocess.Popen(
            helper,
            env={},
            close_fds=True,
            pass_fds=tuple(
                sorted(
                    {
                        ready_write,
                        authorize_read,
                        error_write,
                        config_read,
                        *lease_fds,
                        *control_fds,
                    }
                )
            ),
            start_new_session=True,
            **popen_stdio,
        )
        # Retain the exact child status before the spawning thread can accept
        # cancellation again. The helper is still blocked on its private
        # config/authorization protocol and cannot execute the target.
        process = child
        for descriptor in child_endpoints:
            close_fd(descriptor)
        child_endpoints.clear()
        if old_mask is not None:
            signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
            old_mask = None
        close_fd(ready_write)
        ready_write = None
        close_fd(authorize_read)
        authorize_read = None
        close_fd(lease_write)
        lease_write = None
        close_fd(control_write)
        control_write = None
        close_fd(error_write)
        error_write = None
        close_fd(config_read)
        config_read = None

        protocol_deadline = time.monotonic() + LAUNCH_PROTOCOL_TIMEOUT_SECONDS
        write_all_fd_until(config_write, launch_config, protocol_deadline)
        close_fd(config_write)
        config_write = None
        helper_pid = struct.unpack(
            "!I", read_exact_fd(ready_read, LAUNCH_PROTOCOL_BYTES, protocol_deadline)
        )[0]
        close_fd(ready_read)
        ready_read = None
        if helper_pid != child.pid or os.getsid(child.pid) != child.pid:
            raise OSError(errno.EPROTO, "launch authorization did not match child session")
        authorization_mask = None
        if hasattr(signal, "pthread_sigmask"):
            authorization_mask = signal.pthread_sigmask(
                signal.SIG_BLOCK, handled_signals
            )
        try:
            allowed = authorize_launch(child.pid)
            allowed = allowed and interrupted_signal is None
            if allowed:
                # From this point onward any ambiguity is cleaned as a fully
                # owned target session. A failed allow write is a safe false
                # positive; treating a successful write as helper-only would
                # permit an exec/fork survivor on later parent errors.
                authorized = True
            write_all_fd(authorize_write, b"\1" if allowed else b"\0")
        finally:
            if authorization_mask is not None:
                signal.pthread_sigmask(signal.SIG_SETMASK, authorization_mask)
        close_fd(authorize_write)
        authorize_write = None
        if not allowed:
            stop_launch_helper(child)
            process = None
            close_fd(lease_reader)
            lease_reader = None
            close_fd(control_reader)
            control_reader = None
            return None
        exec_attempted, exec_error = read_exec_result(error_read, protocol_deadline)
        close_fd(error_read)
        error_read = None
        if exec_error is not None:
            child.wait(timeout=PROCESS_SNAPSHOT_TIMEOUT_SECONDS)
            process = None
            close_fd(lease_reader)
            lease_reader = None
            close_fd(control_reader)
            control_reader = None
            if exec_error == errno.ENOENT:
                raise FileNotFoundError(exec_error, os.strerror(exec_error), argv[0])
            raise OSError(exec_error, os.strerror(exec_error), argv[0])
        if not exec_attempted:
            raise OSError(errno.EPROTO, "target exec was never attempted")
        start_stdio_relays(relay_specs, child_env[SESSION_BOUNDARY_ENV])
        relay_specs.clear()
        return child
    except BaseException:
        if child is not None and process is child and authorized:
            cleanup = stop_process_group(signal.SIGKILL)
            process = None
            if not cleanup.complete:
                close_fd(lease_reader)
                lease_reader = None
                close_fd(control_reader)
                control_reader = None
                if ancestor_registration is not None:
                    ancestor_registration.close()
                    ancestor_registration = None
                raise CleanupIncompleteError(
                    "authorized launch cleanup could not be verified"
                )
        else:
            if child is not None and process is child:
                process = None
            if child is not None and child.poll() is None:
                stop_launch_helper(child)
        close_fd(lease_reader)
        lease_reader = None
        close_fd(control_reader)
        control_reader = None
        if ancestor_registration is not None:
            ancestor_registration.close()
            ancestor_registration = None
        close_relay_specs(relay_specs)
        raise
    finally:
        for descriptor in (
            ready_read,
            ready_write,
            authorize_read,
            authorize_write,
            read_fd,
            lease_write,
            control_read,
            control_write,
            error_read,
            error_write,
            config_read,
            config_write,
            *child_endpoints,
        ):
            close_fd(descriptor)
        if old_mask is not None:
            signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)


def parse_proc_process(pid: int, stat: bytes) -> SessionProcess | None:
    """Parse one Linux procfs stat row without trusting the command name."""
    delimiter = stat.rfind(b") ")
    if delimiter < 0:
        return None
    fields = stat[delimiter + 2 :].split()
    if len(fields) < 20:
        return None
    try:
        return SessionProcess(
            pid=pid,
            group=int(fields[2]),
            session=int(fields[3]),
            live=fields[0] != b"Z",
            start=int(fields[19]),
            parent=int(fields[1]),
        )
    except ValueError:
        return None


def list_proc_session_processes(
    session_id: int,
    proc_root: Path = Path("/proc"),
    deadline: float | None = None,
) -> list[SessionProcess] | None:
    """Return one Linux session's identities, or None when unavailable."""
    try:
        entries = list(proc_root.iterdir())
    except OSError:
        return None

    processes: list[SessionProcess] = []
    for entry in entries:
        if deadline is not None and time.monotonic() >= deadline:
            return None
        if not entry.name.isdecimal():
            continue
        try:
            stat = (entry / "stat").read_bytes()
        except FileNotFoundError:
            # Processes can disappear during collection.
            continue
        except PermissionError:
            return None
        except OSError:
            # A partial snapshot is not authoritative. Let the caller use its
            # platform fallback instead of silently omitting a live member.
            return None

        try:
            pid = int(entry.name)
        except ValueError:
            return None
        process = parse_proc_process(pid, stat)
        if process is None:
            return None
        processes.append(process)
    return owned_processes(processes, session_id, deadline)


def list_proc_session_pids(
    session_id: int, proc_root: Path = Path("/proc")
) -> list[int] | None:
    """Return one Linux session's PIDs, or None when procfs is unavailable."""
    processes = list_proc_session_processes(session_id, proc_root)
    if processes is None:
        return None
    return [process.pid for process in processes]


def list_session_pids(session_id: int) -> list[int] | None:
    """Return a portable PID snapshot for one session, or None when unavailable."""
    processes = list_session_processes(session_id)
    if processes is None:
        return None
    return [process.pid for process in processes]


def list_session_processes(
    session_id: int,
    timeout: float = PROCESS_SNAPSHOT_TIMEOUT_SECONDS,
) -> list[SessionProcess] | None:
    """Return a portable process snapshot for one retained session."""
    deadline = time.monotonic() + timeout
    processes = list_proc_session_processes(session_id, deadline=deadline)
    if processes is not None:
        return processes

    ps_process = None
    try:
        ps = "/system/bin/ps" if Path("/system/bin/ps").is_file() else "/bin/ps"
        # Darwin `ps` rejects the procps-only `sid` keyword
        # (`ps: sid: keyword not found`, exit 1); its `sess` column
        # carries the same session ID. Verified on macOS CI.
        columns = (
            "pid=,ppid=,pgid=,sess=,stat="
            if sys.platform == "darwin"
            else "pid=,ppid=,pgid=,sid=,stat="
        )
        ps_process = subprocess.Popen(
            [ps, "-A", "-o", columns],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        output, _ = ps_process.communicate(
            timeout=max(0.001, deadline - time.monotonic())
        )
        if ps_process.returncode != 0:
            return None
    except (OSError, subprocess.SubprocessError):
        if ps_process is not None:
            try:
                ps_process.kill()
                ps_process.wait(timeout=PROCESS_SNAPSHOT_TIMEOUT_SECONDS)
            except (OSError, subprocess.SubprocessError):
                pass
        return None

    return parse_ps_snapshot(output, session_id, {ps_process.pid}, deadline)


def parse_ps_snapshot(
    output: str,
    session_id: int,
    excluded_pids: set[int] | None = None,
    deadline: float | None = None,
) -> list[SessionProcess] | None:
    """Parse complete atomic ps rows; any malformed nonblank row invalidates."""
    processes: list[SessionProcess] = []
    for line in output.splitlines():
        if not line.strip():
            continue
        fields = line.split()
        if len(fields) != 5:
            return None
        try:
            pid = int(fields[0])
            parent = int(fields[1])
            group = int(fields[2])
            session = int(fields[3])
        except ValueError:
            return None
        if excluded_pids is not None and pid in excluded_pids:
            continue
        processes.append(
            SessionProcess(
                pid=pid,
                group=group,
                session=session,
                live=not fields[4].startswith("Z"),
                start=None,
                parent=parent,
            )
        )
    return owned_processes(processes, session_id, deadline)


def process_boundary_tokens(pid: int) -> list[bytes] | None:
    """Read one bounded marker chain; None means the identity was unqueryable."""
    try:
        with open(f"/proc/{pid}/environ", "rb") as environ:
            data = environ.read(MAX_ENVIRON_BYTES + 1)
    except OSError:
        return None
    if len(data) > MAX_ENVIRON_BYTES:
        return None
    prefix = f"{SESSION_BOUNDARY_ENV}=".encode()
    for entry in data.split(b"\0"):
        if entry.startswith(prefix):
            return entry[len(prefix) :].split(b":")
    return []


def process_boundary(pid: int, expected: str) -> str:
    """Classify one inherited Linux ownership marker."""
    tokens = process_boundary_tokens(pid)
    if tokens is None:
        return "unknown"
    matching = [index for index, token in enumerate(tokens) if token == expected.encode()]
    if matching:
        return "matches" if matching[-1] + 1 == len(tokens) else "delegated"
    if tokens:
        return "foreign"
    return "absent"


def owned_processes(
    processes: list[SessionProcess],
    session_id: int,
    deadline: float | None = None,
) -> list[SessionProcess] | None:
    """Resolve ownership with indexed ancestry and lazy marker inspection."""
    by_pid = {item.pid: item for item in processes}
    children: dict[int, list[int]] = {}
    for item in processes:
        children.setdefault(item.parent, []).append(item.pid)

    owned: set[int] = set()
    delegated: set[int] = set()
    ambiguous: set[int] = set()
    queue: list[int] = []

    def add(pid: int, *, is_delegated: bool = False, is_ambiguous: bool = False) -> None:
        if pid in stdio_relay_pids:
            return
        if pid not in owned:
            owned.add(pid)
            queue.append(pid)
        if is_delegated:
            delegated.add(pid)
        if is_ambiguous:
            ambiguous.add(pid)

    if session_id in by_pid:
        add(session_id)

    # Linux subreaper adoption is a stable kernel relationship. Missing or
    # absent markers are attributable while this is the sole wrapper; an
    # explicit foreign marker is retained only as ambiguous liveness so it can
    # never be signaled or used to certify successful cleanup.
    if subreaper_enabled and boundary_token is not None:
        for item in processes:
            if deadline is not None and time.monotonic() >= deadline:
                return None
            if item.pid == session_id or item.parent != os.getpid():
                continue
            # Reparenting to this subreaper after the registered nearer owner
            # exits is the promotion event. This single-threaded wrapper has
            # no other unregistered child source, so even a stale foreign
            # marker cannot veto direct-parent kernel authority.
            add(item.pid)

    live_supervisors = {
        pid
        for pid, _link in nested_supervisors.values()
        if (item := by_pid.get(pid)) is not None and item.live
    }
    index = 0
    while index < len(queue):
        if deadline is not None and time.monotonic() >= deadline:
            return None
        parent_pid = queue[index]
        index += 1
        inherited_delegation = parent_pid in delegated or parent_pid in live_supervisors
        for child_pid in children.get(parent_pid, ()):
            add(
                child_pid,
                is_delegated=inherited_delegation,
                is_ambiguous=parent_pid in ambiguous,
            )

    # A same-session identity whose parent vanished during an otherwise
    # complete snapshot remains visible. Attribute only that narrow cohort and
    # inspect its marker lazily rather than scanning every host process.
    for item in processes:
        if deadline is not None and time.monotonic() >= deadline:
            return None
        if item.pid in owned or item.pid in stdio_relay_pids or item.session != session_id:
            continue
        marker = (
            process_boundary(item.pid, boundary_token)
            if boundary_token is not None
            else "unknown"
        )
        add(
            item.pid,
            # Only a live registered owner establishes delegation. Marker
            # chains remain redundant attribution, not raw-PID authority.
            is_delegated=False,
            is_ambiguous=marker == "foreign",
        )

    return sorted(
        (
            item._replace(
                delegated=item.pid in delegated,
                ambiguous=item.pid in ambiguous,
            )
            for item in processes
            if item.pid in owned
        ),
        key=lambda item: item.pid,
    )


def proc_process(pid: int, proc_root: Path = Path("/proc")) -> SessionProcess | None:
    """Read one Linux identity for post-pidfd validation."""
    try:
        stat = (proc_root / str(pid) / "stat").read_bytes()
    except OSError:
        return None
    return parse_proc_process(pid, stat)


def same_process_identity(left: SessionProcess, right: SessionProcess) -> bool:
    """Compare the kernel identity fields that cannot change during a lifetime."""
    return (
        left.pid == right.pid and left.start is not None and left.start == right.start
    )


def claim_member(
    process_info: SessionProcess, _session_id: int
) -> tuple[MemberHandle | None, str]:
    """Pin one identity and distinguish disappearance from unavailable proof."""
    opener = getattr(os, "pidfd_open", None)
    sender = getattr(signal, "pidfd_send_signal", None)
    if opener is None or sender is None or process_info.start is None:
        if process_info.start is not None:
            current = proc_process(process_info.pid)
            if current is not None and not same_process_identity(current, process_info):
                return None, "gone"
            if current is None:
                try:
                    os.kill(process_info.pid, 0)
                except ProcessLookupError:
                    return None, "gone"
                except (PermissionError, OSError):
                    pass
        return None, "unavailable"
    try:
        fd = opener(process_info.pid, 0)
    except ProcessLookupError:
        return None, "gone"
    except (OSError, TypeError):
        return None, "unavailable"
    current = proc_process(process_info.pid)
    if current is None:
        try:
            sender(fd, 0, None, 0)
        except ProcessLookupError:
            os.close(fd)
            return None, "gone"
        except (PermissionError, OSError, TypeError):
            os.close(fd)
            return None, "unavailable"
        os.close(fd)
        return None, "unavailable"
    if not same_process_identity(current, process_info):
        os.close(fd)
        return None, "gone"
    return MemberHandle(
        current._replace(
            delegated=process_info.delegated,
            ambiguous=process_info.ambiguous,
        ),
        fd,
    ), "claimed"


def signal_member(member: MemberHandle, signum: int) -> bool:
    """Signal only the process identity pinned by a retained pidfd."""
    sender = getattr(signal, "pidfd_send_signal", None)
    if sender is None:
        return False
    try:
        sender(member.fd, signum, None, 0)
    except (PermissionError, ProcessLookupError, OSError):
        return False
    return True


_libc_waitid = None


def _waitid_exited_ctypes(pid: int) -> bool:
    """waitid(P_PID, WEXITED|WNOHANG|WNOWAIT) for Pythons without os.waitid.

    macOS libc provides waitid(2) but CPython does not expose os.waitid
    there. Constants are the Apple ABI values (matching the Rust libc
    crate's unix/bsd/apple definitions): P_PID=1, WEXITED=0x04,
    WNOHANG=0x01, WNOWAIT=0x20; si_pid sits at byte 12 of siginfo_t
    (three int32 fields precede the pid_t). Like os.waitid, EINTR
    reports not-exited while any other errno propagates.
    """
    global _libc_waitid
    import ctypes

    if _libc_waitid is None:
        _libc_waitid = ctypes.CDLL(None, use_errno=True).waitid
        _libc_waitid.argtypes = [
            ctypes.c_int,
            ctypes.c_int,
            ctypes.c_void_p,
            ctypes.c_int,
        ]
        _libc_waitid.restype = ctypes.c_int
    info = ctypes.create_string_buffer(128)
    if _libc_waitid(1, pid, info, 0x04 | 0x01 | 0x20) != 0:
        error = ctypes.get_errno()
        if error == errno.EINTR:
            return False
        raise OSError(error, os.strerror(error))
    return struct.unpack_from("i", info, 12)[0] != 0


def leader_exited() -> bool:
    """Observe leader exit without reaping its PID or group identity."""
    assert process is not None
    waitid = getattr(os, "waitid", None)
    if waitid is None:
        # Only Darwin is known to provide waitid(2) without os.waitid;
        # other waitid-less platforms fail closed instead of guessing
        # unfamiliar wait options.
        if sys.platform != "darwin":
            raise AttributeError("os.waitid is required outside macOS")
        return _waitid_exited_ctypes(process.pid)
    try:
        result = waitid(
            os.P_PID,
            process.pid,
            os.WEXITED | os.WNOHANG | os.WNOWAIT,
        )
    except InterruptedError:
        return False
    return result is not None


def reap_unregistered_adopted_zombies(deadline: float) -> bool:
    """Reap direct Linux zombie adoptees with start-generation revalidation."""
    if not subreaper_enabled:
        return True
    while time.monotonic() < deadline:
        try:
            pending = os.waitid(os.P_ALL, 0, os.WEXITED | os.WNOHANG | os.WNOWAIT)
        except ChildProcessError:
            return True
        except InterruptedError:
            continue
        except OSError:
            return False
        if pending is None or pending.si_pid == 0:
            return True
        observed = proc_process(pending.si_pid)
        if (
            observed is None
            or observed.live
            or observed.parent != os.getpid()
            or (process is not None and observed.pid == process.pid)
        ):
            return False
        current = proc_process(observed.pid)
        if current is None or not same_process_identity(current, observed):
            continue
        try:
            waited, _status = os.waitpid(observed.pid, os.WNOHANG)
        except ChildProcessError:
            continue
        except (InterruptedError, OSError):
            return False
        if waited != observed.pid:
            time.sleep(
                min(PROCESS_POLL_SECONDS, max(0.0, deadline - time.monotonic()))
            )
    return False


def stop_process_group(first_signal: int) -> CleanupResult:
    """Stop the entire child session, then reap its retained leader."""
    assert process is not None
    known_members: dict[int, MemberHandle] = {}
    group_delivered: set[tuple[int, int | None]] = set()
    unsafe_direct_member = False
    # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
    unsafe_direct_member_reason = ""

    def send_process_group_signal(signum: int) -> bool:
        """Signal the group whose retained leader reserves its numeric ID."""
        try:
            if os.getsid(process.pid) != process.pid:
                return False
        except (PermissionError, ProcessLookupError):
            return False
        try:
            os.killpg(process.pid, signum)
        except AttributeError:
            try:
                process.send_signal(signum)
            except (PermissionError, ProcessLookupError):
                return False
        except (PermissionError, ProcessLookupError):
            return False
        return True

    def send_leader_signal(signum: int) -> bool:
        """Signal the exact unreaped Popen leader without polling its status."""
        try:
            os.kill(process.pid, signum)
        except (PermissionError, ProcessLookupError):
            return False
        return True

    def observe(deadline: float) -> list[SessionProcess] | None:
        """Refresh member handles while preserving previously pinned identities."""
        nonlocal unsafe_direct_member, unsafe_direct_member_reason
        if not drain_nested_supervisors(deadline):
            unsafe_direct_member = True
            # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
            if not unsafe_direct_member_reason:
                unsafe_direct_member_reason = "nested-drain"
        processes = list_session_processes(
            process.pid,
            max(0.001, deadline - time.monotonic()),
        )
        if processes is None:
            return None
        for process_info in processes:
            if process_info.pid == process.pid:
                continue
            previous = known_members.get(process_info.pid)
            if previous is not None and not same_process_identity(
                previous.process, process_info
            ):
                previous.close()
                del known_members[process_info.pid]
                previous = None
            elif previous is not None:
                previous.process = process_info
            if process_info.ambiguous:
                unsafe_direct_member = True
                # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
                if not unsafe_direct_member_reason:
                    unsafe_direct_member_reason = (
                        f"ambiguous:{process_info.pid}"
                    )
                continue
            if previous is None:
                member, _claim = claim_member(process_info, process.pid)
                if member is not None:
                    known_members[process_info.pid] = member
                # NOTE: plain unclaimability is deliberately NOT sticky. A
                # live unclaimed member already fails the phase through the
                # liveness check; once it vanishes it has exited, which is
                # success, and a pid reused inside the session shows live
                # and keeps failing. Only ambiguity (possibly-foreign
                # identity) and nested-control failure stay fail-closed.
                # Without this, macOS (no pidfds) can never pass a phase
                # whose cohort held a cross-group member, even after the
                # session is provably empty.
            # Pinned delegated handles stay dormant until a later snapshot
            # proves the nearer supervisor dead and reparents/promotes them.
        current_pids = {process_info.pid for process_info in processes}
        for pid, member in known_members.items():
            if pid not in current_pids:
                member.refresh()
        return processes

    def signal_known(signum: int, only_new: bool) -> None:
        """Deliver through pinned identities, never through cached PIDs."""
        for member in known_members.values():
            if not member.process.live:
                continue
            if member.process.delegated:
                continue
            identity = (member.process.pid, member.process.start)
            if member.process.group == process.pid and identity in group_delivered:
                continue
            if only_new and member.signaled:
                continue
            if signal_member(member, signum):
                member.signaled = True

    def note_group_delivery(processes: list[SessionProcess] | None) -> None:
        """Remember the cohort reached by one anchored group delivery."""
        if processes is None:
            return
        for process_info in processes:
            if process_info.live and process_info.group == process.pid:
                group_delivered.add((process_info.pid, process_info.start))

    def phase(signum: int, deadline: float, only_new: bool) -> bool:
        """Signal and require two complete empty session observations."""
        # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
        _temp_diag(
            f"TEMP-DIAG-180 STOP-PHASE enter pid={os.getpid()} signum={signum} "
            f"budget={deadline - time.monotonic():.2f}"
        )
        group_delivered.clear()
        processes = observe(deadline)
        complete_exact_cohort = processes is not None and all(
            process_info.pid == process.pid
            or not process_info.live
            or process_info.delegated
            or (
                process_info.pid in known_members
                and same_process_identity(
                    known_members[process_info.pid].process, process_info
                )
            )
            for process_info in processes
        )
        if complete_exact_cohort and send_leader_signal(signum):
            pass
        elif send_process_group_signal(signum):
            note_group_delivery(processes)
        signal_known(signum, only_new)
        consecutive_empty = 0
        while time.monotonic() < deadline:
            processes = observe(deadline)
            signal_known(signum, only_new)
            # A newly forked same-group member receives one exact pidfd signal
            # when available. Without exact authority, never re-enter every
            # unchanged catchable-signal handler; the anchored KILL phase will
            # still stop that late member.
            if (
                processes is not None
                and any(item.pid == process.pid for item in processes)
                and all(not item.live for item in processes)
                and all(not member.process.live for member in known_members.values())
                and not unsafe_direct_member
            ):
                consecutive_empty += 1
                if consecutive_empty >= 2:
                    # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
                    _temp_diag(
                        f"TEMP-DIAG-180 STOP-PHASE exit pid={os.getpid()} "
                        f"signum={signum} result=True"
                    )
                    return True
            else:
                consecutive_empty = 0
            time.sleep(min(PROCESS_POLL_SECONDS, max(0.0, deadline - time.monotonic())))
        # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
        if processes is None:
            live_summary = "observe-None"
        else:
            live_summary = ",".join(
                str(item.pid) for item in processes if item.live
            ) or "none-live"
        _temp_diag(
            f"TEMP-DIAG-180 STOP-PHASE exit pid={os.getpid()} signum={signum} "
            f"result=False unsafe={unsafe_direct_member} "
            f"reason={unsafe_direct_member_reason or 'none'} live={live_summary}"
        )
        return False

    try:
        complete = phase(
            first_signal,
            time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS,
            True,
        )
        if not complete:
            complete = phase(
                signal.SIGKILL,
                time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS,
                False,
            )
        try:
            status = process.wait(timeout=PROCESS_SNAPSHOT_TIMEOUT_SECONDS)
        except subprocess.TimeoutExpired:
            # The retained Popen handle is stable authority for its own leader.
            process.kill()
            try:
                status = process.wait(timeout=PROCESS_SNAPSHOT_TIMEOUT_SECONDS)
            except subprocess.TimeoutExpired:
                # A broken platform wait implementation must not turn bounded
                # cleanup into an indefinite hang or a false success.
                return CleanupResult(125, False)
        reap_deadline = time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS
        adopted = [
            member
            for member in known_members.values()
            if member.process.parent == os.getpid()
        ]
        while adopted and time.monotonic() < reap_deadline:
            adopted = [member for member in adopted if not member.reap_if_adopted()]
            if adopted:
                time.sleep(
                    min(
                        PROCESS_POLL_SECONDS,
                        max(0.0, reap_deadline - time.monotonic()),
                    )
                )
        known_adoptees_complete = not adopted
        relays_complete = stop_stdio_relays(
            time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS
        )
        if status == 0 and stdio_relay_status is not None:
            status = stdio_relay_status
        unregistered_complete = reap_unregistered_adopted_zombies(
            time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS
        )
        lease_complete = lease_closed()
        # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
        phase_complete = complete
        complete = (
            complete
            and known_adoptees_complete
            and relays_complete
            and unregistered_complete
            and lease_complete
        )
        # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
        _temp_diag(
            f"TEMP-DIAG-180 STOP-LEGS pid={os.getpid()} phases={phase_complete} "
            f"adoptees={known_adoptees_complete} relays={relays_complete} "
            f"unreg={unregistered_complete} lease={lease_complete} "
            f"status={status} complete={complete}"
        )
        return CleanupResult(status, complete)
    finally:
        for member in known_members.values():
            member.close()


def main(argv: Sequence[str], terminal: bool = False) -> int:
    """Run the requested command and return a shell-compatible status."""
    global ancestor_registration, boundary_token, control_reader, lease_reader
    global process, subreaper_enabled
    global nested_control_complete
    global stdio_relay_status, terminal_cleanup_incomplete, terminal_handoff_required

    if len(argv) < 3:
        diagnostic("usage: test-timeout-v1 TIMEOUT COMMAND [ARG ...]")
        return 2
    try:
        timeout = parse_timeout(argv[1])
    except (ValueError, OverflowError):
        diagnostic(f"test-timeout-v1: invalid timeout: {argv[1]}")
        return 2
    if not clear_timeout_marker():
        diagnostic("test-timeout-v1: could not clear timeout marker")
        return 2
    terminal_handoff_required = terminal
    terminal_cleanup_incomplete = False
    stdio_relay_status = None
    stdio_relay_pids.clear()
    for descriptor in stdio_relay_state_fds.values():
        close_fd(descriptor)
    stdio_relay_state_fds.clear()
    stdio_relay_states.clear()
    for descriptor in stdio_relay_parent_fds.values():
        close_fd(descriptor)
    stdio_relay_parent_fds.clear()
    for _pid, link in nested_supervisors.values():
        link.close()
    nested_supervisors.clear()
    nested_control_complete = True
    if ancestor_registration is not None:
        ancestor_registration.close()
        ancestor_registration = None
    control_reader = None
    install_signal_handlers()

    try:
        child_env = os.environ.copy()
        child_env.pop("DOT_TEST_TIMEOUT_EXPIRED_FILE", None)
        boundary_token = secrets.token_hex(32)
        child_env[SESSION_BOUNDARY_ENV] = extend_boundary_chain(
            child_env.get(SESSION_BOUNDARY_ENV), boundary_token
        )
        subreaper_enabled = adopt_descendants()
    except OSError:
        diagnostic("test-timeout-v1: could not establish descendant supervision")
        return finish(125, False)
    try:
        process = launch_process(argv[2:], child_env)
    except CleanupIncompleteError:
        diagnostic("test-timeout-v1: could not verify child cleanup")
        return finish(125, False)
    except FileNotFoundError:
        return finish(127)
    except (OSError, subprocess.SubprocessError):
        if interrupted_signal is not None:
            return finish(128 + interrupted_signal)
        return finish(126)
    if process is None:
        return finish(128 + interrupted_signal) if interrupted_signal is not None else finish(126)

    deadline = time.monotonic() + timeout
    while True:
        poll_stdio_relay_states()
        # Nested wrappers cannot authorize their own target until this exact
        # retained wrapper identity acknowledges a private registration.  Do
        # this during ordinary supervision, not only after teardown begins.
        if not drain_nested_supervisors():
            stop_process_group(signal.SIGKILL)
            diagnostic("test-timeout-v1: could not verify child cleanup")
            return finish(125, False)
        if interrupted_signal is not None:
            cleanup = stop_process_group(interrupted_signal)
            if not cleanup.complete:
                diagnostic("test-timeout-v1: could not verify child cleanup")
            return finish(128 + interrupted_signal, cleanup.complete)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            mark_timeout_expired()
            cleanup = stop_process_group(signal.SIGTERM)
            if not cleanup.complete:
                diagnostic("test-timeout-v1: could not verify child cleanup")
            return finish(124, cleanup.complete)
        if leader_exited():
            # Observation may cross the absolute deadline. Re-enter the
            # precedence checks while the leader remains retained so timeout
            # (or a concurrently latched signal) wins the exact boundary.
            if time.monotonic() >= deadline:
                continue
            break
        time.sleep(min(remaining, PROCESS_POLL_SECONDS))

    if interrupted_signal is not None:
        cleanup = stop_process_group(interrupted_signal)
        if not cleanup.complete:
            diagnostic("test-timeout-v1: could not verify child cleanup")
        return finish(128 + interrupted_signal, cleanup.complete)

    cleanup = stop_process_group(signal.SIGTERM)
    if not cleanup.complete:
        diagnostic("test-timeout-v1: could not verify child cleanup")
        return finish(125, False)
    status = cleanup.status
    return finish(status if status >= 0 else 128 - status)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == LAUNCH_HELPER_MODE:
        launch_helper(sys.argv)
        os._exit(126)
    if len(sys.argv) == 5 and sys.argv[1] == RELAY_HELPER_MODE:
        if not sys.flags.isolated or not sys.flags.no_site:
            os._exit(1)
        relay_stream(sys.argv[2], int(sys.argv[3]), int(sys.argv[4]))
        os._exit(1)
    terminal_exit(main(sys.argv, terminal=True))
