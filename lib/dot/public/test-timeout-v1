_temp_diag_remaining = 48


def _temp_diag(message: str) -> None:
    global _temp_diag_remaining
    if _temp_diag_remaining <= 0:
        return
    # Env-gated: exact-stderr assertions stay green where unset.
    if not os.environ.get("DOT_TEST_DIAG_NESTED"):
        return
    if ENTRY_STDIO_MASK & (1 << 2) == 0:
        return
    try:
        stream_fd = sys.stderr.fileno()
    except (AttributeError, OSError):
        return
    if stream_fd != 2:
        return
    _temp_diag_remaining -= 1
    payload = (message + "\n").encode("utf-8", errors="replace")[:4096]
    try:
        flags = fcntl.fcntl(2, fcntl.F_GETFL)
    except (AttributeError, OSError):
        return
    try:
        fcntl.fcntl(2, fcntl.F_SETFL, flags | os.O_NONBLOCK)
    except (AttributeError, OSError):
        return
    try:
        os.write(2, payload)
    except (BlockingIOError, InterruptedError, OSError):
        pass
    finally:
        try:
            fcntl.fcntl(2, fcntl.F_SETFL, flags)
        except (AttributeError, OSError):
            pass


def diagnostic(message: str) -> None:
    """Best-effort diagnostics that cannot strand teardown on a full pipe."""
    if ENTRY_STDIO_MASK & (1 << 2) == 0:
        return
    try:
        stream_fd = sys.stderr.fileno()
    except (AttributeError, OSError):
        # Embedded callers and the deterministic unit harness can provide an
        # in-memory stream. The executable boundary always has fd 2 and uses
        # the bounded process writer below.
        try:
            sys.stderr.write(message + "\n")
            sys.stderr.flush()
        except (AttributeError, OSError):
            pass
        return
    if stream_fd != 2:
        try:
            sys.stderr.write(message + "\n")
            sys.stderr.flush()
        except (AttributeError, OSError):
            pass
        return
    payload = (message + "\n").encode("utf-8", errors="replace")[:4096]
    if not stream_requires_relay(2):
        try:
            write_all_fd(2, payload)
        except OSError:
            pass
        return
    expected_parent = os.getpid()
    try:
        writer = os.fork()
    except OSError:
        return
    if writer == 0:
        bind_linux_parent_death(expected_parent)
        for handled_signal in handled_signals + subprocess_restored_signals:
            signal.signal(handled_signal, signal.SIG_DFL)
        try:
            write_all_fd(2, payload)
        except OSError:
            os._exit(1)
        os._exit(0)
    deadline = time.monotonic() + 0.25
    while time.monotonic() < deadline:
        try:
            waited, _status = os.waitpid(writer, os.WNOHANG)
        except ChildProcessError:
            return
        except InterruptedError:
            continue
        except OSError:
            break
        if waited == writer:
            return
        time.sleep(min(0.01, max(0.0, deadline - time.monotonic())))
    try:
        os.kill(writer, signal.SIGKILL)
    except (PermissionError, ProcessLookupError):
        pass
    reap_deadline = time.monotonic() + PROCESS_SNAPSHOT_TIMEOUT_SECONDS
    while time.monotonic() < reap_deadline:
        try:
            waited, _status = os.waitpid(writer, os.WNOHANG)
        except ChildProcessError:
            return
        except InterruptedError:
            continue
        except OSError:
            return
        if waited == writer:
            return
        time.sleep(min(0.01, max(0.0, reap_deadline - time.monotonic())))


def _kcmp_syscall_number():
    """kcmp(2) syscall number for this machine, or None when unknown."""
    syscall_numbers = {
        "aarch64": 272,
        "armv7l": 378,
        "i386": 349,
        "i686": 349,
        "riscv64": 272,
        "x86_64": 312,
    }
    return syscall_numbers.get(os.uname().machine)


def kcmp_available() -> bool:
    """Whether the kcmp syscall answers instead of failing EPERM/ENOSYS.

    Container runtimes withhold CAP_SYS_PTRACE (seccomp EPERM) and kernels
    older than 3.5 lack the call (ENOSYS); both force the procfs fallback,
    which over-matches path-backed links of one path.
    """
    if not sys.platform.startswith("linux"):
        return False
    syscall_number = _kcmp_syscall_number()
    if syscall_number is None:
        return False
    try:
        import ctypes
    except ImportError:
        return False
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long
    # KCMP_FILE == 0 on fds (0, 0): any answer other than EPERM/ENOSYS
    # proves the call itself is permitted (EBADF from a closed stdin
    # still means the syscall executed).
    result = libc.syscall(syscall_number, os.getpid(), os.getpid(), 0, 0, 0)
    return result != -1 or ctypes.get_errno() not in (errno.EPERM, errno.ENOSYS)


def same_stream(left: int, right: int) -> bool:
    """Return whether two descriptors share one open file description."""
    if left == right:
        return True
    if not sys.platform.startswith("linux"):
        # POSIX fstat identity is not enough: two independent opens of one
        # FIFO/socket have the same inode but independent flags and ordering.
        # Keeping separate relays is the conservative portable fallback.
        return False
    syscall_number = _kcmp_syscall_number()
    if syscall_number is None:
        return False
    try:
        import ctypes
    except ImportError:
        return False
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long
    # KCMP_FILE == 0. A zero result is the kernel's exact proof that the two
    # descriptors reference one open file description.
    result = libc.syscall(
        syscall_number,
        os.getpid(),
        os.getpid(),
        0,
        left,
        right,
    )
    if result == 0:
        return True
    if result != -1:
        # A nonzero KCMP ordering result proves distinct descriptions.
        return False
    if ctypes.get_errno() not in (errno.EPERM, errno.ENOSYS):
        # A closed descriptor or a bad call still fails closed.
        return False
    # kcmp needs CAP_SYS_PTRACE, which container runtimes withhold, and
    # kernels older than 3.5 lack the call entirely. Fall back to the
    # /proc/self/fd link comparison there: anonymous objects (pipes,
    # sockets) compare by kernel inode, so duplicates match and distinct
    # objects do not. Path-backed links can over-match separately opened
    # descriptions of one path (notably /dev/null); merging those
    # captures is benign because the relay still delivers identical
    # bytes to both inherited sinks.
    try:
        return os.readlink('/proc/self/fd/%d' % left) == os.readlink(
            '/proc/self/fd/%d' % right
        )
    except OSError:
        return False


def prepare_stdio_relays(
) -> tuple[dict[str, int], list[tuple[str, int, int]], list[int]]:
    """Interpose internal pipes for caller-owned FIFO/socket standard streams."""
    popen_stdio: dict[str, int] = {}
    relay_specs: list[tuple[str, int, int]] = []
    child_endpoints: list[int] = []
    try:
        if stream_requires_relay(0):
            child_read, relay_write = protocol_pipe()
            popen_stdio["stdin"] = child_read
            child_endpoints.append(child_read)
            relay_specs.append(("input", 0, relay_write))
        relay_stdout = stream_requires_relay(1)
        relay_stderr = stream_requires_relay(2)
        aliased_output = relay_stdout and relay_stderr and same_stream(1, 2)
        if aliased_output:
            relay_read, child_write = protocol_pipe()
            popen_stdio["stdout"] = child_write
            popen_stdio["stderr"] = child_write
            child_endpoints.append(child_write)
            relay_specs.append(("output", relay_read, 1))
        elif relay_stdout:
            relay_read, child_write = protocol_pipe()
            popen_stdio["stdout"] = child_write
            child_endpoints.append(child_write)
            relay_specs.append(("output", relay_read, 1))
        if relay_stderr and not aliased_output:
            relay_read, child_write = protocol_pipe()
            popen_stdio["stderr"] = child_write
            child_endpoints.append(child_write)
            relay_specs.append(("output", relay_read, 2))
        return popen_stdio, relay_specs, child_endpoints
    except BaseException:
        close_relay_specs(relay_specs)
        for descriptor in child_endpoints:
            close_fd(descriptor)
        raise


def publish_relay_state(descriptor: int, state: bytes) -> None:
    """Publish one nonblocking relay state transition."""
    endpoint = socket.socket(fileno=descriptor)
    try:
        endpoint.send(state, getattr(socket, "MSG_DONTWAIT", 0))
    except (BlockingIOError, BrokenPipeError, OSError):
        pass
    finally:
        endpoint.detach()


def relay_stream(direction: str, state_fd: int, parent_fd: int) -> None:
    """Copy fd0 to fd1 in a fresh independently killable helper process."""
    try:
        for restored_signal in handled_signals + subprocess_restored_signals:
            signal.signal(restored_signal, signal.SIG_DFL)
        last_state = b""

        def state(value: bytes) -> None:
            nonlocal last_state
            if value != last_state:
                publish_relay_state(state_fd, value)
                last_state = value

        while True:
            state(b"R")
            with selectors.DefaultSelector() as reader:
                reader.register(0, selectors.EVENT_READ)
                reader.register(parent_fd, selectors.EVENT_READ)
                while True:
                    events = reader.select(PROCESS_POLL_SECONDS)
                    if any(key.fd == parent_fd for key, _event in events):
                        if os.read(parent_fd, 1) == b"":
                            os._exit(0)
                    if any(key.fd == 0 for key, _event in events):
                        try:
                            chunk = os.read(0, 65536)
                        except (BlockingIOError, InterruptedError):
                            continue
                        break
            if not chunk:
                state(b"E")
                os._exit(0)
            offset = 0
            state(b"W")
            with selectors.DefaultSelector() as writer:
                writer.register(1, selectors.EVENT_WRITE)
                writer.register(parent_fd, selectors.EVENT_READ)
                source_state = select.poll()
                source_state.register(0, select.POLLIN | select.POLLHUP | select.POLLERR)
                while offset < len(chunk):
                    if any(
                        events & (select.POLLHUP | select.POLLERR)
                        for _fd, events in source_state.poll(0)
                    ):
                        # No writer can add more bytes to the internal source.
                        # If the caller sink remains blocked, teardown is an
                        # ordinary output-delivery failure rather than an
                        # unattributed descendant retaining the source open.
                        state(b"C")
                    events = writer.select(PROCESS_POLL_SECONDS)
                    if any(key.fd == parent_fd for key, _event in events):
                        if os.read(parent_fd, 1) == b"":
                            os._exit(0)
                    if not any(key.fd == 1 for key, _event in events):
                        continue
                    try:
                        written = os.write(1, chunk[offset:])
                    except (BlockingIOError, InterruptedError):
                        continue
                    except BrokenPipeError:
                        os._exit(0 if direction == "input" else 128 + signal.SIGPIPE)
                    if written <= 0:
                        os._exit(1)
                    offset += written
    except BrokenPipeError:
        os._exit(0 if direction == "input" else 128 + signal.SIGPIPE)
    except BaseException:
        os._exit(1)


def stdio_relay_watchdog(
    direction: str,
    source: int,
    destination: int,
    state_write: int,
    parent_read: int,
    boundary_chain: str,
) -> None:
    """Own a potentially blocked relay and kill it when its wrapper dies."""
    for handled_signal in handled_signals + subprocess_restored_signals:
        signal.signal(handled_signal, signal.SIG_IGN)
    os.setsid()
    expected_parent = os.getpid()
    relay = os.fork()
    if relay == 0:
        try:
            bind_linux_parent_death(expected_parent)
            os.dup2(source, 0)
            os.dup2(destination, 1)
            close_fd(2)
            for retained in (state_write, parent_read):
                flags = fcntl.fcntl(retained, fcntl.F_GETFD)
                fcntl.fcntl(retained, fcntl.F_SETFD, flags & ~fcntl.FD_CLOEXEC)
            maximum = os.sysconf("SC_OPEN_MAX")
            if not isinstance(maximum, int) or maximum < 3:
                maximum = 65536
            retained = sorted((state_write, parent_read))
            start = 3
            for descriptor in retained:
                os.closerange(start, descriptor)
                start = descriptor + 1
            os.closerange(start, maximum)
            os.execve(
                sys.executable,
                [
                    sys.executable,
                    "-I",
                    "-S",
                    str(Path(__file__).resolve()),
                    RELAY_HELPER_MODE,
                    direction,
                    str(state_write),
                    str(parent_read),
                ],
                {SESSION_BOUNDARY_ENV: boundary_chain},
            )
        except BaseException:
            os._exit(1)
    if relay < 0:
        os._exit(125)

    close_fd(state_write)
    if source >= 3:
        close_fd(source)
    if destination >= 3:
        close_fd(destination)
    close_fd(0)
    close_fd(1)
    close_fd(2)
    maximum = os.sysconf("SC_OPEN_MAX")
    if not isinstance(maximum, int) or maximum < 3:
        maximum = 65536
    os.closerange(3, parent_read)
    os.closerange(parent_read + 1, maximum)
    os.set_blocking(parent_read, False)
    stopping_at = None
    while True:
        try:
            waited, status = os.waitpid(relay, os.WNOHANG)
        except InterruptedError:
            continue
        except ChildProcessError:
            os._exit(125)
        if waited == relay:
            if stopping_at is not None:
                os._exit(0)
            if os.WIFEXITED(status):
                os._exit(os.WEXITSTATUS(status))
            if os.WIFSIGNALED(status):
                os._exit(min(255, 128 + os.WTERMSIG(status)))
            os._exit(1)
        try:
            parent_state = os.read(parent_read, 1)
        except BlockingIOError:
            parent_state = None
        except InterruptedError:
            continue
        except OSError:
            parent_state = b""
        if parent_state is not None:
            if stopping_at is None:
                stopping_at = time.monotonic()
            try:
                os.kill(relay, signal.SIGKILL)
            except (PermissionError, ProcessLookupError):
                pass
        if (
            stopping_at is not None
            and time.monotonic() - stopping_at >= PROCESS_SNAPSHOT_TIMEOUT_SECONDS
        ):
            # Both processes are in this watchdog's private session. If the
            # exact child cannot be reaped, terminate the whole helper group;
            # the caller reports incomplete cleanup after its own deadline.
            try:
                os.killpg(os.getpid(), signal.SIGKILL)
            except (PermissionError, ProcessLookupError):
                pass
            os._exit(125)
        time.sleep(PROCESS_POLL_SECONDS)


def start_stdio_relays(
    relay_specs: list[tuple[str, int, int]], boundary_chain: str
) -> None:
    """Start every prepared relay only after target exec authorization."""
    while relay_specs:
