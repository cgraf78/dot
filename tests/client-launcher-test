#!/usr/bin/env bash

set -euo pipefail

# shellcheck disable=SC1091 # Test helper path is resolved from this file.
. "$(dirname "${BASH_SOURCE[0]}")/lib/test.sh"

launcher=$DOT_TEST_ROOT/support/client-launcher.sh
[[ $(git hash-object "$launcher") == 97c3115ac834aa633d418d0e467e737afe54ec74 ]] ||
  fail 'client launcher v4 changed in place; update its migration fixture deliberately'

head_tree_complete=0
head_tree_count=0
while IFS= read -r -d '' entry; do
  if [[ -z $entry ]]; then
    head_tree_complete=1
    continue
  fi
  [[ $head_tree_complete -eq 0 && $entry == *$'\t'* ]] ||
    fail 'repository HEAD emitted a malformed tracked-tree record'
  header=${entry%%$'\t'*}
  path=${entry#*$'\t'}
  read -r mode type _ <<<"$header"
  [[ $type == blob && $mode =~ ^(100644|100755)$ ]] ||
    fail "repository HEAD added an unsupported tracked type: $path"
  case $path in
    '' | /* | . | .. | ./* | ../* | */./* | */../* | */. | */.. | */ | *//* | *$'\t'* | *$'\n'* | *$'\r'* | .git | .git/* | */.git | */.git/*)
      fail "repository HEAD added an unsupported tracked path: $path"
      ;;
  esac
  head_tree_count=$((head_tree_count + 1))
done < <(
  if git -C "$DOT_TEST_ROOT" ls-tree -r -z --full-tree HEAD; then
    printf '\0'
  fi
)
[[ $head_tree_complete -eq 1 && $head_tree_count -gt 0 ]] ||
  fail 'repository HEAD tracked-tree inventory was incomplete'

client_home=$DOT_TEST_TMP/home
mkdir -p "$client_home"
HOME=$client_home
export HOME
install_home=$DOT_TEST_TMP/install
checkout=$install_home/cgraf78/dot
runtime=$checkout/bin/dot
config_parser=$checkout/lib/dot/config.sh
public_api=$checkout/lib/dot/public/api-version.sh
public_xdg=$checkout/lib/dot/public/xdg.sh
lock=$DOT_TEST_TMP/dot-cutover.lock
helper=$DOT_TEST_TMP/dot-library-handoff.sh
legacy=$DOT_TEST_TMP/legacy-dot-launcher.sh
readiness_generation=client-topology-v1
ready=$DOT_TEST_TMP/client-ready-v4
log=$DOT_TEST_TMP/launcher.log
helper_log=$DOT_TEST_TMP/helper.log
config_path=$HOME/.config/dot/config
public_link=$HOME/.local/lib/dot

mkdir -p "$checkout/bin" "$checkout/support" "$checkout/lib/dot/public"
cp "$launcher" "$checkout/support/client-launcher.sh"
cat >"$runtime" <<'RUNTIME'
#!/usr/bin/env bash
printf 'standalone\n' >"${DOT_CLIENT_LAUNCHER_TEST_LOG:?}"
printf '%s\n' "$@" >>"${DOT_CLIENT_LAUNCHER_TEST_LOG:?}"
RUNTIME
chmod 0755 "$runtime"
printf 'dot_config_load() { :; }\n' >"$config_parser"
printf 'DOT_EXTENSION_API_VERSION=1\n' >"$public_api"
printf 'dot_xdg_path() { :; }\n' >"$public_xdg"
mkdir -p "$(dirname "$config_path")" "$(dirname "$public_link")"
cat >"$config_path" <<'CONFIG'
version=1
extension_api=1
extensions_dir=$HOME/.local/lib/dotfiles
dependency_provider=shdeps
CONFIG
ln -s "$checkout/lib/dot/public" "$public_link"
git -C "$checkout" init --quiet
git -C "$checkout" config user.name 'Dot Test'
git -C "$checkout" config user.email dot-test@example.invalid
git -C "$checkout" add \
  bin/dot lib/dot/config.sh lib/dot/public/api-version.sh \
  lib/dot/public/xdg.sh \
  support/client-launcher.sh
git -c core.hooksPath= -C "$checkout" commit --quiet -m fixture
minimum_revision=$(git -C "$checkout" rev-parse HEAD)
write_lock() {
  local phase=$1 revision=$2 generation=${3:-$readiness_generation}

  printf 'cgraf78 dot client cutover v4\nphase=%s\nminimum_revision=%s\nreadiness_generation=%s\n' \
    "$phase" "$revision" "$generation" >"$lock"
}

write_lock active "$minimum_revision"
write_ready() {
  local _revision=$1 _ready=${2:-$ready} _config=${3:-$config_path} oid

  [[ $_revision == "$minimum_revision" ]] || fail 'unexpected readiness revision'
  mkdir -p "$(dirname "$_ready")"
  chmod 0700 "$(dirname "$_ready")"
  oid=$(git -C "$checkout" hash-object --no-filters "$_config")
  printf 'cgraf78 dot client readiness v4\nconfig_path=%s\nconfig_oid=%s\n' \
    "$_config" "$oid" >"$_ready"
  chmod 0600 "$_ready"
}
write_ready "$minimum_revision"
export DOT_CLIENT_READY=$ready

relative_home=$DOT_TEST_TMP/relative-state-home
relative_config=$relative_home/.config/dot/config
relative_ready=$relative_home/.local/state/dot/client-ready-v4/$readiness_generation/$minimum_revision
mkdir -p "$(dirname "$relative_config")" "$relative_home/.local/lib"
cp "$config_path" "$relative_config"
ln -s "$checkout/lib/dot/public" "$relative_home/.local/lib/dot"
write_ready "$minimum_revision" "$relative_ready" "$relative_config"
rm -f -- "$log" "$helper_log"
env -u DOT_CLIENT_READY \
  HOME="$relative_home" XDG_STATE_HOME=relative/state \
  DOT_CLIENT_LAUNCHER_TEST_LOG="$log" \
  DOT_CLIENT_HANDOFF_TEST_LOG="$helper_log" \
  DOT_CLIENT_CUTOVER_LOCK="$lock" \
  DOT_CLIENT_HANDOFF_HELPER="$helper" \
  DOT_CLIENT_LEGACY_LAUNCHER="$legacy" \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" relative-state-active
assert_eq $'standalone\nrelative-state-active' "$(<"$log")" \
  'client launcher resolves relative XDG state through HOME fallback'

cat >"$helper" <<'HELPER'
#!/usr/bin/env bash
printf '%s\n' "$1" >>"${DOT_CLIENT_HANDOFF_TEST_LOG:?}"
HELPER
chmod 0755 "$helper"
cat >"$legacy" <<'LEGACY'
#!/usr/bin/env bash
printf 'legacy\n' >"${DOT_CLIENT_LAUNCHER_TEST_LOG:?}"
printf 'front-door=%s\n' "${DOT_CLIENT_FRONT_DOOR:-unset}" \
  >>"${DOT_CLIENT_LAUNCHER_TEST_LOG:?}"
printf '%s\n' "$@" >>"${DOT_CLIENT_LAUNCHER_TEST_LOG:?}"
LEGACY
chmod 0755 "$legacy"
: >"$helper_log"

validation_out=$DOT_TEST_TMP/client-validation.out
validation_err=$DOT_TEST_TMP/client-validation.err
run_internal_validation() {
  DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
    DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
    DOT_CLIENT_CUTOVER_LOCK=$lock \
    DOT_CLIENT_HANDOFF_HELPER=$helper \
    DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
    SHDEPS_INSTALL_DIR="$install_home" \
    "$launcher" __client validate-checkout \
    >"$validation_out" 2>"$validation_err"
}
assert_internal_validation_rejected() {
  local label=$1

  rm -f -- "$log" "$helper_log" "$validation_out" "$validation_err"
  if run_internal_validation; then
    fail "$label: checkout validation unexpectedly succeeded"
  fi
  assert_eq '' "$(<"$validation_out")" "$label: stdout remains silent"
  assert_eq '' "$(<"$validation_err")" "$label: stderr remains silent"
  [[ ! -e $log && ! -e $helper_log ]] ||
    fail "$label: checkout validation dispatched a runtime"
}
assert_internal_syntax_rejected() {
  local label=$1 status
  shift

  rm -f -- "$log" "$helper_log" "$validation_out" "$validation_err"
  if DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
    DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
    DOT_CLIENT_CUTOVER_LOCK=$lock \
    DOT_CLIENT_HANDOFF_HELPER=$helper \
    DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
    SHDEPS_INSTALL_DIR="$install_home" \
    "$launcher" "$@" >"$validation_out" 2>"$validation_err"; then
    status=0
  else
    status=$?
  fi
  assert_eq 2 "$status" "$label: exact internal argv is required"
  assert_eq '' "$(<"$validation_out")" "$label: stdout remains silent"
  assert_eq '' "$(<"$validation_err")" "$label: stderr remains silent"
  [[ ! -e $log && ! -e $helper_log ]] ||
    fail "$label: malformed internal command dispatched a runtime"
}

# The readiness writer must be able to validate the selected standalone tree
# while the fleet lock is still prepare, without dispatching either engine.
write_lock prepare "$minimum_revision"
rm -f -- "$ready"
rm -f -- "$log" "$helper_log" "$validation_out" "$validation_err"
run_internal_validation ||
  fail 'client checkout validation rejected a clean prepare-phase checkout'
assert_eq '' "$(<"$validation_out")" \
  'client checkout validation keeps stdout silent'
assert_eq '' "$(<"$validation_err")" \
  'client checkout validation keeps stderr silent'
[[ ! -e $log && ! -e $helper_log ]] ||
  fail 'client checkout validation dispatched a runtime'
assert_internal_syntax_rejected 'missing validation verb' __client
assert_internal_syntax_rejected 'extra validation argument' \
  __client validate-checkout extra
assert_internal_syntax_rejected 'unknown validation verb' __client status

printf 'cgraf78 dot client cutover v4\nphase=prepare\nminimum_revision=%s\n' \
  "$minimum_revision" >"$lock"
assert_internal_validation_rejected 'malformed client lock'
write_lock prepare "$minimum_revision"

unrelated_tree=$(git -C "$checkout" write-tree)
unrelated_revision=$(printf 'unrelated fixture\n' |
  git -c core.hooksPath= -C "$checkout" commit-tree "$unrelated_tree")
external_grafts=$DOT_TEST_TMP/external-grafts
printf '%s %s\n' "$minimum_revision" "$unrelated_revision" >"$external_grafts"
write_lock prepare "$unrelated_revision"
export GIT_GRAFT_FILE=$external_grafts
assert_internal_validation_rejected 'inherited external Git graft file'
unset GIT_GRAFT_FILE
write_lock prepare "$minimum_revision"

printf '\n# dirty adapter template\n' >>"$checkout/support/client-launcher.sh"
assert_internal_validation_rejected 'dirty adapter template'
git -C "$checkout" checkout -- support/client-launcher.sh

mv "$checkout/.git" "$checkout/.git-owned"
ln -s .git-owned "$checkout/.git"
assert_internal_validation_rejected 'symlinked checkout metadata'
rm -f -- "$checkout/.git"
mv "$checkout/.git-owned" "$checkout/.git"

external_common=$DOT_TEST_TMP/external-common.git
cp -R "$checkout/.git" "$external_common"
printf '%s\n' "$external_common" >"$checkout/.git/commondir"
assert_internal_validation_rejected 'external checkout common directory'
rm -f -- "$checkout/.git/commondir"

foreign_worktree=$DOT_TEST_TMP/foreign-worktree
mkdir -p "$foreign_worktree"
git --git-dir="$checkout/.git" config core.worktree "$foreign_worktree"
assert_internal_validation_rejected 'mismatched checkout top'
git --git-dir="$checkout/.git" config --unset-all core.worktree

dev_root=$DOT_TEST_TMP/dev-clones
dev_checkout=$dev_root/dot
mkdir -p "$dev_root"
mv "$checkout" "$dev_checkout"
ln -s "$dev_checkout" "$checkout"
rm -f -- "$validation_out" "$validation_err"
SHDEPS_GIT_DEV_DIR=$dev_root run_internal_validation ||
  fail 'client checkout validation rejected the selected Shdeps local clone'
assert_eq '' "$(<"$validation_out")" \
  'local-clone checkout validation keeps stdout silent'
assert_eq '' "$(<"$validation_err")" \
  'local-clone checkout validation keeps stderr silent'
rm -f -- "$checkout"
mv "$dev_checkout" "$checkout"

checkout_real=$checkout-real
mv "$checkout" "$checkout_real"
ln -s "$checkout_real" "$checkout"
SHDEPS_GIT_DEV_DIR=$dev_root \
  assert_internal_validation_rejected 'foreign symlinked managed checkout'
rm -f -- "$checkout"
mv "$checkout_real" "$checkout"

host_git=/usr/bin/git
if [[ ! -x $host_git || -L $host_git ]]; then
  host_git=$(command -v git)
fi
[[ -f $host_git && ! -L $host_git && -x $host_git ]] ||
  fail 'client launcher test requires a regular host Git'
host_bash_dir=${BASH%/*}
[[ $host_bash_dir == /* && -x $host_bash_dir/bash ]] ||
  fail 'client launcher test requires its invoking Bash directory'
home_git_dir=$HOME/.local/bin
home_git=$home_git_dir/git
symlink_git_dir=$DOT_TEST_TMP/symlink-git-bin
home_git_log=$DOT_TEST_TMP/home-git.log
dirty_xdg_log=$DOT_TEST_TMP/dirty-xdg.log
mkdir -p "$home_git_dir" "$symlink_git_dir"
cat >"$home_git" <<'HOME_GIT'
#!/usr/bin/env bash
printf 'invoked\n' >"${DOT_CLIENT_TEST_HOME_GIT_LOG:?}"
# shellcheck source=/dev/null
. "${DOT_CLIENT_TEST_DIRTY_XDG:?}"
exec "${DOT_CLIENT_TEST_HOST_GIT:?}" "$@"
HOME_GIT
chmod 0755 "$home_git"
ln -s "$home_git" "$symlink_git_dir/git"
run_home_git_validation() {
  PATH="$home_git_dir:$symlink_git_dir:${host_git%/*}:$host_bash_dir" \
    DOT_CLIENT_TEST_HOME_GIT_LOG=$home_git_log \
    DOT_CLIENT_TEST_DIRTY_XDG=$public_xdg \
    DOT_CLIENT_TEST_DIRTY_XDG_LOG=$dirty_xdg_log \
    DOT_CLIENT_TEST_HOST_GIT=$host_git \
    run_internal_validation
}
rm -f -- "$log" "$helper_log" "$validation_out" "$validation_err" \
  "$home_git_log" "$dirty_xdg_log"
run_home_git_validation ||
  fail 'client checkout validation did not select the regular host Git'
[[ ! -e $home_git_log ]] ||
  fail 'clean checkout validation executed the HOME Git wrapper'
[[ ! -e $dirty_xdg_log ]] ||
  fail 'clean checkout validation executed public XDG code'
assert_eq '' "$(<"$validation_out")" \
  'host-Git validation keeps stdout silent'
assert_eq '' "$(<"$validation_err")" \
  'host-Git validation keeps stderr silent'

# shellcheck disable=SC2016 # The injected fixture expands only if sourced.
printf 'printf "executed\\n" >"${DOT_CLIENT_TEST_DIRTY_XDG_LOG:?}"\n' \
  >>"$public_xdg"
rm -f -- "$log" "$helper_log" "$validation_out" "$validation_err" \
  "$home_git_log" "$dirty_xdg_log"
if run_home_git_validation; then
  fail 'client checkout validation accepted dirty public XDG code'
fi
[[ ! -e $home_git_log ]] ||
  fail 'client checkout validation executed the HOME Git wrapper'
[[ ! -e $dirty_xdg_log ]] ||
  fail 'client checkout validation executed dirty public XDG code'
assert_eq '' "$(<"$validation_out")" \
  'HOME-wrapper rejection keeps checkout validation stdout silent'
assert_eq '' "$(<"$validation_err")" \
  'HOME-wrapper rejection keeps checkout validation stderr silent'
git -C "$checkout" checkout -- lib/dot/public/xdg.sh
rm -f -- "$home_git"

dirty_config_log=$DOT_TEST_TMP/dirty-config.log
# shellcheck disable=SC2016 # The injected fixture expands only if sourced.
printf 'printf "executed\\n" >"${DOT_CLIENT_TEST_DIRTY_CONFIG_LOG:?}"\n' \
  >>"$config_parser"
export DOT_CLIENT_TEST_DIRTY_CONFIG_LOG=$dirty_config_log
assert_internal_validation_rejected 'dirty tracked config parser'
[[ ! -e $dirty_config_log ]] ||
  fail 'client checkout validation executed a dirty tracked config parser'
unset DOT_CLIENT_TEST_DIRTY_CONFIG_LOG
git -C "$checkout" checkout -- lib/dot/config.sh
write_lock active "$minimum_revision"
write_ready "$minimum_revision"
: >"$helper_log"

assert_checkout_change_falls_back() {
  local argument=$1 label=$2

  assert_internal_validation_rejected "$label: internal authority"
  rm -f -- "$log" "$helper_log"
  DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
    DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
    DOT_CLIENT_CUTOVER_LOCK=$lock \
    DOT_CLIENT_HANDOFF_HELPER=$helper \
    DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
    SHDEPS_INSTALL_DIR="$install_home" \
    "$launcher" "$argument"
  assert_eq $'legacy\nfront-door='"$launcher"$'\n'"$argument" \
    "$(<"$log")" "$label"
}

# The retained adapter must run on the same minimal bootstrap images as its
# installer. Git is present there, but a standalone `cmp` command may not be.
no_cmp_bin=$DOT_TEST_TMP/no-cmp-bin
mkdir -p "$no_cmp_bin"
cat >"$no_cmp_bin/cmp" <<'CMP'
#!/usr/bin/env bash
printf 'client launcher invoked unavailable cmp\n' >&2
exit 127
CMP
chmod 0755 "$no_cmp_bin/cmp"
PATH="$no_cmp_bin:$PATH" DOT_CLIENT_LAUNCHER_TEST_LOG="$log" \
  DOT_CLIENT_HANDOFF_TEST_LOG="$helper_log" \
  DOT_CLIENT_CUTOVER_LOCK="$lock" \
  DOT_CLIENT_HANDOFF_HELPER="$helper" \
  DOT_CLIENT_LEGACY_LAUNCHER="$legacy" \
  SHDEPS_INSTALL_DIR="$install_home/" \
  "$launcher" first 'two words'
assert_eq $'standalone\nfirst\ntwo words' "$(<"$log")" \
  'client launcher standalone arguments'
assert_eq '' "$(<"$helper_log")" \
  'client launcher leaves handoff recovery to the locked standalone runtime'

printf 'benign\n' >"$checkout/benign"
git -C "$checkout" add benign
git -c core.hooksPath= -C "$checkout" commit --quiet -m selected-head
selected_revision=$(git -C "$checkout" rev-parse HEAD)
printf 'DOT_EXTENSION_API_VERSION=2\n' >"$public_api"
git -C "$checkout" add lib/dot/public/api-version.sh
replacement_tree=$(git -C "$checkout" write-tree)
replacement_revision=$(printf 'replacement fixture\n' |
  git -c core.hooksPath= -C "$checkout" commit-tree \
    -p "$minimum_revision" "$replacement_tree")
git -C "$checkout" reset --hard --quiet "$selected_revision"
git -C "$checkout" replace "$selected_revision" "$replacement_revision"
assert_internal_validation_rejected 'local replacement metadata'
printf 'DOT_EXTENSION_API_VERSION=2\n' >"$public_api"
assert_checkout_change_falls_back replaced-head-tree \
  'client launcher rejects local replace metadata before validating HEAD'
git -C "$checkout" replace -d "$selected_revision" >/dev/null
git -C "$checkout" reset --hard --quiet "$minimum_revision"

write_lock prepare "$selected_revision"
assert_internal_validation_rejected 'checkout below locked minimum'
write_lock active "$minimum_revision"

printf 'DOT_EXTENSION_API_VERSION=2\n' >"$public_api"
git -C "$checkout" add lib/dot/public/api-version.sh
grafted_tree=$(git -C "$checkout" write-tree)
grafted_revision=$(printf 'grafted fixture\n' |
  git -c core.hooksPath= -C "$checkout" commit-tree "$grafted_tree")
git -C "$checkout" reset --hard --quiet "$grafted_revision"
grafts=$(git -C "$checkout" rev-parse --git-path info/grafts)
case $grafts in
  /*) ;;
  *) grafts=$checkout/$grafts ;;
esac
printf '%s %s\n' "$grafted_revision" "$minimum_revision" >"$grafts"
assert_checkout_change_falls_back grafted-ancestry \
  'client launcher rejects local grafts that rewrite minimum ancestry'
rm -f -- "$grafts"
git -C "$checkout" reset --hard --quiet "$minimum_revision"

fsmonitor=$DOT_TEST_TMP/client-fsmonitor
fsmonitor_log=$DOT_TEST_TMP/client-fsmonitor.log
cat >"$fsmonitor" <<'FSMONITOR'
#!/usr/bin/env bash
printf 'called\n' >>"${DOT_CLIENT_FSMONITOR_TEST_LOG:?}"
printf 'client-launcher-test-token\n'
FSMONITOR
chmod 0755 "$fsmonitor"
git -C "$checkout" config core.fsmonitor "$fsmonitor"
rm -f -- "$log" "$helper_log" "$fsmonitor_log"
DOT_CLIENT_FSMONITOR_TEST_LOG=$fsmonitor_log \
  DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" configured-fsmonitor
assert_eq $'standalone\nconfigured-fsmonitor' "$(<"$log")" \
  'client launcher accepts a clean checkout with configured fsmonitor'
[[ ! -e $fsmonitor_log ]] ||
  fail 'client launcher executed configured fsmonitor during authority check'
git -C "$checkout" config --unset-all core.fsmonitor

clean_filter=$DOT_TEST_TMP/client-clean-filter
cat >"$clean_filter" <<'FILTER'
#!/usr/bin/env bash
sed 's/DOT_EXTENSION_API_VERSION=2/DOT_EXTENSION_API_VERSION=1/'
FILTER
chmod 0755 "$clean_filter"
printf 'lib/dot/public/api-version.sh filter=client-clean\n' \
  >"$checkout/.gitattributes"
git -C "$checkout" config filter.client-clean.clean "$clean_filter"
printf 'DOT_EXTENSION_API_VERSION=2\n' >"$public_api"
assert_checkout_change_falls_back filtered-public-library \
  'client launcher compares literal bytes instead of filtered Git content'
git -C "$checkout" checkout -- lib/dot/public/api-version.sh
git -C "$checkout" config --unset-all filter.client-clean.clean
rm -f -- "$checkout/.gitattributes"

git -C "$checkout" update-index --skip-worktree \
  lib/dot/public/api-version.sh
printf 'DOT_EXTENSION_API_VERSION=2\n' >"$public_api"
assert_checkout_change_falls_back dirty-public-library \
  'client launcher rejects a dirty library hidden by index metadata'
git -C "$checkout" update-index --no-skip-worktree \
  lib/dot/public/api-version.sh
git -C "$checkout" checkout -- lib/dot/public/api-version.sh

git -C "$checkout" update-index --assume-unchanged bin/dot
printf '\n# dirty runtime\n' >>"$runtime"
assert_checkout_change_falls_back dirty-runtime \
  'client launcher rejects a dirty runtime hidden by index metadata'
git -C "$checkout" update-index --no-assume-unchanged bin/dot
git -C "$checkout" checkout -- bin/dot

cp "$public_api" "$DOT_TEST_TMP/public-api-target"
rm -f -- "$public_api"
ln -s "$DOT_TEST_TMP/public-api-target" "$public_api"
assert_checkout_change_falls_back typechanged-public-library \
  'client launcher rejects a tracked file replaced by a symlink'
git -C "$checkout" checkout -- lib/dot/public/api-version.sh

# The preparation revision may stage and validate a complete standalone
# checkout, but it must remain dormant until a later fleet-visible revision
# changes the single lock authority to active.
write_lock prepare "$minimum_revision"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" prepared
assert_eq $'legacy\nfront-door='"$launcher"$'\nprepared' "$(<"$log")" \
  'client launcher prepare phase remains on embedded Dot'
assert_eq restore "$(<"$helper_log")" \
  'client launcher restores before prepare-phase fallback'

# Preparation does not consume standalone state. Keep legacy continuity for a
# relative XDG value that the embedded engine resolves through HOME fallback.
rm -f -- "$log" "$helper_log"
unset DOT_CLIENT_READY
XDG_STATE_HOME=relative/state DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR=relative \
  "$launcher" prepared-relative-state
assert_eq $'legacy\nfront-door='"$launcher"$'\nprepared-relative-state' \
  "$(<"$log")" 'client launcher prepare phase ignores standalone-only paths'
export DOT_CLIENT_READY=$ready

# Tracked activation alone is insufficient. The preparation update writes a
# private readiness record only after client convergence succeeds; without it,
# even a complete and otherwise valid checkout must remain dormant.
write_lock active "$minimum_revision"
rm -f -- "$ready"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" unready
assert_eq $'legacy\nfront-door='"$launcher"$'\nunready' "$(<"$log")" \
  'client launcher requires private host readiness'
write_ready "$minimum_revision"

# github:repo deliberately publishes an exact symlink to the selected local
# development checkout. The same validated tree must remain usable after the
# fleet phase activates without broadening acceptance to arbitrary symlinks.
mv "$checkout" "$dev_checkout"
ln -s "$dev_checkout" "$checkout"
rm -f -- "$log" "$helper_log"
SHDEPS_GIT_DEV_DIR=$dev_root DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR=$install_home \
  "$launcher" local-clone-active
assert_eq $'standalone\nlocal-clone-active' "$(<"$log")" \
  'client launcher accepts the selected Shdeps local clone after activation'
rm -f -- "$checkout"
mv "$dev_checkout" "$checkout"

chmod 0644 "$ready"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" public-ready
assert_eq $'legacy\nfront-door='"$launcher"$'\npublic-ready' "$(<"$log")" \
  'client launcher rejects non-private readiness authority'
chmod 0600 "$ready"

rm -f -- "$ready"
printf 'foreign readiness\n' >"$DOT_TEST_TMP/ready-target"
chmod 0600 "$DOT_TEST_TMP/ready-target"
ln -s "$DOT_TEST_TMP/ready-target" "$ready"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" symlink-ready
assert_eq $'legacy\nfront-door='"$launcher"$'\nsymlink-ready' "$(<"$log")" \
  'client launcher rejects symlinked readiness authority'
rm -f -- "$ready"
write_ready "$minimum_revision"

cp "$config_path" "$DOT_TEST_TMP/config.original"
printf 'version=1\ndependency_provider=none\n' >"$config_path"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG="$log" \
  DOT_CLIENT_CUTOVER_LOCK="$lock" DOT_CLIENT_HANDOFF_HELPER="$helper" \
  DOT_CLIENT_HANDOFF_TEST_LOG="$helper_log" \
  DOT_CLIENT_LEGACY_LAUNCHER="$legacy" SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" changed-config
assert_eq $'legacy\nfront-door='"$launcher"$'\nchanged-config' "$(<"$log")" \
  'client launcher binds readiness to exact config content'
cp "$DOT_TEST_TMP/config.original" "$config_path"

mv "$config_path" "$DOT_TEST_TMP/config.target"
ln -s "$DOT_TEST_TMP/config.target" "$config_path"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG="$log" \
  DOT_CLIENT_CUTOVER_LOCK="$lock" DOT_CLIENT_HANDOFF_HELPER="$helper" \
  DOT_CLIENT_HANDOFF_TEST_LOG="$helper_log" \
  DOT_CLIENT_LEGACY_LAUNCHER="$legacy" SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" symlinked-config
assert_eq $'legacy\nfront-door='"$launcher"$'\nsymlinked-config' "$(<"$log")" \
  'client launcher rejects a symlinked config authority'
rm -f -- "$config_path"
mv "$DOT_TEST_TMP/config.target" "$config_path"

alternate_config_home=$HOME/alternate-config
alternate_config=$alternate_config_home/dot/config
mkdir -p "$(dirname "$alternate_config")"
cp "$config_path" "$alternate_config"
rm -f -- "$log" "$helper_log"
XDG_CONFIG_HOME=$alternate_config_home DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" different-config-root
assert_eq $'legacy\nfront-door='"$launcher"$'\ndifferent-config-root' \
  "$(<"$log")" 'client launcher binds readiness to its config path'

write_ready "$minimum_revision" "$ready" "$alternate_config"
rm -f -- "$log" "$helper_log"
env -u XDG_CONFIG_HOME \
  DOT_CLIENT_LAUNCHER_TEST_LOG="$log" \
  DOT_CLIENT_CUTOVER_LOCK="$lock" DOT_CLIENT_HANDOFF_HELPER="$helper" \
  DOT_CLIENT_HANDOFF_TEST_LOG="$helper_log" \
  DOT_CLIENT_LEGACY_LAUNCHER="$legacy" SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" default-after-alternate
assert_eq $'legacy\nfront-door='"$launcher"$'\ndefault-after-alternate' \
  "$(<"$log")" 'client launcher rejects alternate-root readiness by default'

write_ready "$minimum_revision"
rm -f -- "$log" "$helper_log"
XDG_CONFIG_HOME=relative/config DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" relative-config-root
assert_eq $'standalone\nrelative-config-root' "$(<"$log")" \
  'client launcher resolves relative XDG config through HOME fallback'

rm -f -- "$public_link"
ln -s "$DOT_TEST_TMP/foreign-public" "$public_link"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" foreign-public-link
assert_eq $'legacy\nfront-door='"$launcher"$'\nforeign-public-link' "$(<"$log")" \
  'client launcher binds the public library to the selected checkout'
rm -f -- "$public_link"
ln -s "$checkout/lib/dot/public" "$public_link"

# An old embedded updater re-execs the newly pulled front door with a private
# --skip-pull flag. Standalone Dot deliberately does not own that flag, so the
# adapter must fence the entire inherited re-exec through the legacy launcher
# even after activation.
write_lock active "$minimum_revision"
rm -f -- "$log" "$helper_log"
DOT_REEXEC=1 DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" update --skip-pull --cron
assert_eq $'legacy\nfront-door='"$launcher"$'\nupdate\n--skip-pull\n--cron' \
  "$(<"$log")" 'client launcher fences an embedded updater re-exec'

# The forwarder lands before the capability lock and checkout on some hosts.
# That enabling state must keep executing the exact retained embedded launcher.
rm -f -- "$log" "$helper_log"
unset DOT_CLIENT_READY
XDG_STATE_HOME=relative/state DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_CUTOVER_LOCK=$DOT_TEST_TMP/missing-lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" fallback
assert_eq $'legacy\nfront-door='"$launcher"$'\nfallback' "$(<"$log")" \
  'client launcher enabling fallback'
assert_eq restore "$(<"$helper_log")" \
  'client launcher restores the library before embedded fallback'
export DOT_CLIENT_READY=$ready

generation_home=$DOT_TEST_TMP/generation-state-home
stale_generation_ready=$generation_home/.local/state/dot/client-ready-v4/old-topology/$minimum_revision
write_ready "$minimum_revision" "$stale_generation_ready" "$config_path"
write_lock active "$minimum_revision" "$readiness_generation"
rm -f -- "$log" "$helper_log"
env -u DOT_CLIENT_READY \
  HOME="$generation_home" \
  DOT_CLIENT_LAUNCHER_TEST_LOG="$log" \
  DOT_CLIENT_CUTOVER_LOCK="$lock" \
  DOT_CLIENT_HANDOFF_HELPER="$helper" \
  DOT_CLIENT_HANDOFF_TEST_LOG="$helper_log" \
  DOT_CLIENT_LEGACY_LAUNCHER="$legacy" \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" stale-readiness-generation
assert_eq $'legacy\nfront-door='"$launcher"$'\nstale-readiness-generation' \
  "$(<"$log")" 'client launcher requires the selected readiness generation'

printf 'cgraf78 dot client cutover v4\nphase=unknown\nminimum_revision=%s\nreadiness_generation=%s\n' \
  "$minimum_revision" "$readiness_generation" >"$lock"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" malformed-lock
assert_eq $'legacy\nfront-door='"$launcher"$'\nmalformed-lock' "$(<"$log")" \
  'client launcher treats malformed activation authority as legacy-only'

write_lock active "$minimum_revision" '../foreign'
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" malformed-generation
assert_eq $'legacy\nfront-door='"$launcher"$'\nmalformed-generation' "$(<"$log")" \
  'client launcher rejects an unsafe readiness generation'

# Some UTF-8 collation tables let a fullwidth digit match `[0-9]`. Cutover
# authority is ASCII regardless of the invoking host's locale.
utf8_locale=$(locale -a 2>/dev/null |
  awk 'tolower($0) ~ /^en_us.*utf/ && !found { value = $0; found = 1 }
    END { if (found) print value }') || utf8_locale=
if [[ -n $utf8_locale ]]; then
  unicode_home=$DOT_TEST_TMP/unicode-generation-home
  unicode_generation='client-topology-v１'
  unicode_ready=$unicode_home/.local/state/dot/client-ready-v4/$unicode_generation/$minimum_revision
  write_ready "$minimum_revision" "$unicode_ready" "$config_path"
  write_lock active "$minimum_revision" "$unicode_generation"
  rm -f -- "$log" "$helper_log"
  env -u DOT_CLIENT_READY \
    LC_ALL="$utf8_locale" HOME="$unicode_home" \
    DOT_CLIENT_LAUNCHER_TEST_LOG="$log" \
    DOT_CLIENT_CUTOVER_LOCK="$lock" \
    DOT_CLIENT_HANDOFF_HELPER="$helper" \
    DOT_CLIENT_HANDOFF_TEST_LOG="$helper_log" \
    DOT_CLIENT_LEGACY_LAUNCHER="$legacy" \
    SHDEPS_INSTALL_DIR="$install_home" \
    "$launcher" unicode-generation
  assert_eq $'legacy\nfront-door='"$launcher"$'\nunicode-generation' \
    "$(<"$log")" 'client launcher keeps generation syntax ASCII'
fi

printf 'cgraf78 dot client cutover v4\nphase=ACTIVE\nminimum_revision=%s\nreadiness_generation=%s\n' \
  "$minimum_revision" "$readiness_generation" >"$lock"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR="$install_home" \
  bash -O nocasematch "$launcher" inherited-nocasematch
assert_eq $'legacy\nfront-door='"$launcher"$'\ninherited-nocasematch' "$(<"$log")" \
  'client launcher keeps cutover tokens case-sensitive'

# A lock whose required revision is not an ancestor of the checkout cannot
# authorize cutover. Preserve command continuity through the embedded engine.
foreign=$DOT_TEST_TMP/foreign
git init --quiet "$foreign"
git -C "$foreign" config user.name 'Dot Test'
git -C "$foreign" config user.email dot-test@example.invalid
printf 'foreign\n' >"$foreign/file"
git -C "$foreign" add file
git -c core.hooksPath= -C "$foreign" commit --quiet -m foreign
foreign_revision=$(git -C "$foreign" rev-parse HEAD)
write_lock active "$foreign_revision"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" stale
assert_eq $'legacy\nfront-door='"$launcher"$'\nstale' "$(<"$log")" \
  'client launcher stale-cutover fallback'
assert_eq restore "$(<"$helper_log")" \
  'client launcher restores before stale-cutover fallback'

write_lock active "$minimum_revision"
rm -f -- "$ready"
printf 'malformed readiness\n' >"$ready"
chmod 0600 "$ready"
rm -f -- "$log" "$helper_log"
DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" malformed-ready
assert_eq $'legacy\nfront-door='"$launcher"$'\nmalformed-ready' "$(<"$log")" \
  'client launcher treats malformed readiness as legacy-only'
rm -f -- "$ready"
write_ready "$minimum_revision"

# After the restoration horizon, an unavailable standalone target produces the
# tested recovery command instead of pretending the embedded engine exists.
write_lock active "$foreign_revision"
rm -f -- "$legacy"
if DOT_CLIENT_LAUNCHER_TEST_LOG=$log \
  DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" >/dev/null 2>"$DOT_TEST_TMP/recovery.err"; then
  fail 'client launcher accepted an unavailable standalone runtime after cleanup'
fi
assert_contains 'curl -fsSL https://raw.githubusercontent.com/cgraf78/dot/main/install.sh | bash' \
  "$(<"$DOT_TEST_TMP/recovery.err")" \
  'client launcher recovery command'

printf 'cgraf78 dot client cutover v4\nphase=unknown\nminimum_revision=%s\nreadiness_generation=%s\n' \
  "$minimum_revision" "$readiness_generation" >"$lock"
if DOT_CLIENT_CUTOVER_LOCK=$lock DOT_CLIENT_HANDOFF_HELPER=$helper \
  DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy SHDEPS_INSTALL_DIR="$install_home" \
  "$launcher" >/dev/null 2>&1; then
  fail 'client launcher accepted a malformed cutover lock'
fi

if SHDEPS_INSTALL_DIR=relative DOT_CLIENT_CUTOVER_LOCK=$lock \
  DOT_CLIENT_HANDOFF_HELPER=$helper DOT_CLIENT_HANDOFF_TEST_LOG=$helper_log \
  DOT_CLIENT_LEGACY_LAUNCHER=$legacy \
  "$launcher" >/dev/null 2>&1; then
  fail 'client launcher accepted a relative install root'
fi

printf 'client-launcher-test: ok\n'
