#!/usr/bin/env bash

set -euo pipefail

# shellcheck disable=SC1091 # Test helper path is resolved from this file.
. "$(dirname "${BASH_SOURCE[0]}")/lib/test.sh"

# The checkout launcher is development-only and enters a compiled binary.
native_checkout=$DOT_TEST_TMP/native-checkout
mkdir -p "$native_checkout/bin" "$native_checkout/target/debug"
cp "$DOT_TEST_ROOT/bin/dot" "$native_checkout/bin/dot"
cp "$DOT_TEST_ROOT/target/debug/dot" "$native_checkout/target/debug/dot"
native_version=$(HOME=$DOT_TEST_TMP/native-home "$native_checkout/bin/dot" version)
assert_eq "$("$DOT_TEST_ROOT/target/debug/dot" version)" "$native_version" \
  'development launcher enters the native binary'

missing_checkout=$DOT_TEST_TMP/missing-native-checkout
mkdir -p "$missing_checkout/bin"
cp "$DOT_TEST_ROOT/bin/dot" "$missing_checkout/bin/dot"
if HOME=$DOT_TEST_TMP/native-home "$missing_checkout/bin/dot" version \
  >"$DOT_TEST_TMP/missing-native.out" 2>"$DOT_TEST_TMP/missing-native.err"; then
  fail 'development launcher succeeded without a compiled binary'
fi
assert_eq '' "$(<"$DOT_TEST_TMP/missing-native.out")" \
  'missing native binary leaves stdout empty'
# shellcheck disable=SC2016 # Backticks are literal expected syntax.
assert_contains 'run `cargo build --locked`' \
  "$(<"$DOT_TEST_TMP/missing-native.err")" \
  'missing native binary gives the build command'

# The retained client-owned launcher follows the standalone release root. It
# adds no output and preserves argv and the native process status exactly.
launcher=$DOT_TEST_ROOT/support/client-launcher.sh
client_home=$DOT_TEST_TMP/home
data_home=$DOT_TEST_TMP/data
release=$data_home/cgraf78/dot
runtime_log=$DOT_TEST_TMP/runtime.log

write_release() {
  local root=$1

  mkdir -p "$root/lib/dot/public"
  cat >"$root/dot" <<'RUNTIME'
#!/usr/bin/env bash
printf '<%s>\n' "$@" >"${DOT_CLIENT_TEST_RUNTIME_LOG:?}"
exit "${DOT_CLIENT_TEST_RUNTIME_STATUS:-0}"
RUNTIME
  chmod 0755 "$root/dot"
}

assert_rejected() {
  local label=$1
  shift
  rm -f -- "$runtime_log" "$DOT_TEST_TMP/rejected.out" "$DOT_TEST_TMP/rejected.err"
  if HOME=$client_home DOT_CLIENT_TEST_RUNTIME_LOG=$runtime_log \
    "$@" "$launcher" rejected >"$DOT_TEST_TMP/rejected.out" \
    2>"$DOT_TEST_TMP/rejected.err"; then
    fail "$label: launcher unexpectedly succeeded"
  fi
  assert_eq '' "$(<"$DOT_TEST_TMP/rejected.out")" "$label: stdout"
  assert_contains 'dot: standalone runtime is unavailable' \
    "$(<"$DOT_TEST_TMP/rejected.err")" "$label: diagnostic"
  [[ ! -e $runtime_log ]] || fail "$label: rejected runtime executed"
}

write_release "$release"
set +e
HOME=$client_home XDG_DATA_HOME=$data_home CGRAF78_CHECKOUT_INSTALL_DIR='' \
  DOT_CLIENT_TEST_RUNTIME_LOG=$runtime_log DOT_CLIENT_TEST_RUNTIME_STATUS=37 \
  "$launcher" first 'two words' >"$DOT_TEST_TMP/forward.out" \
  2>"$DOT_TEST_TMP/forward.err"
status=$?
set -e
assert_eq 37 "$status" 'client launcher preserves runtime status'
assert_eq $'<first>\n<two words>' "$(<"$runtime_log")" \
  'client launcher preserves arguments'
assert_eq '' "$(<"$DOT_TEST_TMP/forward.out")" 'client launcher adds no stdout'
assert_eq '' "$(<"$DOT_TEST_TMP/forward.err")" 'client launcher adds no stderr'

default_release=$client_home/.local/share/cgraf78/dot
write_release "$default_release"
rm -f -- "$runtime_log"
HOME=$client_home XDG_DATA_HOME='' CGRAF78_CHECKOUT_INSTALL_DIR='' \
  DOT_CLIENT_TEST_RUNTIME_LOG=$runtime_log "$launcher" default-root
assert_eq '<default-root>' "$(<"$runtime_log")" \
  'client launcher uses the installer default data root'

explicit_release=$DOT_TEST_TMP/explicit/dot
write_release "$explicit_release"
rm -f -- "$runtime_log"
HOME=$client_home XDG_DATA_HOME=relative \
  CGRAF78_CHECKOUT_INSTALL_DIR=$explicit_release \
  DOT_CLIENT_TEST_RUNTIME_LOG=$runtime_log "$launcher" explicit-root
assert_eq '<explicit-root>' "$(<"$runtime_log")" \
  'explicit release root takes precedence'

chmod 0644 "$release/dot"
assert_rejected 'non-executable runtime' \
  env XDG_DATA_HOME="$data_home" CGRAF78_CHECKOUT_INSTALL_DIR=
chmod 0755 "$release/dot"
mv "$release/lib/dot/public" "$release/public-away"
assert_rejected 'missing public API' \
  env XDG_DATA_HOME="$data_home" CGRAF78_CHECKOUT_INSTALL_DIR=
assert_rejected 'relative data root' \
  env XDG_DATA_HOME=relative CGRAF78_CHECKOUT_INSTALL_DIR=
assert_rejected 'relative explicit root' \
  env XDG_DATA_HOME="$data_home" CGRAF78_CHECKOUT_INSTALL_DIR=relative/dot
assert_rejected 'root client home' \
  env HOME=/ XDG_DATA_HOME="$data_home" CGRAF78_CHECKOUT_INSTALL_DIR=

printf 'client-launcher-test: ok\n'
