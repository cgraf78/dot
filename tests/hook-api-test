#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"

HOME=$DOT_TEST_TMP/home
DOT_TEST=1
DOT_SOURCE_ROOT=$root
DOT_EXTENSIONS_DIR=$HOME/extensions
mkdir -p "$HOME" "$DOT_EXTENSIONS_DIR" "$DOT_TEST_TMP/bin"
export HOME DOT_TEST DOT_SOURCE_ROOT DOT_EXTENSIONS_DIR
# shellcheck source=../lib/dot/public/xdg.sh
. "$root/lib/dot/public/xdg.sh"
# shellcheck source=../lib/dot/temp.sh
. "$root/lib/dot/temp.sh"
# shellcheck source=../lib/dot/families.sh
. "$root/lib/dot/families.sh"
# shellcheck source=../lib/dot/merge-block.sh
. "$root/lib/dot/merge-block.sh"
# shellcheck source=../lib/dot/merge-hooks.sh
. "$root/lib/dot/merge-hooks.sh"
# shellcheck source=../lib/dot/platform.sh
. "$root/lib/dot/platform.sh"
# shellcheck source=../lib/dot/hook-api.sh
. "$root/lib/dot/hook-api.sh"

literal_dollar='$'
literal_tilde='~'
assert_eq "$HOME/example" "$(dot_expand_home "${literal_dollar}HOME/example")" \
  'hook API expands HOME placeholder'
assert_eq "$HOME/example" "$(dot_expand_home "$literal_tilde/example")" \
  'hook API expands tilde placeholder'

family_root=$(dot_hook_family fixture)
mkdir -p "$family_root"
printf 'one\n' >"$family_root/10-one.txt"
assert_eq "$family_root/10-one.txt" "$(dot_hook_family_files fixture)" \
  'hook family API enumerates a configured family'
assert_eq "$family_root/10-one.txt" \
  "$(dot_hook_family_files_matching fixture '*.txt')" \
  'hook family API filters a configured family'
assert_eq '10-one.txt' \
  "$(dot_hook_family_relpath fixture "$family_root/10-one.txt")" \
  'hook family API returns a family-relative path'
assert_eq '10-one.txt' \
  "$(dot_hook_family_marker_name fixture "$family_root/10-one.txt")" \
  'hook family API returns a marker-safe identity'

for filter in '' linux macos wsl android '!linux' 'linux,!macos'; do
  platform_status=0
  hook_status=0
  dot_platform_match "$filter" || platform_status=$?
  dot_hook_platform_match "$filter" || hook_status=$?
  assert_eq "$platform_status" "$hook_status" \
    "hook platform matcher conforms for [$filter]"
done
for filter in '' fixture-host '!fixture-host' 'fixture-host,!other'; do
  host_status=0
  hook_status=0
  dot_host_match "$filter" || host_status=$?
  dot_hook_host_match "$filter" || hook_status=$?
  assert_eq "$host_status" "$hook_status" \
    "hook host matcher conforms for [$filter]"
done

_dot_platform() { printf 'linux\n'; }
_dot_hook_platform() { printf 'linux\n'; }
_dot_hook_host() { printf 'fixture-host\n'; }

# Termux has both Linux kernel and Android userspace identities. Match the
# complete set at once so either identity can include or exclude the runtime.
while IFS=' ' read -r expected filter; do
  for matcher in dot_platform_match dot_hook_platform_match; do
    platform_status=0
    PREFIX=/data/data/com.termux/files/usr "$matcher" "$filter" ||
      platform_status=$?
    assert_eq "$expected" "$platform_status" \
      "$matcher matches Termux filter [$filter]"
  done
done <<'TERMUX_PLATFORM_CASES'
0 linux
0 android
0 linux,macos
0 !macos
1 !android
1 !linux
1 !android,!macos
1 linux,!android
1 android,!linux
1 macos,!freebsd
TERMUX_PLATFORM_CASES

dot_hook_platform_match linux || fail 'hook platform matcher rejected current platform'
if dot_hook_platform_match macos; then
  fail 'hook platform matcher accepted a different platform'
fi
dot_hook_host_match FIXTURE-HOST || fail 'hook host matcher is not case-insensitive'
if dot_hook_host_match '!fixture-host'; then
  fail 'hook host matcher ignored an exclusion'
fi

text_target=$HOME/generated/config
mkdir -p "${text_target%/*}"
dot_write_text_if_changed "$text_target" $'alpha\nbeta'
assert_eq $'alpha\nbeta' "$(<"$text_target")" 'text helper writes exact content'
inode_before=$(stat -c '%i' "$text_target" 2>/dev/null || stat -f '%i' "$text_target")
dot_write_text_if_changed "$text_target" $'alpha\nbeta'
inode_after=$(stat -c '%i' "$text_target" 2>/dev/null || stat -f '%i' "$text_target")
assert_eq "$inode_before" "$inode_after" 'unchanged text helper preserves inode'

transaction_target=$HOME/generated/transaction.conf
printf 'managed\n' >"$transaction_target"
transaction_generation=$(dot_file_generation "$transaction_target")
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'updated\n' >"$transaction_tmp"
dot_commit_tmp_if_generation \
  "$transaction_tmp" "$transaction_target" "$transaction_generation"
assert_eq 'updated' "$(<"$transaction_target")" \
  'generation commit replaces the captured regular file'

transaction_generation=$(dot_file_generation "$transaction_target")
printf 'user replacement\n' >"$transaction_target"
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'stale update\n' >"$transaction_tmp"
if dot_commit_tmp_if_generation \
  "$transaction_tmp" "$transaction_target" "$transaction_generation"; then
  fail 'generation commit accepted a stale destination'
fi
assert_eq 'user replacement' "$(<"$transaction_target")" \
  'generation commit preserves a late replacement'
rm -f "$transaction_tmp"

transaction_generation=$(dot_file_generation "$transaction_target")
dot_remove_if_generation "$transaction_target" "$transaction_generation"
[[ ! -e $transaction_target && ! -L $transaction_target ]] ||
  fail 'generation remove did not delete the captured regular file'

transaction_generation=$(dot_file_generation "$transaction_target")
printf 'late creation\n' >"$transaction_target"
if dot_remove_if_generation "$transaction_target" "$transaction_generation"; then
  fail 'generation remove accepted a stale absent destination'
fi
assert_eq 'late creation' "$(<"$transaction_target")" \
  'generation remove preserves a late creation'

if dot_remove_if_generation "$transaction_target" 'v1|forged'; then
  fail 'generation remove accepted a malformed token'
fi
assert_eq 'late creation' "$(<"$transaction_target")" \
  'malformed generation cannot mutate a destination'

transaction_link=$HOME/generated/transaction-link
ln -s "$transaction_target" "$transaction_link"
if dot_file_generation "$transaction_link" >/dev/null; then
  fail 'file generation accepted a symlink destination'
fi
rm "$transaction_link"

mkdir "$HOME/parent-a" "$HOME/parent-b"
printf 'parent a\n' >"$HOME/parent-a/config"
printf 'parent b\n' >"$HOME/parent-b/config"
ln -s "$HOME/parent-a" "$HOME/selected-parent"
parent_generation=$(dot_file_generation "$HOME/selected-parent/config")
rm "$HOME/selected-parent"
ln -s "$HOME/parent-b" "$HOME/selected-parent"
dot_sibling_tmp_for "$HOME/selected-parent/config"
parent_tmp=$REPLY
printf 'redirected update\n' >"$parent_tmp"
if dot_commit_tmp_if_generation \
  "$parent_tmp" "$HOME/selected-parent/config" "$parent_generation"; then
  fail 'generation commit followed a replaced parent symlink'
fi
assert_eq 'parent a' "$(<"$HOME/parent-a/config")" \
  'parent swap preserves the originally captured file'
assert_eq 'parent b' "$(<"$HOME/parent-b/config")" \
  'parent swap preserves the replacement parent file'
rm -f "$parent_tmp"

printf 'managed\n' >"$transaction_target"
transaction_generation=$(dot_file_generation "$transaction_target")
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'candidate\n' >"$transaction_tmp"
move_noreplace_definition=$(declare -f _dot_move_noreplace)
eval "${move_noreplace_definition/_dot_move_noreplace/_dot_move_noreplace_original}"
late_publish_injected=0
# shellcheck disable=SC2329 # Invoked indirectly by the transaction helper.
_dot_move_noreplace() {
  if [[ $1 == */candidate && $2 == "$transaction_target" &&
    $late_publish_injected -eq 0 ]]; then
    printf 'late winner\n' >"$2"
    late_publish_injected=1
  fi
  _dot_move_noreplace_original "$@"
}
if dot_commit_tmp_if_generation \
  "$transaction_tmp" "$transaction_target" "$transaction_generation"; then
  fail 'generation commit replaced a late publication winner'
fi
eval "$move_noreplace_definition"
unset -f _dot_move_noreplace_original
assert_eq 'late winner' "$(<"$transaction_target")" \
  'generation commit preserves a publication winner'
[[ ! -e $HOME/generated/.transaction.conf.dot-file-transaction-v1 ]] ||
  fail 'publication conflict left transaction debris'

printf 'managed\n' >"$transaction_target"
transaction_generation=$(dot_file_generation "$transaction_target")
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'candidate\n' >"$transaction_tmp"
move_noreplace_definition=$(declare -f _dot_move_noreplace)
eval "${move_noreplace_definition/_dot_move_noreplace/_dot_move_noreplace_original}"
late_quarantine_injected=0
# shellcheck disable=SC2329 # Invoked indirectly by the transaction helper.
_dot_move_noreplace() {
  if [[ $1 == "$transaction_target" && $2 == */previous &&
    $late_quarantine_injected -eq 0 ]]; then
    printf 'quarantine winner\n' >"$1"
    late_quarantine_injected=1
  fi
  _dot_move_noreplace_original "$@"
}
if dot_commit_tmp_if_generation \
  "$transaction_tmp" "$transaction_target" "$transaction_generation"; then
  fail 'generation commit accepted a quarantine-boundary replacement'
fi
eval "$move_noreplace_definition"
unset -f _dot_move_noreplace_original
assert_eq 'quarantine winner' "$(<"$transaction_target")" \
  'generation commit restores a quarantine-boundary replacement'
[[ ! -e $HOME/generated/.transaction.conf.dot-file-transaction-v1 ]] ||
  fail 'quarantine conflict left transaction debris'

printf 'before crash\n' >"$transaction_target"
transaction_generation=$(dot_file_generation "$transaction_target")
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'after crash\n' >"$transaction_tmp"
set +e
(
  _dot_file_transaction_prepare replace "$transaction_tmp" \
    "$transaction_target" "$transaction_generation" || exit 1
  # shellcheck disable=SC2034 # Read dynamically by the transaction helper.
  DOT_FILE_TRANSACTION_OPERATION=replace
  _dot_file_transaction_quarantine || exit 1
  kill -KILL "$BASHPID"
) 2>/dev/null
crash_status=$?
set -e
[[ $crash_status -ne 0 ]] || fail 'pre-commit crash fixture did not terminate'
dot_file_generation "$transaction_target" >/dev/null
assert_eq 'before crash' "$(<"$transaction_target")" \
  'recovery restores the previous file after a pre-commit crash'

transaction_generation=$(dot_file_generation "$transaction_target")
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'committed before crash\n' >"$transaction_tmp"
set +e
(
  _dot_file_transaction_prepare replace "$transaction_tmp" \
    "$transaction_target" "$transaction_generation" || exit 1
  # shellcheck disable=SC2034 # Read dynamically by the transaction helper.
  DOT_FILE_TRANSACTION_OPERATION=replace
  _dot_file_transaction_quarantine || exit 1
  _dot_move_noreplace "$DOT_FILE_TRANSACTION_PATH/candidate" \
    "$DOT_FILE_TRANSACTION_DESTINATION" || exit 1
  kill -KILL "$BASHPID"
) 2>/dev/null
crash_status=$?
set -e
[[ $crash_status -ne 0 ]] || fail 'post-commit crash fixture did not terminate'
dot_file_generation "$transaction_target" >/dev/null
assert_eq 'committed before crash' "$(<"$transaction_target")" \
  'recovery retains a published file after a post-commit crash'
[[ ! -e $HOME/generated/.transaction.conf.dot-file-transaction-v1 ]] ||
  fail 'crash recovery left transaction debris'

printf 'remove before crash\n' >"$transaction_target"
transaction_generation=$(dot_file_generation "$transaction_target")
set +e
(
  _dot_file_transaction_prepare remove '' \
    "$transaction_target" "$transaction_generation" || exit 1
  # shellcheck disable=SC2034 # Read dynamically by the transaction helper.
  DOT_FILE_TRANSACTION_OPERATION=remove
  _dot_file_transaction_quarantine || exit 1
  kill -KILL "$BASHPID"
) 2>/dev/null
crash_status=$?
set -e
[[ $crash_status -ne 0 ]] || fail 'remove pre-commit crash fixture did not terminate'
dot_file_generation "$transaction_target" >/dev/null
assert_eq 'remove before crash' "$(<"$transaction_target")" \
  'remove recovery restores the file after a pre-commit crash'

transaction_generation=$(dot_file_generation "$transaction_target")
set +e
(
  _dot_file_transaction_prepare remove '' \
    "$transaction_target" "$transaction_generation" || exit 1
  # shellcheck disable=SC2034 # Read dynamically by the transaction helper.
  DOT_FILE_TRANSACTION_OPERATION=remove
  _dot_file_transaction_quarantine || exit 1
  _dot_file_transaction_record_write "$DOT_FILE_TRANSACTION_PATH" \
    remove committed "$DOT_FILE_TRANSACTION_EXPECTED" - || exit 1
  kill -KILL "$BASHPID"
) 2>/dev/null
crash_status=$?
set -e
[[ $crash_status -ne 0 ]] || fail 'remove post-commit crash fixture did not terminate'
dot_file_generation "$transaction_target" >/dev/null
[[ ! -e $transaction_target && ! -L $transaction_target ]] ||
  fail 'remove recovery restored a file after its commit point'

printf 'remove managed\n' >"$transaction_target"
transaction_generation=$(dot_file_generation "$transaction_target")
_dot_file_transaction_prepare remove '' \
  "$transaction_target" "$transaction_generation"
# shellcheck disable=SC2034 # Read dynamically by the transaction helper.
DOT_FILE_TRANSACTION_OPERATION=remove
_dot_file_transaction_quarantine
printf 'remove winner\n' >"$transaction_target"
dot_file_generation "$transaction_target" >/dev/null
assert_eq 'remove winner' "$(<"$transaction_target")" \
  'remove recovery preserves a late creation'
[[ ! -e $HOME/generated/.transaction.conf.dot-file-transaction-v1 ]] ||
  fail 'remove recovery left transaction debris'

transaction_generation=$(dot_file_generation "$transaction_target")
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'cleanup retry\n' >"$transaction_tmp"
cleanup_definition=$(declare -f _dot_file_transaction_cleanup)
eval "${cleanup_definition/_dot_file_transaction_cleanup/_dot_file_transaction_cleanup_original}"
_dot_file_transaction_cleanup() { return 1; }
if dot_commit_tmp_if_generation \
  "$transaction_tmp" "$transaction_target" "$transaction_generation"; then
  fail 'generation commit hid a transaction cleanup failure'
fi
eval "$cleanup_definition"
unset -f _dot_file_transaction_cleanup_original
assert_eq 'cleanup retry' "$(<"$transaction_target")" \
  'cleanup failure does not roll back committed content'
dot_file_generation "$transaction_target" >/dev/null
[[ ! -e $HOME/generated/.transaction.conf.dot-file-transaction-v1 ]] ||
  fail 'later generation capture did not finish transaction cleanup'

transaction_dir=$HOME/generated/.transaction.conf.dot-file-transaction-v1
mkdir -m 700 "$transaction_dir"
if dot_file_generation "$transaction_target" >/dev/null; then
  fail 'generation recovery trusted an unmarked transaction directory'
fi
[[ -d $transaction_dir ]] ||
  fail 'generation recovery removed an unmarked transaction directory'
rmdir "$transaction_dir"

mkdir -m 755 "$transaction_dir"
if dot_file_generation "$transaction_target" >/dev/null; then
  fail 'generation recovery trusted a non-private transaction directory'
fi
[[ -d $transaction_dir ]] ||
  fail 'generation recovery removed an untrusted transaction directory'
chmod 700 "$transaction_dir"
rmdir "$transaction_dir"

transaction_generation=$(dot_file_generation "$transaction_target")
dot_sibling_tmp_for "$transaction_target"
transaction_tmp=$REPLY
printf 'chmod failure\n' >"$transaction_tmp"
(
  # shellcheck disable=SC2329 # Invoked indirectly by the transaction helper.
  chmod() { return 1; }
  ! dot_commit_tmp_if_generation \
    "$transaction_tmp" "$transaction_target" "$transaction_generation"
) || fail 'generation commit ignored private-directory chmod failure'
assert_eq 'cleanup retry' "$(<"$transaction_target")" \
  'private-directory setup failure preserves the destination'
rm -f "$transaction_tmp"
if compgen -G "$HOME/generated/.*.dot-file-transaction-v1.init.*" >/dev/null; then
  fail 'private-directory setup failure left initialization debris'
fi

unset DOT_TEST
if dot_file_generation "$transaction_target" >/dev/null; then
  fail 'generation capture ran without the outer update lock'
fi
DOT_TEST=1
export DOT_TEST

directory_target=$HOME/generated/directory
mkdir "$directory_target"
set +e
dot_write_text_if_changed "$directory_target" unsafe >/dev/null 2>&1
directory_status=$?
set -e
assert_eq 1 "$directory_status" 'text helper refuses directory destination'
assert_eq '' "$(find "$directory_target" -mindepth 1 -maxdepth 1 -print -quit)" \
  'text helper never nests staged output in a directory'

cat >"$DOT_TEST_TMP/bin/jq" <<'JQ'
#!/usr/bin/env python3
import json
import sys

args = sys.argv[1:]
if args and args[0] == "empty":
    with open(args[1], encoding="utf-8") as source:
        json.load(source)
    raise SystemExit(0)
if "--slurpfile" in args:
    source = args[args.index("s") + 1]
    destination = args[args.index("d") + 1]
    with open(destination, encoding="utf-8") as stream:
        merged = json.load(stream)
    with open(source, encoding="utf-8") as stream:
        merged.update(json.load(stream))
else:
    source = args[-1]
    with open(source, encoding="utf-8") as stream:
        merged = json.load(stream)
json.dump(merged, sys.stdout, indent=2, sort_keys=True)
sys.stdout.write("\n")
JQ
chmod 0755 "$DOT_TEST_TMP/bin/jq"
PATH=$DOT_TEST_TMP/bin:$PATH
export PATH
json_source=$HOME/source.json
json_target=$HOME/generated.json
printf '{"alpha":1}\n' >"$json_source"
json_filter="\$d[0] * \$s[0]"
dot_json_layer fixture "$json_source" "$json_target" "$json_filter"
assert_contains '"alpha": 1' "$(<"$json_target")" 'JSON helper copies first layer'
printf '{"beta":2}\n' >"$json_source"
dot_json_layer fixture "$json_source" "$json_target" "$json_filter"
json_content=$(<"$json_target")
assert_contains '"alpha": 1' "$json_content" 'JSON helper retains destination keys'
assert_contains '"beta": 2' "$json_content" 'JSON helper overlays source keys'

managed_target=$HOME/managed.conf
managed_block=$(dot_managed_block_build '# dot:test' source.conf body)
dot_managed_block_merge "$managed_target" "$managed_block"
assert_contains '# dot:test begin' "$(<"$managed_target")" \
  'managed-block API publishes an exact block'
managed_family_block=$(dot_managed_block_build '# dot:family:new' source.conf newer)
dot_managed_block_merge_family "$managed_target" '# dot:' "$managed_family_block"
managed_content=$(<"$managed_target")
[[ $managed_content != *'# dot:test begin'* ]] ||
  fail 'managed-block family API did not retire stale blocks'
assert_contains '# dot:family:new begin' "$managed_content" \
  'managed-block family API publishes replacement blocks'
stripped_family=$(dot_managed_block_strip_family '# dot:family:' "$managed_content")
[[ $stripped_family != *'# dot:family:new begin'* ]] ||
  fail 'managed-block family strip retained a matching block'

printf 'hook-api-test: ok\n'
