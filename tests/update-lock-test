#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"
# shellcheck source=lib/repo.sh
. "$root/tests/lib/repo.sh"

fixture_home lock
home=$REPLY
state=$DOT_TEST_TMP/lock-state
ready=$DOT_TEST_TMP/lock-ready
release=$DOT_TEST_TMP/lock-release

# Minimal Linux images may omit procps or expose only BusyBox `ps`. Force that
# boundary when procfs can supply the stronger kernel start identity instead.
if [[ -r /proc/$$/stat ]]; then
  # shellcheck disable=SC2329 # Exported for the fresh holder/runtime shells.
  ps() { return 127; }
  export -f ps
fi

fail_lock_holder() {
  local pid=$1 message=$2
  kill -KILL "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  fail "$message"
}

# The lock library is independently sourceable by doctor and test consumers.
# A clean shell must load both required siblings itself instead of relying on
# the full runtime's earlier imports, and a missing sibling must not be masked
# by later top-level declarations returning success.
set +e
clean_load_output=$(HOME=$home XDG_STATE_HOME=$state \
  bash --noprofile --norc -c '
    . "$1"
    load_status=$?
    resolver=missing
    path=missing
    if declare -F dot_xdg_path >/dev/null 2>&1; then
      resolver=loaded
      if dot_xdg_path state dot/update.lock.d; then
        path=$REPLY
      fi
    fi
    printf "source=%s\nresolver=%s\npath=%s\n" \
      "$load_status" "$resolver" "$path"
    exit "$load_status"
  ' -- "$root/lib/dot/update-lock.sh" 2>&1)
clean_load_status=$?
set -e
assert_eq 0 "$clean_load_status" 'clean update-lock source succeeds'
assert_eq \
  "source=0
resolver=loaded
path=$state/dot/update.lock.d" \
  "$clean_load_output" \
  'clean update-lock source loads public XDG without missing-file output'

for missing_sibling in public/xdg.sh resources.sh; do
  missing_root=$DOT_TEST_TMP/update-lock-missing-${missing_sibling//\//-}
  mkdir -p "$missing_root/public"
  cp "$root/lib/dot/update-lock.sh" "$missing_root/update-lock.sh"
  cp "$root/lib/dot/public/xdg.sh" "$missing_root/public/xdg.sh"
  cp "$root/lib/dot/resources.sh" "$missing_root/resources.sh"
  rm "$missing_root/$missing_sibling"
  set +e
  HOME=$home XDG_STATE_HOME=$state \
    bash --noprofile --norc -c '. "$1"' -- \
    "$missing_root/update-lock.sh" >/dev/null 2>&1
  missing_status=$?
  set -e
  [[ $missing_status -ne 0 ]] ||
    fail "update-lock source succeeded without required sibling: $missing_sibling"
done

# A re-exec remains in the same process. It must keep the first ownership
# token instead of racing itself through the stale-lock recovery path.
reentry_output=$(HOME=$home XDG_STATE_HOME=$state DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/update-lock.sh"
    _dot_update_lock_acquire
    first=$DOT_UPDATE_LOCK_TOKEN
    _dot_update_lock_acquire --cron
    printf "%s/%s\n" "$first" "$DOT_UPDATE_LOCK_TOKEN"
  ')
assert_eq "${reentry_output%%/*}/${reentry_output%%/*}" "$reentry_output" \
  'same-process lock reentry retains its owner token'
[[ ! -e $state/dot/update.lock.d ]] ||
  fail 'reentered lock was not released on process exit'

HOME=$home XDG_STATE_HOME=$state DOT_SOURCE_ROOT=$DOT_TEST_ROOT \
  bash -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/api-version.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/public/ui.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/config.sh"
    dot_config_load
    . "$DOT_SOURCE_ROOT/lib/dot/runtime.sh"
    _dot_update_lock_acquire
    : >"$1"
    while [[ ! -e $2 ]]; do sleep 0.01; done
  ' -- "$ready" "$release" &
holder=$!

remaining=1000
while [[ ! -e $ready && $remaining -gt 0 ]]; do
  kill -0 "$holder" 2>/dev/null ||
    fail_lock_holder "$holder" 'lock holder exited before readiness'
  sleep 0.01
  remaining=$((remaining - 1))
done
[[ -e $ready ]] ||
  fail_lock_holder "$holder" 'lock holder did not become ready'

# A lock created with the procfs fallback must retain that identity backend if
# a full `ps` becomes available to a later contender.
if declare -F ps >/dev/null; then
  export -n -f ps
  unset -f ps
fi

set +e
run_dot "$home" "$state" update >/dev/null 2>&1
contender_status=$?
set -e
assert_eq 75 "$contender_status" 'concurrent update returns temporary-failure status'
status_output=$(run_dot "$home" "$state" init --status)
assert_contains 'initialization: not started' "$status_output" \
  'read-only init status does not acquire operation lock'

: >"$release"
wait "$holder"
run_dot "$home" "$state" update >/dev/null
[[ ! -e $state/dot/update.lock.d ]] || fail 'operation lock was not released'

# SIGKILL bypasses the owner's EXIT trap. The next process must validate that
# exact recorded generation as dead, reclaim it, and release its new claim.
rm -f -- "$ready" "$release"
HOME=$home XDG_STATE_HOME=$state DOT_SOURCE_ROOT=$DOT_TEST_ROOT \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/update-lock.sh"
    _dot_update_lock_acquire
    : >"$1"
    while :; do sleep 1; done
  ' -- "$ready" &
holder=$!
remaining=1000
while [[ ! -e $ready && $remaining -gt 0 ]]; do
  kill -0 "$holder" 2>/dev/null ||
    fail_lock_holder "$holder" 'SIGKILL lock holder exited before readiness'
  sleep 0.01
  remaining=$((remaining - 1))
done
[[ -e $ready ]] ||
  fail_lock_holder "$holder" 'SIGKILL lock holder did not become ready'
kill -KILL "$holder" 2>/dev/null || true
wait "$holder" 2>/dev/null || true
[[ -d $state/dot/update.lock.d ]] || fail 'SIGKILL did not leave recoverable lock state'
reclaimed=$(HOME=$home XDG_STATE_HOME=$state DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/update-lock.sh"
    _dot_update_lock_acquire
    printf "reclaimed\n"
  ')
assert_eq reclaimed "$reclaimed" 'stale SIGKILL owner is reclaimed'
[[ ! -e $state/dot/update.lock.d ]] || fail 'reclaimed lock was not released'

# A crash can happen after mkdir and before the owner record is published.
# Once its initialization grace has elapsed, that empty lock is recoverable.
mkdir -p "$state/dot/update.lock.d"
touch -t 200001010000 "$state/dot/update.lock.d"
reclaimed=$(HOME=$home XDG_STATE_HOME=$state DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/update-lock.sh"
    _dot_update_lock_acquire
    printf "reclaimed-empty\n"
  ')
assert_eq reclaimed-empty "$reclaimed" 'abandoned empty lock is reclaimed'
[[ ! -e $state/dot/update.lock.d ]] || fail 'abandoned empty lock was not released'

printf 'update-lock-test: ok\n'
