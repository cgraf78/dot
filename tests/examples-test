#!/usr/bin/env bash

set -euo pipefail

# shellcheck disable=SC1091 # Test helper path is resolved from this file.
. "$(dirname "${BASH_SOURCE[0]}")/lib/test.sh"
# shellcheck disable=SC1091 # Repository root comes from the test helper.
. "$DOT_TEST_ROOT/lib/dot/public/xdg.sh"
# shellcheck disable=SC1091 # Repository root comes from the test helper.
. "$DOT_TEST_ROOT/lib/dot/config.sh"
# shellcheck disable=SC1091 # Repository root comes from the test helper.
. "$DOT_TEST_ROOT/lib/dot/profiles.sh"

[[ -f "$DOT_TEST_ROOT/examples/minimal-dotfiles/home/.bashrc" ]] ||
  fail 'minimal example is missing its one-file payload'
HOME=$DOT_TEST_TMP/home
mkdir -p "$HOME"
dot_config_load \
  "$DOT_TEST_ROOT/examples/extension-dotfiles/home/.config/dot/config"
assert_eq "$HOME/.local/lib/dotfiles" "$DOT_EXTENSIONS_DIR" \
  'extension example path'
assert_eq none "$DOT_DEPENDENCY_PROVIDER" 'extension example provider'
[[ -f "$DOT_TEST_ROOT/examples/extension-dotfiles/home/.local/lib/dotfiles/merge-hooks.d/10-example.sh" ]] ||
  fail 'extension example merge hook is missing'
[[ -f "$DOT_TEST_ROOT/examples/extension-dotfiles/home/.local/lib/dotfiles/doctor.d/10-example.sh" ]] ||
  fail 'extension example doctor hook is missing'
bash -n \
  "$DOT_TEST_ROOT/examples/extension-dotfiles/home/.local/lib/dotfiles/merge-hooks.d/10-example.sh" \
  "$DOT_TEST_ROOT/examples/extension-dotfiles/home/.local/lib/dotfiles/doctor.d/10-example.sh"

profile_example=$DOT_TEST_ROOT/examples/profile-dotfiles
for path in \
  README.md \
  root/.config/dot/profiles.d/base.conf \
  root/.config/dot/profiles.d/editor.conf \
  root/.config/dot/profiles.d/dev.conf \
  root/.config/dot/overlays.d/20-nvim.conf \
  root/.config/dot/overlays.d/30-dev.conf \
  root/.config/dot/overlays.d/80-personal.conf \
  root/.config/dot/overlays.d/90-work.conf \
  root/.config/dot/profile-selectors.d/example-user.conf \
  local/user-only.conf \
  local/host-only.conf \
  local/combined.conf \
  local/two-users-user-1.conf \
  local/two-users-user-2.conf \
  local/conflict-a.conf \
  local/conflict-b.conf \
  local/no-match.conf \
  personal/dot/profile-selectors.d/dev.conf; do
  [[ -f $profile_example/$path ]] || fail "profile example is missing $path"
done

example_bin=$DOT_TEST_TMP/example-bin
example_local=$DOT_TEST_TMP/example-local
mkdir -m 700 "$example_bin" "$example_local"
cat >"$example_bin/id" <<'SH'
#!/usr/bin/env bash
printf '%s\n' example-user
SH
cat >"$example_bin/hostname" <<'SH'
#!/usr/bin/env bash
printf '%s\n' Example-Host.
SH
chmod +x "$example_bin/id" "$example_bin/hostname"
cp "$profile_example/local/combined.conf" "$example_local/combined.conf"
chmod 0600 "$example_local/combined.conf"
PATH=$example_bin:$PATH
_dot_profiles_load "$profile_example/root/.config/dot/profiles.d"
_dot_profile_resolve \
  "$DOT_TEST_TMP/no-root-selectors" \
  "$example_local" \
  "$DOT_TEST_TMP/no-personal-selectors"
assert_eq dev "$SELECTED_PROFILE" 'profile example combined selector'
assert_eq 'base editor dev' "${INCLUDED_PROFILES[*]}" \
  'profile example additive inheritance'
assert_eq 'personal nvim dev work' "${SELECTED_OVERLAY_NAMES[*]}" \
  'profile example overlay aggregation'
assert_contains 'profile-selectors.local.d' \
  "$(<"$DOT_TEST_ROOT/docs/configuration.md")" \
  'configuration docs describe machine-local selectors'
assert_contains 'selected' "$(<"$DOT_TEST_ROOT/docs/overlays.md")" \
  'overlay docs describe selected lifecycle state'
assert_contains 'eligible' "$(<"$DOT_TEST_ROOT/docs/overlays.md")" \
  'overlay docs describe eligible lifecycle state'
assert_contains 'active' "$(<"$DOT_TEST_ROOT/docs/overlays.md")" \
  'overlay docs describe active lifecycle state'
assert_contains 'inspect validated existing state only' \
  "$(<"$DOT_TEST_ROOT/docs/overlays.md")" \
  'overlay docs describe offline inspection'

printf 'examples-test: ok\n'
