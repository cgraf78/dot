def session_fds():
    """Owned-session descriptors a nested timeout wrapper must keep holding.

    The suite coordinator advertises its lease/control sockets through the
    environment. A child that closes those descriptors while keeping the
    advertisement fails closed, so preserve exactly the ones still open.
    """
