# 129th publisher remains authorization-gated until the next drain.
reader, writer = module.protocol_socketpair(module.socket.SOCK_DGRAM)
module.control_reader = reader
module.nested_control_complete = True
queued = []
writer_socket = socket.socket(fileno=writer)
try:
    writer_socket.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 1 << 20)
    for index in range(129):
        local_fd, parent_fd = module.protocol_socketpair()
        local = socket.socket(fileno=local_fd)
        parent = socket.socket(fileno=parent_fd)
        frame = b"DTS2" + struct.pack("!I", os.getpid()) + f"{index:064x}".encode()
        rights = array.array("i", [parent.fileno()])
        # Darwin reports ENOBUFS (not EAGAIN) when a burst of
        # descriptor-carrying datagrams momentarily exhausts mbuf
        # space. The backlog is still queued ahead of the drain, so
        # retry briefly; persistent exhaustion still fails loudly.
        for attempt in range(100):
            try:
                written = writer_socket.sendmsg(
                    [frame], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, rights)]
                )
            except OSError as error:
                if error.errno != errno.ENOBUFS or attempt >= 99:
                    raise
                # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
                print(f"TEMP-DIAG-180 BURST-RETRY index={index} attempt={attempt + 1}", flush=True)
                time.sleep(0.005)
            else:
                break
        assert written == len(frame)
        parent.close()
        queued.append(local)
    deadline = time.monotonic() + 2
    assert module.drain_nested_supervisors(deadline)
    assert module.nested_control_complete
    assert len(module.nested_supervisors) == 128
    assert module.drain_nested_supervisors(deadline)
    assert module.nested_control_complete
    assert len(module.nested_supervisors) == 129
finally:
    for registration in queued:
        registration.close()
    for _pid, registration in module.nested_supervisors.values():
        registration.close()
    module.nested_supervisors.clear()
    writer_socket.close()
    os.close(reader)
