#!/usr/bin/env bash

set -euo pipefail

# Trust fixtures must be secure independent of the caller's ambient umask.
umask 077

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"

home=$DOT_TEST_TMP/home
state=$DOT_TEST_TMP/state
mkdir -p "$home"

run_tests() {
  local tests=$1
  shift
  HOME="$home" XDG_STATE_HOME="$state" DOT_BASH="$BASH" \
    DOT_TEST_TESTS_DIR="$tests" DOT_TEST_NO_COLOR=1 \
    "$root/bin/dot" test "$@"
}

timeout_command=$root/lib/dot/public/test-timeout-v1
timeout_python=$(command -v python3)
[[ ! -x /usr/bin/python3 ]] || timeout_python=/usr/bin/python3
# TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
if [[ $(uname -s) == Darwin ]]; then
  export DOT_TEST_DIAG_NESTED=1
fi
set +e
"$timeout_command" >/dev/null 2>&1
missing_timeout_status=$?
"$timeout_command" nan true >/dev/null 2>&1
nan_timeout_status=$?
"$timeout_command" 0 true >/dev/null 2>&1
zero_timeout_status=$?
"$timeout_command" -1 true >/dev/null 2>&1
negative_timeout_status=$?
set -e
assert_eq 2 "$missing_timeout_status" 'timeout command requires arguments'
assert_eq 2 "$nan_timeout_status" 'timeout command rejects NaN'
assert_eq 2 "$zero_timeout_status" 'timeout command rejects zero'
assert_eq 2 "$negative_timeout_status" 'timeout command rejects negative values'

# A nested wrapper is the nearer owner for its target. The outer wrapper must
# signal that owner once, leave its target dormant while the owner is alive,
# and still close every relayed pipe before returning.
"$timeout_python" - "$timeout_command" "$timeout_python" <<'PY'
import os
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

def session_fds():
    """Owned-session descriptors a nested timeout wrapper must keep holding.

    The suite coordinator advertises its lease/control sockets through the
    environment. A child that closes those descriptors while keeping the
    advertisement fails closed, so preserve exactly the ones still open.
    """
    fds = []
    for key in (
        "DOT_OWNED_SESSION_LEASE_FDS_V1",
        "DOT_OWNED_SESSION_CONTROL_FDS_V1",
    ):
        for field in os.environ.get(key, "").split(":"):
            if not field.isdecimal():
                continue
            try:
                os.fstat(int(field))
            except OSError:
                continue
            fds.append(int(field))
    return fds

wrapper = sys.argv[1]
python = sys.argv[2]
with tempfile.TemporaryDirectory() as temporary:
    root = Path(temporary)
    ready = root / "ready"
    target_pid = root / "target.pid"
    terms = root / "terms"
    program = """
import os, signal, sys, time
from pathlib import Path
def stop(signum, _frame):
    with open(sys.argv[3], "a", encoding="utf-8") as output:
        output.write(f"{signum}\\n")
signal.signal(signal.SIGTERM, stop)
Path(sys.argv[1]).write_text(str(os.getpid()), encoding="utf-8")
Path(sys.argv[2]).write_text("ready", encoding="utf-8")
while True:
    time.sleep(0.05)
"""
    child = subprocess.Popen(
        [
            python,
            wrapper,
            "30",
            python,
            wrapper,
            "30",
            python,
            "-c",
            program,
            str(target_pid),
            str(ready),
            str(terms),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        pass_fds=session_fds(),
    )
    deadline = time.monotonic() + 5
    while not ready.exists() and time.monotonic() < deadline:
        time.sleep(0.01)
    # TEMP-DIAG-180: remove after the macOS lifecycle diagnosis.
    if not ready.exists():
        child.kill()
        try:
            o, e = child.communicate(timeout=5)
        except Exception as exc:  # noqa: BLE001
            print(f"NESTED-DUMP communicate failed: {exc!r}")
        else:
            print(f"NESTED-DUMP returncode={child.returncode}")
            print(f"NESTED-DUMP stdout={o!r}")
            print(f"NESTED-DUMP stderr={e!r}")
    assert ready.exists(), "nested timeout target did not become ready"
    os.kill(child.pid, signal.SIGTERM)
    stdout, stderr = child.communicate(timeout=7)
    assert child.returncode == 143, (child.returncode, stdout, stderr)
    delivered = terms.read_text(encoding="utf-8").splitlines()
    assert delivered == [str(int(signal.SIGTERM))], (delivered, stdout, stderr)
    pid = int(target_pid.read_text(encoding="utf-8"))
    def alive(pid):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        # A zombie is already dead: only its reaper (the suite coordinator,
        # which reaps adopted orphans when the worker stops) can make the
        # PID itself vanish, so an unreaped zombie must not read as alive.
        try:
            with open(f"/proc/{pid}/stat", "rb") as stat:
                fields = stat.read().rsplit(b") ", 1)[-1].split()
        except OSError:
            return False
        return not fields or fields[0] != b"Z"
    deadline = time.monotonic() + 2
    while alive(pid) and time.monotonic() < deadline:
        time.sleep(0.01)
    if alive(pid):
        os.kill(pid, signal.SIGKILL)
        raise AssertionError("nested target survived wrapper completion")

    # A nested deadline can already be in its TERM phase when the outer owner
    # is cancelled. The outer signals only the registered nearer wrapper; its
    # one latched cleanup pass must not redeliver TERM to the target.
    concurrent_ready = root / "concurrent.ready"
    concurrent_pid = root / "concurrent.pid"
    concurrent_terms = root / "concurrent.terms"
    concurrent = subprocess.Popen(
        [
            python,
            wrapper,
            "30",
            python,
            wrapper,
            "1",
            python,
            "-c",
            program,
            str(concurrent_pid),
            str(concurrent_ready),
            str(concurrent_terms),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        pass_fds=session_fds(),
    )
    deadline = time.monotonic() + 5
    while not concurrent_terms.exists() and time.monotonic() < deadline:
        time.sleep(0.01)
    assert concurrent_terms.exists(), "inner timeout never entered its TERM phase"
    os.kill(concurrent.pid, signal.SIGTERM)
    stdout, stderr = concurrent.communicate(timeout=7)
    assert concurrent.returncode == 143, (concurrent.returncode, stdout, stderr)
    assert concurrent_terms.read_text(encoding="utf-8").splitlines() == [
        str(int(signal.SIGTERM))
    ]
    pid = int(concurrent_pid.read_text(encoding="utf-8"))
    deadline = time.monotonic() + 2
    while alive(pid) and time.monotonic() < deadline:
        time.sleep(0.01)
    if alive(pid):
        os.kill(pid, signal.SIGKILL)
        raise AssertionError("concurrent nested cleanup left its target alive")

    crash_ready = root / "crash.ready"
    crash_pid = root / "crash.pid"
    crash_program = """
import os, sys, time
from pathlib import Path
Path(sys.argv[1]).write_text(str(os.getpid()), encoding="utf-8")
Path(sys.argv[2]).write_text("ready", encoding="utf-8")
while True:
    os.write(1, b"x" * 65536)
"""
    crashed = subprocess.Popen(
        [python, wrapper, "30", python, "-c", crash_program, str(crash_pid), str(crash_ready)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        pass_fds=session_fds(),
    )
    deadline = time.monotonic() + 5
    while not crash_ready.exists() and time.monotonic() < deadline:
        time.sleep(0.01)
    assert crash_ready.exists(), "relay parent-death target did not become ready"
    relay_identities = []
    if sys.platform.startswith("linux") and hasattr(os, "pidfd_open"):
        deadline = time.monotonic() + 5
        seen_descendants = {}
        while time.monotonic() < deadline:
            rows = {}
            for entry in Path("/proc").iterdir():
                if not entry.name.isdecimal():
                    continue
                try:
                    stat = (entry / "stat").read_text(encoding="ascii")
                    tail = stat[stat.rfind(") ") + 2:].split()
                    parent = int(tail[1])
                    command = (entry / "cmdline").read_bytes()
                except (OSError, ValueError):
                    continue
                rows[int(entry.name)] = (parent, command)
            descendants = {crashed.pid}
            changed = True
            while changed:
                changed = False
                for pid, (parent, _command) in rows.items():
                    if parent in descendants and pid not in descendants:
                        descendants.add(pid)
                        changed = True
            seen_descendants = {
                pid: rows[pid][1] for pid in descendants if pid != crashed.pid
            }
            relay_pids = [
                pid for pid in descendants
                if pid != crashed.pid and b"--dot-relay-helper-v1" in rows[pid][1]
            ]
            # A relay may exit between the /proc scan above and this open;
            # skip vanished PIDs and let the rescan below re-observe.
            relay_identities = []
            for pid in relay_pids:
                try:
                    relay_identities.append((pid, os.pidfd_open(pid)))
                except ProcessLookupError:
                    continue
            if relay_identities:
                break
            for _pid, pidfd in relay_identities:
                os.close(pidfd)
            relay_identities = []
            time.sleep(0.01)
        assert relay_identities, (
            "wrapper did not publish relay processes",
            seen_descendants,
            crashed.poll(),
        )
    os.kill(crashed.pid, signal.SIGKILL)
    # Target stdout/stderr are internal relay pipes, not the caller's pipes.
    # Killing the wrapper must close the relay liveness writers and make both
    # outer pipes reach EOF even while the deliberately orphaned target lives.
    relay_survived = False
    if relay_identities:
        import select
        deadline = time.monotonic() + 2
        for pid, pidfd in relay_identities:
            remaining = max(0, int((deadline - time.monotonic()) * 1000))
            poller = select.poll()
            poller.register(pidfd, select.POLLIN)
            if not poller.poll(remaining):
                relay_survived = True
                signal.pidfd_send_signal(pidfd, signal.SIGKILL)
            os.close(pidfd)
    crashed.communicate(timeout=3)
    assert crashed.returncode == -signal.SIGKILL
    assert not relay_survived, "blocked output relay survived its supervisor"
    orphan = int(crash_pid.read_text(encoding="utf-8"))
    if alive(orphan):
        try:
            os.killpg(orphan, signal.SIGKILL)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 2
    while alive(orphan) and time.monotonic() < deadline:
        time.sleep(0.01)
    assert not alive(orphan), "relay crash fixture cleanup left its target"

    ignored_launcher = """
import os, signal, sys
signal.signal(signal.SIGCHLD, signal.SIG_IGN)
os.execv(sys.argv[1], [sys.argv[1], sys.argv[2], "2", "sh", "-c", "exit 42"])
"""
    ignored = subprocess.run(
        [python, "-c", ignored_launcher, python, wrapper],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
        pass_fds=session_fds(),
    )
    assert ignored.returncode == 42, (ignored.returncode, ignored.stderr)

    disposition_probe = (
        "import signal,sys;"
        "sys.exit(0 if signal.getsignal(signal.SIGCHLD)==signal.SIG_IGN else 9)"
    )
    ignored_target_launcher = """
import os, signal, sys
signal.signal(signal.SIGCHLD, signal.SIG_IGN)
os.execv(sys.argv[1], [sys.argv[1], sys.argv[2], "2", sys.argv[1], "-c", sys.argv[3]])
"""
    ignored_target = subprocess.run(
        [python, "-c", ignored_target_launcher, python, wrapper, disposition_probe],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
        pass_fds=session_fds(),
    )
    assert ignored_target.returncode == 0, (
        ignored_target.returncode,
        ignored_target.stderr,
    )
