for depth in (1, 2):
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        pid_file = root / "target.pid"
        terms = root / "terms"
        ready = root / "ready"
        command = [
            wrapper,
            "30",
            python,
            "-c",
            program,
            str(pid_file),
            str(terms),
            str(ready),
        ]
        for layer in range(depth):
            command = ["/bin/sh", "-c", shell_wait, f"nested-shell-{layer}", *command]
        child = subprocess.Popen(
            [wrapper, "30", *command],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            pass_fds=session_fds(),
        )
        deadline = time.monotonic() + 5
        while not ready.exists() and time.monotonic() < deadline:
            time.sleep(0.01)
