        os.kill(child.pid, signal.SIGTERM)
        stdout, stderr = child.communicate(timeout=8)
        assert child.returncode == 143, (depth, child.returncode, stdout, stderr)
        assert terms.read_text(encoding="utf-8").splitlines() == [
            str(int(signal.SIGTERM))
        ], (depth, terms.read_text(encoding="utf-8"), stdout, stderr)
        pid = int(pid_file.read_text(encoding="utf-8"))
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            pass
        else:
