#!/usr/bin/env bash

set -euo pipefail

# Trust fixtures must be secure independent of the caller's ambient umask.
umask 077

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"

home=$DOT_TEST_TMP/home
state=$DOT_TEST_TMP/state
mkdir -p "$home"

run_tests() {
  local tests=$1
  shift
  HOME="$home" XDG_STATE_HOME="$state" DOT_BASH="$BASH" \
    DOT_TEST_TESTS_DIR="$tests" DOT_TEST_NO_COLOR=1 \
    "$root/bin/dot" test "$@"
}

timeout_command=$root/lib/dot/public/test-timeout-v1
set +e
"$timeout_command" >/dev/null 2>&1
missing_timeout_status=$?
"$timeout_command" nan true >/dev/null 2>&1
nan_timeout_status=$?
"$timeout_command" 0 true >/dev/null 2>&1
zero_timeout_status=$?
"$timeout_command" -1 true >/dev/null 2>&1
negative_timeout_status=$?
set -e
assert_eq 2 "$missing_timeout_status" 'timeout command requires arguments'
assert_eq 2 "$nan_timeout_status" 'timeout command rejects NaN'
assert_eq 2 "$zero_timeout_status" 'timeout command rejects zero'
assert_eq 2 "$negative_timeout_status" 'timeout command rejects negative values'

timeout_fixture=$DOT_TEST_TMP/timeout-helper
timeout_expired=$timeout_fixture/expired
timeout_descendant_pid=$timeout_fixture/descendant.pid
mkdir -p "$timeout_fixture"
cat >"$timeout_fixture/child.py" <<'PY'
#!/usr/bin/env python3
import os
import signal
import sys
import time
from pathlib import Path

signal.signal(signal.SIGTERM, signal.SIG_IGN)
Path(sys.argv[1]).write_text(str(os.getpid()), encoding="utf-8")
time.sleep(30)
PY
cat >"$timeout_fixture/parent.sh" <<'SUITE'
#!/usr/bin/env bash
trap 'exit 0' TERM
python3 "$DOT_TEST_TIMEOUT_CHILD" "$DOT_TEST_TIMEOUT_DESCENDANT_PID" &
wait
SUITE
chmod 0755 "$timeout_fixture/child.py" "$timeout_fixture/parent.sh"
set +e
DOT_TEST_TIMEOUT_EXPIRED_FILE=$timeout_expired \
  DOT_TEST_TIMEOUT_CHILD=$timeout_fixture/child.py \
  DOT_TEST_TIMEOUT_DESCENDANT_PID=$timeout_descendant_pid \
  "$timeout_command" 1 "$timeout_fixture/parent.sh"
timeout_status=$?
set -e
assert_eq 124 "$timeout_status" 'timeout command reports deadline expiration'
[[ -e $timeout_expired ]] || fail 'timeout command did not publish expiration'
timeout_descendant=$(<"$timeout_descendant_pid")
deadline=$((SECONDS + 5))
while process_is_live "$timeout_descendant" && ((SECONDS < deadline)); do
  sleep 0.05
done
process_is_live "$timeout_descendant" &&
  fail 'timeout command left a TERM-ignoring descendant running'

printf 'stale\n' >"$timeout_expired"
set +e
DOT_TEST_TIMEOUT_EXPIRED_FILE=$timeout_expired \
  "$timeout_command" 5 bash -c 'exit 124'
child_124_status=$?
set -e
assert_eq 124 "$child_124_status" 'timeout command preserves child status 124'
[[ ! -e $timeout_expired ]] ||
  fail 'timeout command retained a stale expiration marker'
# The child shell must receive the parameter expansion literally.
# shellcheck disable=SC2016
DOT_TEST_TIMEOUT_EXPIRED_FILE=$timeout_expired \
  "$timeout_command" 5 bash -c \
  '[[ -z ${DOT_TEST_TIMEOUT_EXPIRED_FILE+x} ]]'

set +e
"$timeout_command" 1 "$timeout_fixture/missing" \
  2>"$timeout_fixture/exec-error"
missing_command_status=$?
set -e
assert_eq 127 "$missing_command_status" \
  'timeout command preserves missing executable status'
assert_eq '' "$(<"$timeout_fixture/exec-error")" \
  'missing executable does not emit a traceback'
: >"$timeout_fixture/non-executable"
chmod 0644 "$timeout_fixture/non-executable"
set +e
"$timeout_command" 1 "$timeout_fixture/non-executable" \
  2>"$timeout_fixture/exec-error"
non_executable_status=$?
set -e
assert_eq 126 "$non_executable_status" \
  'timeout command preserves non-executable status'
assert_eq '' "$(<"$timeout_fixture/exec-error")" \
  'non-executable command does not emit a traceback'

rm -f "$timeout_descendant_pid"
DOT_TEST_TIMEOUT_CHILD=$timeout_fixture/child.py \
  DOT_TEST_TIMEOUT_DESCENDANT_PID=$timeout_descendant_pid \
  "$timeout_command" 30 "$timeout_fixture/parent.sh" &
timeout_call_pid=$!
deadline=$((SECONDS + 5))
while [[ ! -s $timeout_descendant_pid && $SECONDS -lt $deadline ]]; do
  sleep 0.05
done
[[ -s $timeout_descendant_pid ]] ||
  fail 'timeout cancellation fixture did not start'
kill -TERM "$timeout_call_pid"
timeout_cancel_status=0
wait "$timeout_call_pid" || timeout_cancel_status=$?
assert_eq 143 "$timeout_cancel_status" \
  'timeout cancellation preserves signal status'
timeout_descendant=$(<"$timeout_descendant_pid")
deadline=$((SECONDS + 5))
while process_is_live "$timeout_descendant" && ((SECONDS < deadline)); do
  sleep 0.05
done
process_is_live "$timeout_descendant" &&
  fail 'timeout cancellation left a descendant running'

python3 - "$timeout_command" <<'PY'
import importlib.util
import signal
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

loader = SourceFileLoader("dot_timeout", sys.argv[1])
spec = importlib.util.spec_from_loader(loader.name, loader)
assert spec is not None
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


with tempfile.TemporaryDirectory() as temporary:
    proc_root = Path(temporary)
    for pid, name, session in (
        (123, "leader", 123),
        (125, "other", 125),
    ):
        proc_dir = proc_root / str(pid)
        proc_dir.mkdir()
        (proc_dir / "stat").write_bytes(
            f"{pid} ({name}) S 1 2 {session} 0 0 0\n".encode()
        )
    proc_dir = proc_root / "124"
    proc_dir.mkdir()
    (proc_dir / "stat").write_bytes(b"124 (worker \xff (nested)) S 1 2 123 0\n")
    (proc_root / "not-a-pid").mkdir()
    (proc_root / "126").mkdir()
    assert module.list_proc_session_pids(123, proc_root) == [123, 124]

with tempfile.TemporaryDirectory() as temporary:
    proc_root = Path(temporary)
    proc_dir = proc_root / "123"
    proc_dir.mkdir()
    (proc_dir / "stat").write_bytes(b"malformed\n")
    assert module.list_proc_session_pids(123, proc_root) is None

with tempfile.TemporaryDirectory() as temporary:
    proc_root = Path(temporary)
    proc_dir = proc_root / "123"
    proc_dir.mkdir()
    (proc_dir / "stat").write_bytes(b"123 (leader) S 1 2 123 0\n")
    proc_dir = proc_root / "124"
    proc_dir.mkdir()
    (proc_dir / "stat").mkdir()
    assert module.list_proc_session_pids(123, proc_root) is None

assert module.list_proc_session_pids(123, Path("/missing/proc/root")) is None
module.list_proc_session_pids = lambda _session_id: [123, 124]
module.subprocess.run = lambda *_args, **_kwargs: (_ for _ in ()).throw(
    AssertionError("ps should not run when procfs is available")
)
assert module.list_session_pids(123) == [123, 124]
module.list_proc_session_pids = lambda _session_id: None


class PsResult:
    stdout = "123\n124\n125\n"


def run_ps(argv, **_kwargs):
    assert argv == ["ps", "-A", "-o", "pid="]
    return PsResult()


module.subprocess.run = run_ps
module.os.getsid = lambda pid: 123 if pid in (123, 124) else 125
assert module.list_session_pids(123) == [123, 124]


def timeout_ps(argv, **kwargs):
    assert argv == ["ps", "-A", "-o", "pid="]
    raise subprocess.TimeoutExpired(argv, kwargs["timeout"])


module.subprocess.run = timeout_ps
assert module.list_session_pids(123) is None


class Process:
    pid = 123
    waited = False

    def poll(self):
        return None

    def wait(self):
        self.waited = True


process = Process()
module.process = process
module.time.sleep = lambda _: None
module.list_session_pids = lambda _session_id: []
signals = []


def killpg(_pid, signum):
    signals.append(signum)
    if signum == signal.SIGKILL:
        raise PermissionError


module.os.killpg = killpg
module.stop_process_group(signal.SIGTERM)
assert process.waited
assert signals == [signal.SIGTERM, signal.SIGKILL]

process.poll = lambda: 0
signals.clear()
module.list_session_pids = lambda _session_id: None
module.stop_process_group(signal.SIGTERM)
assert signals == []
PY

