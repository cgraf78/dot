import array
import errno
import os
import socket
import struct
import threading
import time
import types
from importlib.machinery import SourceFileLoader

loader = SourceFileLoader("dot_timeout_nested_registration", __import__("sys").argv[1])
spec = importlib.util.spec_from_loader(loader.name, loader)
assert spec is not None
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)

reader, writer = module.protocol_socketpair(module.socket.SOCK_DGRAM)
module.control_reader = reader
module.process = types.SimpleNamespace(pid=os.getpid())
tokens = [f"{index:064x}" for index in range(64)]
registrations = []
failure = []

def publish_all():
    try:
        for index, token in enumerate(tokens):
            started = time.monotonic()
