    for key in (
        "DOT_OWNED_SESSION_LEASE_FDS_V1",
        "DOT_OWNED_SESSION_CONTROL_FDS_V1",
    ):
        for field in os.environ.get(key, "").split(":"):
            if not field.isdecimal():
                continue
            try:
                os.fstat(int(field))
            except OSError:
                continue
