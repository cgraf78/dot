wrapper = sys.argv[1]
python = sys.argv[2]
shell_wait = '"$@"; status=$?; exit "$status"'
program = r'''
import os, signal, sys, time
from pathlib import Path
def term(signum, _frame):
    with open(sys.argv[2], "a", encoding="utf-8") as output:
        output.write(f"{signum}\n")
