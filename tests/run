#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
provider_test_home=${HOME:?HOME must be set}
outer_result_file=${DOT_TEST_RESULT_FILE:-}
outer_reporter=${DOT_TEST_REPORTER:-}
if [[ -n $outer_result_file ]]; then
  outer_jobs=${DOT_TEST_REQUESTED_JOBS:-}
else
  outer_jobs=${DOT_TEST_JOBS:-}
fi

# The built-in suite may itself be launched by `dot test` from a client
# worktree. Provider tests create their own HOME and runner fixtures, so outer
# coordinator metadata must not redirect those nested Dot invocations back to
# the client under test.
unset DOT_BASE_TOPOLOGY DOT_CLIENT_GIT_DIR DOT_CONFIG_VERSION
unset DOT_DEPENDENCY_PROVIDER DOT_EXTENSION_API DOT_EXTENSIONS_DIR
unset DOT_SHDEPS_UPDATE_POLICY
unset DOT_TEST DOT_TEST_DOT_ROOT DOT_TEST_HOST_HOME DOT_TEST_JOBS
unset DOT_TEST_INCLUDE_PROVIDER
unset DOT_TEST_PARALLEL DOT_TEST_REPORTER DOT_TEST_RESULT_FILE
unset DOT_TEST_REQUESTED_JOBS
unset DOT_TEST_SOURCE_HOME DOT_TEST_STYLE DOT_TEST_SUITE_TIMEOUT_SECONDS
unset DOT_TEST_SYSTEM_GIT DOT_TEST_TESTS_DIR DOT_TEST_TIMEOUT

wrapper_base=${TMPDIR:-/tmp}
wrapper_base=${wrapper_base%/}
[[ -n $wrapper_base ]] || wrapper_base=/
wrapper_root=$(umask 077 &&
  mktemp -d "$wrapper_base/dot-provider-tests.XXXXXXXX")
trap 'rm -rf -- "$wrapper_root"' EXIT
coordinator_home=$wrapper_root/home
mkdir -m 700 "$coordinator_home"

# The suites run with a private global git config and no system config (see
# run_env below). Carry over only the host's safe.directory entries: CI
# containers trust the checkout that way, and suites that read the real
# checkout (provenance-test) otherwise fail with "dubious ownership".
git_global_config=$wrapper_root/gitconfig
: >"$git_global_config"
while IFS= read -r safe_dir; do
  git config --file "$git_global_config" --add safe.directory "$safe_dir"
done < <(git config --get-all safe.directory 2>/dev/null || true)

# Git state inherited from the caller reaches every fixture repository the
# suites build: an outer hook's GIT_DIR/GIT_INDEX_FILE redirects fixture
# commands at the caller's repository, exported GIT_CONFIG_COUNT or
# GIT_CONFIG_PARAMETERS entries outrank the private global config below, and
# a template directory or format default changes every `git init`. Suites
# that need any of these set them explicitly. Keep in step with the Rust
# fixture list in test-support/src/git.rs. This runs after the safe.directory
# harvest above, which may still depend on the caller's config injection.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE
unset GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_CONFIG_SYSTEM
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE
unset GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE
unset GIT_TEMPLATE_DIR GIT_DEFAULT_HASH GIT_DEFAULT_REF_FORMAT
unset GIT_ALLOW_PROTOCOL GIT_PROTOCOL_FROM_USER GIT_ATTR_SOURCE
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS
unset GIT_ICASE_PATHSPECS

for test_file in "$root"/tests/*-test; do
  [[ -f "$test_file" && -x "$test_file" ]] || continue
  cp "$root/tests/provider-suite-wrapper" \
    "$wrapper_root/${test_file##*/}"
done

run_env=(
  env
  "HOME=$coordinator_home"
  "XDG_CACHE_HOME=$coordinator_home/.cache"
  "XDG_CONFIG_HOME=$coordinator_home/.config"
  "XDG_DATA_HOME=$coordinator_home/.local/share"
  "XDG_STATE_HOME=$coordinator_home/.local/state"
  "DOT_PROVIDER_TEST_HOME=$provider_test_home"
  "DOT_PROVIDER_TEST_ROOT=$root/tests"
  "DOT_TEST_TESTS_DIR=$wrapper_root"
  # HOME and XDG_CONFIG_HOME above already hide ~/.gitconfig, but an
  # inherited GIT_CONFIG_GLOBAL and the host's system config still
  # reach every git the suites run (a global core.hooksPath commit
  # gate, commit signing, or a commit template can then fail or
  # change fixtures). Suites needing config set it explicitly.
  "GIT_CONFIG_GLOBAL=$git_global_config"
  "GIT_CONFIG_NOSYSTEM=1"
  "GIT_ATTR_NOSYSTEM=1"
)
if [[ -n $outer_jobs ]]; then
  run_env+=("DOT_TEST_JOBS=$outer_jobs")
fi

status=0
(
  cd "$root"
  "${run_env[@]}" "$root/bin/dot" test
) || status=$?
if [[ -n $outer_result_file ]]; then
  if [[ $status -eq 0 ]]; then
    DOT_TEST_RESULT_FILE=$outer_result_file \
      "${outer_reporter:?DOT_TEST_REPORTER is required}" complete 1 0
  else
    DOT_TEST_RESULT_FILE=$outer_result_file \
      "${outer_reporter:?DOT_TEST_REPORTER is required}" complete 0 1
  fi
fi
exit "$status"
