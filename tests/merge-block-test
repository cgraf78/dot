#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"
# shellcheck source=../lib/dot/temp.sh
. "$root/lib/dot/temp.sh"
# shellcheck source=../lib/dot/merge-block.sh
. "$root/lib/dot/merge-block.sh"

compare_left=$DOT_TEST_TMP/compare-left
compare_right=$DOT_TEST_TMP/compare-right
ambient_repo=$DOT_TEST_TMP/ambient-git
ambient_config=$DOT_TEST_TMP/ambient.gitconfig
different_owner_bin=$DOT_TEST_TMP/different-owner-bin
different_owner_marker=$DOT_TEST_TMP/different-owner-invoked
DOT_TEST_REAL_GIT=$(type -P git)
printf 'same\0bytes\n' >"$compare_left"
printf 'same\0bytes\n' >"$compare_right"
git init -q --object-format=sha256 "$ambient_repo"
cat >"$ambient_config" <<'CONFIG'
[init]
  defaultBranch = ambient
CONFIG
mkdir "$different_owner_bin"
cat >"$different_owner_bin/git" <<'GIT'
#!/usr/bin/env bash
safe=false
source_repo=false
previous=
printf 'invoked\n' >"$DOT_TEST_GIT_INVOKED"
for argument in "$@"; do
  if [[ $previous == -c &&
    $argument == "safe.directory=$DOT_TEST_EXPECTED_SAFE_ROOT" ]]; then
    safe=true
  fi
  if [[ $previous == -C && $argument == "$DOT_TEST_EXPECTED_SAFE_ROOT" ]]; then
    source_repo=true
  fi
  previous=$argument
done
if $source_repo && ! $safe; then
  printf 'fatal: simulated dubious ownership in repository\n' >&2
  exit 128
fi
exec "$DOT_TEST_REAL_GIT" "$@"
GIT
chmod 0755 "$different_owner_bin/git"

with_hostile_git_selectors() (
  # Container checkouts can be owned by the host runner rather than the user
  # inside the container. GitHub registers the exact workspace as safe, but
  # the engine's isolated Git boundary must not depend on ambient global config.
  export DOT_SOURCE_ROOT=$root
  export DOT_TEST_REAL_GIT DOT_TEST_EXPECTED_SAFE_ROOT=$root
  export DOT_TEST_GIT_INVOKED=$different_owner_marker
  export GIT_OBJECT_DIRECTORY=/definitely/missing
  export GIT_ALTERNATE_OBJECT_DIRECTORIES=/definitely/missing
  export GIT_INDEX_FILE=/definitely/missing
  # shellcheck disable=SC2031 # Nested sanitized-Git subshells intentionally unset this hostile fixture value.
  export GIT_CONFIG_GLOBAL=$ambient_config
  export GIT_CONFIG_SYSTEM=$ambient_config
  export GIT_CONFIG_COUNT=1
  export GIT_CONFIG_KEY_0=init.defaultBranch
  export GIT_CONFIG_VALUE_0=ambient-count
  # shellcheck disable=SC2031 # Nested sanitized-Git subshells intentionally unset this hostile fixture value.
  export GIT_CONFIG_NOSYSTEM=0
  export GIT_DEFAULT_HASH=sha256
  PATH=$different_owner_bin:$PATH "$@"
)

set +e
DOT_TEST_REAL_GIT=$DOT_TEST_REAL_GIT \
  DOT_TEST_EXPECTED_SAFE_ROOT=$root \
  DOT_TEST_GIT_INVOKED=$different_owner_marker \
  "$different_owner_bin/git" -C "$root" rev-parse HEAD >/dev/null 2>&1
unprotected_revision_status=$?
rm -f "$different_owner_marker"
with_hostile_git_selectors _dot_files_equal "$compare_left" "$compare_right"
hostile_files_status=$?
with_hostile_git_selectors _dot_stdin_matches_file "$compare_right" <"$compare_left"
hostile_stdin_status=$?
with_hostile_git_selectors _dot_source_git rev-parse HEAD >/dev/null
hostile_revision_status=$?
set -e
assert_eq 128 "$unprotected_revision_status" \
  'different-owner fixture rejects an unprotected source Git command'
[[ -f $different_owner_marker ]] ||
  fail 'different-owner fixture did not intercept source Git commands'
assert_eq 'file=0 stdin=0 revision=0' \
  "file=$hostile_files_status stdin=$hostile_stdin_status revision=$hostile_revision_status" \
  'source Git ignores ambient selectors and missing global safe-directory state'

engine_git_dir=$(git -C "$root" rev-parse --absolute-git-dir)
sha1_hash=$(printf 'format probe' |
  GIT_DIR=$ambient_repo/.git GIT_WORK_TREE=$ambient_repo \
    DOT_SOURCE_ROOT=$root _dot_hash_object --stdin)
sha256_hash=$(printf 'format probe' |
  GIT_DIR=$engine_git_dir GIT_WORK_TREE=$root \
    DOT_SOURCE_ROOT=$ambient_repo _dot_hash_object --stdin)
[[ $sha1_hash =~ ^[0-9a-f]{40}$ ]] || fail 'content hash did not use SHA-1 repository format'
[[ $sha256_hash =~ ^[0-9a-f]{64}$ ]] || fail 'content hash did not use SHA-256 repository format'

dot_body=$'  generated\n# vim: set ft=conf\n# -*- mode: conf -*-\n'
block=$(_mb_build '# dot-managed:example' '/source/example' "$dot_body")
assert_contains '# dot-managed:example begin' "$block" 'managed block begin marker'
assert_contains '# source: /source/example' "$block" 'managed block source marker'
assert_contains generated "$block" 'managed block body'
[[ $block != *'vim:'* && $block != *'-*- '* ]] ||
  fail 'managed block retained editor modelines'

destination=$DOT_TEST_TMP/config/output
mkdir -p "${destination%/*}"
cat >"$destination" <<'EOF'
manual first

# dot-managed:family:old begin
# DO NOT EDIT: changes will be overwritten by dot update
# source: /source/old
old generated
# dot-managed:family:old end

manual last
EOF
first=$(_mb_build '# dot-managed:family:new' '/source/new' 'new generated')
second=$(_mb_build '# dot-managed:family:second' '/source/second' 'second generated')
_mb_merge_family "$destination" '# dot-managed:family:' "$first" "$second"
content=$(<"$destination")
assert_contains 'manual first' "$content" 'family merge preserves leading manual content'
assert_contains 'manual last' "$content" 'family merge preserves trailing manual content'
[[ $content != *'old generated'* ]] || fail 'family merge retained stale generated block'
assert_contains 'new generated' "$content" 'family merge publishes replacement block'
assert_contains 'second generated' "$content" 'family merge publishes every current block'
mode=$(stat -c '%a' "$destination" 2>/dev/null || stat -f '%Lp' "$destination")
assert_eq 600 "$mode" 'managed output is private'

# Minimal images provide Git and awk but may omit `cmp` or BusyBox `cat -s`.
# Make the unchanged-output path prove it stays on that shared baseline.
real_cat=$(type -P cat)
minimal_bin=$DOT_TEST_TMP/minimal-bin
mkdir "$minimal_bin"
cat >"$minimal_bin/cmp" <<'CMP'
#!/usr/bin/env bash
printf 'managed block invoked unavailable cmp\n' >&2
exit 127
CMP
cat >"$minimal_bin/cat" <<'CAT'
#!/usr/bin/env bash
if [[ ${1:-} == -s ]]; then
  printf 'managed block invoked unavailable cat -s\n' >&2
  exit 127
fi
exec "$DOT_TEST_REAL_CAT" "$@"
CAT
chmod 0755 "$minimal_bin/cmp" "$minimal_bin/cat"
saved_path=$PATH
export DOT_TEST_REAL_CAT=$real_cat
PATH=$minimal_bin:$PATH
inode_before=$(stat -c '%i' "$destination" 2>/dev/null || stat -f '%i' "$destination")
_mb_merge_family "$destination" '# dot-managed:family:' "$first" "$second"
inode_after=$(stat -c '%i' "$destination" 2>/dev/null || stat -f '%i' "$destination")
PATH=$saved_path
unset DOT_TEST_REAL_CAT
assert_eq "$inode_before" "$inode_after" 'unchanged managed output keeps its inode'

foreign_dir=$DOT_TEST_TMP/foreign-directory
mkdir "$foreign_dir"
set +e
_mb_merge "$foreign_dir" "$first" >/dev/null 2>&1
foreign_status=$?
set -e
assert_eq 1 "$foreign_status" 'managed block refuses a directory destination'
entries=$(find "$foreign_dir" -mindepth 1 -maxdepth 1 -print -quit)
assert_eq '' "$entries" 'managed block does not nest a staged file in a directory'

printf 'merge-block-test: ok\n'
