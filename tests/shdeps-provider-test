#!/usr/bin/env bash

# The provider coordinator deliberately resolves these fixture functions and
# dynamically scoped variables at runtime. ShellCheck cannot see those calls or
# distinguish the independent subshell environments used by each scenario.
# shellcheck disable=SC2030,SC2031,SC2034,SC2329
set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"

# Load the provider through the same public XDG and temporary-file helpers used
# by the runtime. Update dependencies are deliberately resolved at call time,
# which lets this fixture replace only the external Shdeps operation.
# shellcheck source=../lib/dot/public/xdg.sh
. "$root/lib/dot/public/xdg.sh"
# shellcheck source=../lib/dot/log.sh
. "$root/lib/dot/log.sh"
# shellcheck source=../lib/dot/progress-ui.sh
. "$root/lib/dot/progress-ui.sh"
# shellcheck source=../lib/dot/resources.sh
. "$root/lib/dot/resources.sh"
# shellcheck source=../lib/dot/temp.sh
. "$root/lib/dot/temp.sh"
# shellcheck source=../lib/dot/providers/shdeps.sh
. "$root/lib/dot/providers/shdeps.sh"
# shellcheck source=../lib/dot/update.sh
. "$root/lib/dot/update.sh"
# shellcheck source=../lib/dot/providers/shdeps-ui.sh
. "$root/lib/dot/providers/shdeps-ui.sh"

_warn() { printf '%s\n' "$*" >&2; }

provider_home=$DOT_TEST_TMP/provider-home
provider_state=$DOT_TEST_TMP/provider-state
revision_file=$DOT_TEST_TMP/provider-revision
merge_marker=$DOT_TEST_TMP/provider-merge-ran
double_output=$DOT_TEST_TMP/provider-double-output
before_revision=1111111111111111111111111111111111111111
after_revision=2222222222222222222222222222222222222222
mkdir -p "$provider_home"
printf '%s\n' "$before_revision" >"$revision_file"

source_revision=$(git -C "$root" rev-parse HEAD)
active_revision=$(
  DOT_SOURCE_ROOT=$root GIT_TEST_ASSUME_DIFFERENT_OWNER=1 \
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
    _dot_active_revision
)
assert_eq "$source_revision" "$active_revision" \
  'provider reads the selected source revision under dubious ownership'

env_probe=$(
  HOME=$provider_home XDG_CONFIG_HOME='' DOT_FORCE=1 DOT_QUIET=1 \
    SHDEPS_INSTALL_DIR='' SHDEPS_BIN_DIR='' SHDEPS_GIT_DEV_DIR='' \
    bash --noprofile --norc -c '
      set -euo pipefail
      . "$1/lib/dot/public/xdg.sh"
      . "$1/lib/dot/providers/shdeps.sh"
      _dot_shdeps_configure_env
      printf "force=%s quiet=%s config=%s\n" \
        "${SHDEPS_FORCE:-0}" "${SHDEPS_QUIET:-0}" "$SHDEPS_CONF_DIR"
    ' -- "$root"
)
assert_eq "force=1 quiet=1 config=$provider_home/.config/shdeps" "$env_probe" \
  'provider forwards force and quiet through resolved XDG config'

jobs_probe=$(
  DOT_UPDATE_JOBS=7 bash --noprofile --norc -c '
    set -euo pipefail
    . "$1/lib/dot/update.sh"
    _dot_update_prepare_shdeps_jobs
    printf "default=%s\n" "$SHDEPS_JOBS"
    SHDEPS_JOBS=3
    _dot_update_prepare_shdeps_jobs
    printf "explicit=%s\n" "$SHDEPS_JOBS"
  ' -- "$root"
)
assert_eq $'default=7\nexplicit=3' "$jobs_probe" \
  'provider job count inherits update policy without overriding an explicit value'

option_probe=$(
  DOT_TEST_ROOT=$root bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_TEST_ROOT/lib/dot/update.sh"
    _preflight_local_overlays() { :; }
    dot_config_load() { :; }
    _ui_begin() { :; }
    _is_worktree_dirty() { return 1; }
    _run_pre_sync_extensions() { :; }
    _dot_update_sync_repos() { printf "sync-args="; printf "<%s>" "$@"; printf "\n"; }
    _dot_update_finalize() {
      printf "quiet=%s shdeps_quiet=%s force=%s shdeps_force=%s\n" \
        "${DOT_QUIET:-0}" "${SHDEPS_QUIET:-0}" \
        "${DOT_FORCE:-0}" "${SHDEPS_FORCE:-0}"
    }
    _dot_update --cron --force passthrough
  '
)
assert_eq $'sync-args=<passthrough>\nquiet=1 shdeps_quiet=1 force=1 shdeps_force=1' \
  "$option_probe" 'cron and force options reach provider orchestration'

# A successful repository sync can replace the client configuration. Provider
# selection in this same invocation must use the newly pulled policy rather
# than the value loaded by main before the pull began.
policy_sync_home=$DOT_TEST_TMP/provider-policy-sync-home
policy_sync_config=$policy_sync_home/.config/dot/config
mkdir -p "${policy_sync_config%/*}"

policy_transition() (
  local before=$1 after=$2
  unset DOT_SHDEPS_UPDATE_POLICY SHDEPS_FORCE SHDEPS_LIB
  # shellcheck source=../lib/dot/config.sh
  . "$root/lib/dot/config.sh"
  HOME=$policy_sync_home
  export HOME
  printf 'version=1\ndependency_provider=shdeps\nshdeps_update_policy=%s\n' \
    "$before" >"$policy_sync_config"
  dot_config_load

  _preflight_local_overlays() { :; }
  _ui_begin() { :; }
  _run_pre_sync_extensions() { :; }
  _dot_update_sync_repos() {
    printf 'version=1\ndependency_provider=shdeps\nshdeps_update_policy=%s\n' \
      "$after" >"$policy_sync_config"
  }
  _dot_update_finalize() {
    _dot_shdeps_configure_env
    printf 'policy=%s force=%s\n' \
      "$DOT_SHDEPS_UPDATE_POLICY" "${SHDEPS_FORCE:-unset}"
  }

  _dot_update
)

assert_eq 'policy=latest force=1' "$(policy_transition pinned latest)" \
  'repository sync applies pinned-to-latest policy before provider execution'
assert_eq 'policy=pinned force=unset' "$(policy_transition latest pinned)" \
  'repository sync applies latest-to-pinned policy before provider execution'

invalid_policy_finalize=$DOT_TEST_TMP/provider-invalid-policy-finalize
invalid_policy_status=0
(
  unset DOT_SHDEPS_UPDATE_POLICY SHDEPS_FORCE SHDEPS_LIB
  # shellcheck source=../lib/dot/config.sh
  . "$root/lib/dot/config.sh"
  HOME=$policy_sync_home
  export HOME
  printf 'version=1\nshdeps_update_policy=pinned\n' >"$policy_sync_config"
  dot_config_load

  _preflight_local_overlays() { :; }
  _ui_begin() { :; }
  _run_pre_sync_extensions() { :; }
  _dot_update_sync_repos() {
    printf 'version=1\nshdeps_update_policy=invalid\n' >"$policy_sync_config"
  }
  _dot_update_finalize() { : >"$invalid_policy_finalize"; }

  _dot_update
) >/dev/null 2>&1 || invalid_policy_status=$?
assert_eq 1 "$invalid_policy_status" \
  'invalid policy pulled during repository sync fails the update'
[[ ! -e $invalid_policy_finalize ]] ||
  fail 'invalid pulled policy reached provider finalization'

# Keep a compact characterization of the real Shdeps progress adapter here.
# These cases protect user-visible recovery detail and the two synchronization
# boundaries that are easiest to lose when the provider UI is refactored.
(
  DOT_VERBOSE=0
  DOT_QUIET=0
  DOT_UPDATE_SUBPHASE_THRESHOLD_MS=0
  _shdeps_ui_reset
  _handle_shdeps_event \
    '{"event":"item","group":"github-repos","status":"warning","name":"cgraf78/cmdblocks","detail":"pull failed (no fast-forward; local clone)"}'
  _handle_shdeps_event \
    '{"event":"group_summary","group":"github-repos","label":"GitHub","status":"warning","changed":0,"warnings":1,"current":4,"skipped":0,"failed":0,"elapsed_ms":900}'
  _handle_shdeps_event \
    '{"event":"summary","status":"warning","changed":0,"warnings":1,"current":4,"skipped":0,"failed":0}'
  warning_output=$(_shdeps_print_group_summaries)
  assert_contains 'GitHub: 1 warning, 4 current' "$warning_output" \
    'provider UI retains warning count'
  assert_contains 'warning  cgraf78/cmdblocks' "$warning_output" \
    'provider UI names warning dependency'
  assert_contains 'pull failed (no fast-forward; local clone)' "$warning_output" \
    'provider UI retains actionable warning detail'
  assert_eq '1 warning, 4 current' "$DOT_UI_SHDEPS_SUMMARY" \
    'provider UI retains aggregate warning count'

  _shdeps_ui_reset
  DOT_UI_LIVE_ACTIVE=1
  prompt_output=$(
    printf '[sudo] password for fixture-user:'
    _handle_shdeps_event \
      '{"event":"prompt","status":"running","detail":"waiting for sudo authentication"}'
    printf '\nactive=%s' "$DOT_UI_SHDEPS_PROMPT_ACTIVE"
  )
  assert_contains '[sudo] password for fixture-user:' "$prompt_output" \
    'provider UI prompt fixture uses a synthetic identity'
  assert_contains 'active=1' "$prompt_output" \
    'provider UI pauses redraw for an interactive prompt'
  [[ "$prompt_output" != *$'\r\033[K'* ]] ||
    fail 'provider UI cleared an interactive prompt'

  # The producer writes this summary without a trailing newline. Its explicit
  # completion marker must still share and terminate the FIFO record without
  # falling back to timeout-based process polling.
  # shellcheck disable=SC2329  # _run_shdeps_update_ui invokes this fixture.
  shdeps_update() {
    printf '%s' \
      '{"event":"summary","status":"ok","changed":0,"current":0,"skipped":0,"failed":0}'
  }
  eval "$(declare -f _shdeps_update_finished |
    sed '1s/_shdeps_update_finished/_original_shdeps_update_finished/')"
  completion_poll_log=$DOT_TEST_TMP/provider-completion-poll
  : >"$completion_poll_log"
  # shellcheck disable=SC2329  # _run_shdeps_update_ui invokes this seam.
  _shdeps_update_finished() {
    printf 'polled\n' >>"$completion_poll_log"
    _original_shdeps_update_finished "$@"
  }
  DOT_UI_TICK_SECONDS=2
  _run_shdeps_update_ui >/dev/null 2>&1
  assert_eq '' "$(<"$completion_poll_log")" \
    'provider UI consumes normal completion marker without timeout polling'
)

# Verbose CI is non-interactive, so it cannot redraw Dot's live status line.
# Preserve the grouped dependency report at completion while proving real
# Shdeps phase events produce safe newline progress before that report.
(
  DOT_QUIET=0
  DOT_UI_FORCE_LIVE=0
  DOT_UI_TICK_SECONDS=0.01
  _ui_begin 5
  _ui_stage_start Tools 'checking configured dependencies' >/dev/null
  verbose_output_file=$DOT_TEST_TMP/provider-verbose-nonlive-output
  producer_release=$DOT_TEST_TMP/provider-verbose-producer-release

  # shellcheck disable=SC2329  # _run_shdeps_update_ui invokes this fixture.
  shdeps_update() {
    printf '%s\n' \
      '{"event":"phase","group":"github-repos","label":"GitHub","done":1,"total":2,"detail":"https://token@example.invalid/private","secret":"progress-secret-sentinel"}'
    local attempt
    for ((attempt = 0; attempt < 200; attempt++)); do
      [[ -e $producer_release ]] && break
      sleep 0.01
    done
    [[ -e $producer_release ]] || return 2
    printf '%s\n' \
      '{"event":"item","group":"github-repos","status":"changed","name":"cgraf78/agentguard","detail":"updated -- commit 1234567"}' \
      '{"event":"phase","group":"github-repos","label":"GitHub","done":2,"total":2}' \
      '{"event":"group_summary","group":"github-repos","label":"GitHub","status":"changed","changed":1,"warnings":0,"current":1,"skipped":0,"failed":0,"elapsed_ms":1200}' \
      '{"event":"summary","status":"changed","changed":1,"warnings":0,"current":1,"skipped":0,"failed":0}'
  }

  DOT_VERBOSE=1
  _shdeps_ui_reset
  _run_shdeps_update_ui >"$verbose_output_file" &
  verbose_provider_pid=$!
  for _ in {1..100}; do
    grep -Fq '1/2' "$verbose_output_file" 2>/dev/null && break
    sleep 0.01
  done
  if ! grep -Fq '1/2' "$verbose_output_file" 2>/dev/null; then
    : >"$producer_release"
    wait "$verbose_provider_pid" 2>/dev/null || true
    fail 'verbose non-live provider buffered the first phase until completion'
  fi
  : >"$producer_release"
  wait "$verbose_provider_pid"
  verbose_nonlive_output=$(<"$verbose_output_file")
  assert_contains '1/2' "$verbose_nonlive_output" \
    'verbose non-live provider shows the first real phase update'
  assert_contains '2/2' "$verbose_nonlive_output" \
    'verbose non-live provider shows the completed phase update'
  assert_contains 'changed  cgraf78/agentguard' "$verbose_nonlive_output" \
    'verbose non-live provider preserves the grouped final item report'
  case $verbose_nonlive_output in
    *'1/2'*'2/2'*'changed  cgraf78/agentguard'*) ;;
    *) fail 'verbose non-live progress did not precede the grouped final report' ;;
  esac
  [[ $verbose_nonlive_output != *token@example.invalid* &&
    $verbose_nonlive_output != *progress-secret-sentinel* ]] ||
    fail 'verbose non-live progress exposed ignored event fields'
  tick_output=$(_ui_stage_tick)
  assert_eq '' "$tick_output" \
    'verbose non-live provider does not print timer-only ticks'

  DOT_VERBOSE=0
  _shdeps_ui_reset
  default_nonlive_output=$(_run_shdeps_update_ui)
  assert_eq '' "$default_nonlive_output" \
    'default non-live provider output remains unchanged'
)

# FIFO writes are a byte stream, not a record protocol. A timeout may return a
# partial JSONL record with a nonzero status; the next read then begins at the
# suffix. Keep that partial data until its newline arrives so a failed custom
# dependency cannot disappear while its later group summary still renders.
(
  DOT_VERBOSE=0
  DOT_QUIET=0
  DOT_UPDATE_SUBPHASE_THRESHOLD_MS=0
  DOT_UI_TICK_SECONDS=0.01
  prefix_written_marker=$DOT_TEST_TMP/provider-prefix-written
  partial_read_marker=$DOT_TEST_TMP/provider-partial-read
  export DOT_TEST_PREFIX_WRITTEN_MARKER=$prefix_written_marker
  export DOT_TEST_PARTIAL_READ_MARKER=$partial_read_marker
  _shdeps_ui_reset
  _ui_stage_tick() {
    [[ -e $DOT_TEST_PREFIX_WRITTEN_MARKER ]] || return 0
    # `line` is nonempty before the fix and `partial` is nonempty after it.
    # Either proves this timed read consumed the prefix rather than merely
    # racing before the producer wrote it.
    [[ -n ${line:-} || -n ${partial:-} ]] || return 0
    : >"$DOT_TEST_PARTIAL_READ_MARKER"
  }
  shdeps_update() {
    printf '%s' \
      '{"event":"item","group":"custom","status":"failed","name":"cmakelang",'
    : >"$DOT_TEST_PREFIX_WRITTEN_MARKER"
    # Do not release the suffix until the reader's timeout path has run. This
    # distinguishes the real partial-read regression from a merely slow test.
    local attempt
    for ((attempt = 0; attempt < 100; attempt++)); do
      [[ -e $DOT_TEST_PARTIAL_READ_MARKER ]] && break
      sleep 0.01
    done
    [[ -e $DOT_TEST_PARTIAL_READ_MARKER ]] || return 2
    printf '%s\n' \
      '"detail":"custom install failed"}' \
      '{"event":"group_summary","group":"custom","label":"Custom","status":"failed","changed":0,"warnings":0,"current":9,"skipped":0,"failed":1,"elapsed_ms":2400}' \
      '{"event":"summary","status":"failed","changed":0,"warnings":0,"current":89,"skipped":0,"failed":1}'
    return 1
  }
  set +e
  _run_shdeps_update_ui >/dev/null 2>&1
  chunked_status=$?
  set -e
  assert_eq 1 "$chunked_status" 'chunked failed provider update remains nonzero'
  [[ -e $partial_read_marker ]] ||
    fail 'provider UI did not observe the partial FIFO record'
  chunked_output=$(_shdeps_print_group_summaries)
  assert_contains 'failed   cmakelang' "$chunked_output" \
    'provider UI retains a failed item split across FIFO reads'
  assert_contains 'custom install failed' "$chunked_output" \
    'provider UI retains split failed-item detail'
)

download_root=$DOT_TEST_TMP/provider-download-root
download_bin=$DOT_TEST_TMP/provider-download-bin
download_source=$DOT_TEST_TMP/provider-download-installer
download_log=$DOT_TEST_TMP/provider-download-url
mkdir -p "$download_root/support" "$download_bin"
printf '#!/usr/bin/env bash\nprintf "fixture installer\\n"\n' >"$download_source"
chmod 0755 "$download_source"
download_hash=$(_dot_shdeps_sha256 "$download_source")
download_revision=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
printf 'revision=%s\ninstall_sha256=%s\nabi=1\n' \
  "$download_revision" "$download_hash" >"$download_root/support/shdeps.lock"
cat >"$download_bin/curl" <<'CURL'
#!/usr/bin/env bash
set -e
output=''
url=''
while (($#)); do
  case $1 in
    -o) output=$2; shift 2 ;;
    http*) url=$1; shift ;;
    *) shift ;;
  esac
done
cp "$DOT_TEST_DOWNLOAD_SOURCE" "$output"
printf '%s\n' "$url" >"$DOT_TEST_DOWNLOAD_LOG"
CURL
chmod 0755 "$download_bin/curl"
saved_source_root=${DOT_SOURCE_ROOT:-$root}
DOT_SOURCE_ROOT=$download_root
PATH="$download_bin:$PATH" DOT_TEST_DOWNLOAD_SOURCE=$download_source \
  DOT_TEST_DOWNLOAD_LOG=$download_log DOT_SHDEPS_UPDATE_POLICY=latest \
  _dot_shdeps_download_installer
downloaded_installer=$REPLY
assert_files_equal "$download_source" "$downloaded_installer" \
  'pinned provider download changed installer bytes'
assert_eq "https://raw.githubusercontent.com/cgraf78/shdeps/$download_revision/install.sh" \
  "$(<"$download_log")" 'provider download uses immutable reviewed revision'
_dot_cleanup_remove_path "$downloaded_installer"
DOT_SOURCE_ROOT=$saved_source_root

# A provider-driven Dot re-exec must discard only values that Dot derived from
# the prior policy. Otherwise a latest-to-pinned config transition can carry a
# development library and forced freshness into the new pinned process.
reexec_env_root=$DOT_TEST_TMP/provider-reexec-env-root
reexec_derived_lib=$DOT_TEST_TMP/provider-derived/shdeps.sh
mkdir -p "$reexec_env_root/lib/dot" "${reexec_derived_lib%/*}"
: >"$reexec_derived_lib"
cat >"$reexec_env_root/lib/dot/main.sh" <<'SCRIPT'
#!/usr/bin/env bash
printf 'force=%s lib=%s\n' "${SHDEPS_FORCE-unset}" "${SHDEPS_LIB-unset}"
SCRIPT
chmod 0755 "$reexec_env_root/lib/dot/main.sh"

derived_reexec_output=$(
  export DOT_SOURCE_ROOT=$reexec_env_root
  export SHDEPS_FORCE=1 SHDEPS_LIB=$reexec_derived_lib
  DOT_ORIGINAL_ARGV=(update)
  _dot_active_revision() {
    printf '%s\n' 2222222222222222222222222222222222222222
  }
  _dot_provider_maybe_reexec 1111111111111111111111111111111111111111
)
assert_eq 'force=unset lib=unset' "$derived_reexec_output" \
  'provider re-exec drops policy-derived Shdeps environment'

caller_reexec_output=$(
  SHDEPS_FORCE=0 SHDEPS_LIB=/caller/shdeps.sh \
    bash --noprofile --norc -c '
      set -euo pipefail
      . "$1/lib/dot/providers/shdeps.sh"
      export SHDEPS_FORCE=1 SHDEPS_LIB="$3"
      DOT_SOURCE_ROOT=$2
      DOT_ORIGINAL_ARGV=(update)
      _dot_active_revision() {
        printf "%s\n" 2222222222222222222222222222222222222222
      }
      _dot_provider_maybe_reexec 1111111111111111111111111111111111111111
    ' bash "$root" "$reexec_env_root" "$reexec_derived_lib"
)
assert_eq 'force=0 lib=/caller/shdeps.sh' "$caller_reexec_output" \
  'provider re-exec preserves caller-supplied Shdeps environment'

# A guarded second source revision must durably checkpoint the observed
# generation and stop before any consumer merge hook can run.
(
  export HOME=$provider_home XDG_STATE_HOME=$provider_state
  DOT_SOURCE_ROOT=$root
  DOT_DEPENDENCY_PROVIDER=shdeps
  DOT_REEXEC_ONCE=1
  DOT_ORIGINAL_ARGV=(update --force)
  DOT_UI_TOTAL=0

  _dot_active_revision() {
    IFS= read -r REPLY <"$revision_file"
    printf '%s\n' "$REPLY"
  }
  _ensure_repo_config() { :; }
  _link_overlays() { :; }
  _ensure_shdeps() { return 0; }
  shdeps_update() { :; }
  _run_shdeps_update_ui() {
    printf '%s\n' "$after_revision" >"$revision_file"
    DOT_UI_SHDEPS_STATUS=changed
    DOT_UI_SHDEPS_SUMMARY='1 changed'
  }
  _shdeps_print_group_summaries() { :; }
  _run_merges() { : >"$merge_marker"; }
  _base_repo_exists() { return 1; }
  _normalize_filtered() { :; }
  _ui_begin() { :; }
  _ui_stage_start() { :; }
  _ui_stage_finish() { :; }
  _ui_done() { :; }

  set +e
  _dot_update_finalize 0 >"$double_output" 2>&1
  status=$?
  set -e
  printf '%s\n' "$status" >"$DOT_TEST_TMP/provider-double-status"
)

assert_eq 1 "$(<"$DOT_TEST_TMP/provider-double-status")" \
  'guarded second provider update fails'
assert_contains 'dot changed twice during one update' "$(<"$double_output")" \
  'guarded provider update explains recovery'
assert_eq "$after_revision" "$(<"$revision_file")" \
  'provider update ran without an obsolete capability gate'
[[ ! -e $merge_marker ]] || fail 'guarded second provider update ran merge hooks'
checkpoint=$provider_state/dot/provider-reexec-failed
[[ -f $checkpoint && ! -L $checkpoint ]] || fail 'guarded provider update omitted checkpoint'
assert_eq $'cgraf78 dot provider reexec checkpoint v1\nbefore=1111111111111111111111111111111111111111\nafter=2222222222222222222222222222222222222222' \
  "$(<"$checkpoint")" 'provider checkpoint content'
checkpoint_mode=$(stat -c '%a' "$checkpoint" 2>/dev/null || stat -f '%Lp' "$checkpoint")
assert_eq 600 "$checkpoint_mode" 'provider checkpoint mode'

# A fresh invocation validates and consumes the exact checkpoint before normal
# convergence. This makes the record recovery authority instead of an ignored
# warning file that accumulates forever.
recovered_marker=$DOT_TEST_TMP/provider-recovered-merge
(
  export HOME=$provider_home XDG_STATE_HOME=$provider_state
  DOT_SOURCE_ROOT=$root
  DOT_DEPENDENCY_PROVIDER=none
  DOT_UI_TOTAL=0

  _dot_active_revision() { printf '%s\n' "$after_revision"; }
  _ensure_repo_config() { :; }
  _link_overlays() { :; }
  _run_merges() { : >"$recovered_marker"; }
  _base_repo_exists() { return 1; }
  _normalize_filtered() { :; }
  _ui_begin() { :; }
  _ui_stage_start() { :; }
  _ui_stage_finish() { :; }
  _ui_done() { :; }

  _dot_update_finalize 0
)
[[ ! -e $checkpoint && ! -L $checkpoint ]] || fail 'valid provider checkpoint was not consumed'
[[ -f $recovered_marker ]] || fail 'checkpoint recovery did not resume convergence'

# Repository synchronization is the authority boundary for all later dynamic
# client code. A failed repo stage must skip both provider and merge execution.
sync_failed_provider=$DOT_TEST_TMP/provider-sync-failed-tools
sync_failed_merge=$DOT_TEST_TMP/provider-sync-failed-merge
(
  export HOME=$provider_home XDG_STATE_HOME=$provider_state
  DOT_SOURCE_ROOT=$root
  DOT_DEPENDENCY_PROVIDER=shdeps
  DOT_UI_TOTAL=0

  _ensure_repo_config() { :; }
  _link_overlays() { :; }
  _ensure_shdeps() { : >"$sync_failed_provider"; }
  _run_merges() { : >"$sync_failed_merge"; }
  _base_repo_exists() { return 1; }
  _normalize_filtered() { :; }
  _ui_begin() { :; }
  _ui_stage_start() { :; }
  _ui_stage_finish() { :; }
  _ui_done() { :; }

  set +e
  _dot_update_finalize 1
  status=$?
  set -e
  printf '%s\n' "$status" >"$DOT_TEST_TMP/provider-sync-failed-status"
)
assert_eq 1 "$(<"$DOT_TEST_TMP/provider-sync-failed-status")" \
  'repository sync failure remains nonzero'
[[ ! -e $sync_failed_provider ]] ||
  fail 'repository sync failure ran the dependency provider'
[[ ! -e $sync_failed_merge ]] ||
  fail 'repository sync failure ran merge hooks'

# Malformed state must fail closed and remain available for diagnosis. Update
# must not silently discard an unbound source generation and run extensions.
mkdir -p "${checkpoint%/*}"
printf 'malformed\n' >"$checkpoint"
chmod 0600 "$checkpoint"
malformed_merge=$DOT_TEST_TMP/provider-malformed-merge
(
  export HOME=$provider_home XDG_STATE_HOME=$provider_state
  DOT_SOURCE_ROOT=$root
  DOT_DEPENDENCY_PROVIDER=none
  DOT_UI_TOTAL=0

  _dot_active_revision() { printf '%s\n' "$after_revision"; }
  _ensure_repo_config() { :; }
  _link_overlays() { :; }
  _run_merges() { : >"$malformed_merge"; }
  _base_repo_exists() { return 1; }
  _normalize_filtered() { :; }
  _ui_begin() { :; }
  _ui_stage_start() { :; }
  _ui_stage_finish() { :; }
  _ui_done() { :; }

  set +e
  _dot_update_finalize 0 >/dev/null 2>&1
  status=$?
  set -e
  printf '%s\n' "$status" >"$DOT_TEST_TMP/provider-malformed-status"
)
assert_eq 1 "$(<"$DOT_TEST_TMP/provider-malformed-status")" \
  'malformed provider checkpoint fails closed'
[[ -f $checkpoint ]] || fail 'malformed provider checkpoint was discarded'
[[ ! -e $malformed_merge ]] || fail 'malformed provider checkpoint ran merge hooks'

invalid_revision_output=$DOT_TEST_TMP/provider-invalid-revision-output
set +e
(
  HOME=$provider_home
  XDG_STATE_HOME=$provider_state
  DOT_SOURCE_ROOT=$root
  _dot_active_revision() { printf 'not-a-revision\n'; }
  _dot_provider_maybe_reexec "$before_revision"
) >"$invalid_revision_output" 2>&1
invalid_revision_status=$?
set -e
assert_eq 1 "$invalid_revision_status" \
  'provider fails closed when the active revision disappears'
assert_contains 'active dot revision is unavailable after provider update' \
  "$(<"$invalid_revision_output")" \
  'provider explains an invalid post-update checkout'

missing_revision_output=$DOT_TEST_TMP/provider-missing-revision-output
set +e
(
  HOME=$provider_home
  XDG_STATE_HOME=$provider_state
  DOT_SOURCE_ROOT=$root
  _dot_active_revision() { :; }
  _dot_provider_maybe_reexec "$before_revision"
) >"$missing_revision_output" 2>&1
missing_revision_status=$?
set -e
assert_eq 1 "$missing_revision_status" \
  'provider fails closed when the post-update revision is missing'
assert_contains 'active dot revision is unavailable after provider update' \
  "$(<"$missing_revision_output")" \
  'provider explains a missing post-update checkout revision'

# The re-exec target is checkout-relative and argv remains an array. A fake
# Graphviz `dot` first on PATH must never be consulted by this handoff.
reexec_root=$DOT_TEST_TMP/reexec-root
reexec_record=$DOT_TEST_TMP/reexec-record
graphviz_marker=$DOT_TEST_TMP/graphviz-ran
mkdir -p "$reexec_root/lib/dot" "$DOT_TEST_TMP/fake-bin"
cat >"$reexec_root/lib/dot/main.sh" <<'SCRIPT'
#!/usr/bin/env bash
{
  printf 'expected=%s\n' "${DOT_REEXEC_EXPECTED_REVISION:-}"
  printf 'once=%s\n' "${DOT_REEXEC_ONCE:-}"
  printf 'argv='
  printf '<%s>' "$@"
  printf '\n'
} >"$DOT_TEST_REEXEC_RECORD"
SCRIPT
chmod 0755 "$reexec_root/lib/dot/main.sh"
cat >"$DOT_TEST_TMP/fake-bin/dot" <<'SCRIPT'
#!/usr/bin/env bash
: >"$DOT_TEST_GRAPHVIZ_MARKER"
exit 99
SCRIPT
chmod 0755 "$DOT_TEST_TMP/fake-bin/dot"
git -C "$reexec_root" init -q
git -C "$reexec_root" config user.name fixture
git -C "$reexec_root" config user.email fixture@example.invalid
git -C "$reexec_root" add lib/dot/main.sh
git -C "$reexec_root" -c core.hooksPath=/dev/null commit -qm runtime
reexec_revision=$(git -C "$reexec_root" rev-parse HEAD)
(
  export HOME=$provider_home XDG_STATE_HOME=$provider_state
  export DOT_TEST_REEXEC_RECORD=$reexec_record
  export DOT_TEST_GRAPHVIZ_MARKER=$graphviz_marker
  PATH=$DOT_TEST_TMP/fake-bin:$PATH
  export PATH
  DOT_SOURCE_ROOT=$reexec_root
  DOT_ORIGINAL_ARGV=(update --force 'two words')
  unset DOT_REEXEC_ONCE DOT_REEXEC_EXPECTED_REVISION
  _dot_provider_maybe_reexec 0000000000000000000000000000000000000000
)
assert_eq $'expected='"$reexec_revision"$'\nonce=1\nargv=<update><--force><two words>' \
  "$(<"$reexec_record")" 'provider reexec preserves runtime and argv'
[[ ! -e $graphviz_marker ]] || fail 'provider reexec resolved dot through PATH'

# A reviewed development checkout is selected by exact revision and installer
# bytes. Dirtiness outside those executable surfaces remains allowed locally.
provider_fixture=$DOT_TEST_TMP/provider-fixture
dev_root=$DOT_TEST_TMP/dev-root
dev_checkout=$dev_root/shdeps
mkdir -p "$provider_fixture/support" "$dev_checkout"
printf '# fixture installer\n' >"$dev_checkout/install.sh"
printf '# fixture library\n' >"$dev_checkout/shdeps.sh"
git -C "$dev_checkout" init -q
git -C "$dev_checkout" config user.name fixture
git -C "$dev_checkout" config user.email fixture@example.invalid
git -C "$dev_checkout" add install.sh shdeps.sh
git -C "$dev_checkout" -c core.hooksPath=/dev/null commit -qm shdeps
dev_revision=$(git -C "$dev_checkout" rev-parse HEAD)
dev_hash=$(_dot_shdeps_sha256 "$dev_checkout/install.sh")
printf 'revision=%s\ninstall_sha256=%s\nabi=1\n' "$dev_revision" "$dev_hash" \
  >"$provider_fixture/support/shdeps.lock"
printf 'dirty but trusted development note\n' >"$dev_checkout/NOTES"
SHDEPS_LIB=''
DOT_SOURCE_ROOT=$provider_fixture
SHDEPS_GIT_DEV_DIR=$dev_root
HOME=$provider_home
_dot_shdeps_installer
assert_eq "$dev_checkout/install.sh" "$REPLY" 'development provider installer selection'
assert_eq "$dev_checkout/shdeps.sh" "$SHDEPS_LIB" 'development provider library selection'

# Doctor uses the same reviewed installer selection but does not bootstrap or
# mutate it. A sibling/development binary satisfying the pinned ABI is healthy.
mkdir -p "$dev_checkout/target/debug"
cat >"$dev_checkout/target/debug/shdeps" <<'SCRIPT'
#!/usr/bin/env bash
if [[ ${1:-} == __api && ${2:-} == version ]]; then
  printf 'abi:1\n'
  exit 0
fi
exit 2
SCRIPT
chmod 0755 "$dev_checkout/target/debug/shdeps"
# shellcheck source=../lib/dot/doctor/runtime.sh
. "$root/lib/dot/doctor/runtime.sh"
# shellcheck source=../lib/dot/doctor/paths.sh
. "$root/lib/dot/doctor/paths.sh"
# shellcheck source=../lib/dot/doctor/provider.sh
. "$root/lib/dot/doctor/provider.sh"
DOT_DEPENDENCY_PROVIDER=shdeps
provider_doctor_output=$(_dr_check_provider)
assert_contains 'Shdeps installer is reviewed' "$provider_doctor_output" \
  'doctor accepts reviewed development installer'
assert_contains 'Shdeps provider ABI' "$provider_doctor_output" \
  'doctor accepts pinned provider ABI'

# The default policy keeps the immutable revision boundary. An otherwise
# usable development checkout at a newer commit must not become executable
# unless the client explicitly opts into following latest Shdeps.
latest_fixture=$DOT_TEST_TMP/latest-provider-fixture
latest_dev_root=$DOT_TEST_TMP/latest-dev-root
latest_dev=$latest_dev_root/shdeps
latest_installed=$DOT_TEST_TMP/latest-installed
latest_force_marker=$DOT_TEST_TMP/latest-force
latest_curl_marker=$DOT_TEST_TMP/latest-curl
latest_bin=$DOT_TEST_TMP/latest-bin
mkdir -p "$latest_fixture/support" "$latest_dev" "$latest_installed" "$latest_bin"
cat >"$latest_dev/install.sh" <<'SCRIPT'
case ${1:-} in
  --bootstrap)
    printf '%s\n' "${SHDEPS_FORCE:-0}" >"$DOT_TEST_LATEST_FORCE_MARKER"
    _SHDEPSW_BIN=${BASH_SOURCE[0]%/*}/shdeps
    shdeps_update() { :; }
    ;;
esac
SCRIPT
printf '# fixture library\n' >"$latest_dev/shdeps.sh"
cat >"$latest_dev/shdeps" <<'SCRIPT'
#!/usr/bin/env bash
if [[ ${1:-} == __api && ${2:-} == version ]]; then
  printf 'abi:1\n'
  exit 0
fi
exit 2
SCRIPT
chmod 0755 "$latest_dev/shdeps"
git -C "$latest_dev" init -q
git -C "$latest_dev" config user.name fixture
git -C "$latest_dev" config user.email fixture@example.invalid
git -C "$latest_dev" remote add origin https://github.com/cgraf78/shdeps.git
git -C "$latest_dev" add install.sh shdeps.sh shdeps
git -C "$latest_dev" -c core.hooksPath=/dev/null commit -qm pinned
latest_pinned_revision=$(git -C "$latest_dev" rev-parse HEAD)
latest_pinned_hash=$(_dot_shdeps_sha256 "$latest_dev/install.sh")
printf '# newer reviewed checkout installer\n' >>"$latest_dev/install.sh"
printf 'ahead\n' >"$latest_dev/README"
git -C "$latest_dev" add install.sh README
git -C "$latest_dev" -c core.hooksPath=/dev/null commit -qm ahead
latest_revision=$(git -C "$latest_dev" rev-parse HEAD)
# CI environments are allowed to use a collaborative umask. Make this trusted
# checkout fixture satisfy the production ownership/mode contract explicitly
# instead of inheriting platform-specific group-write bits.
chmod 0755 "$latest_dev" "$latest_dev/.git"
chmod 0644 "$latest_dev/install.sh" "$latest_dev/shdeps.sh"
printf 'revision=%s\ninstall_sha256=%s\nabi=1\n' \
  "$latest_pinned_revision" "$latest_pinned_hash" \
  >"$latest_fixture/support/shdeps.lock"
cat >"$latest_bin/curl" <<'SCRIPT'
#!/usr/bin/env bash
: >"$DOT_TEST_LATEST_CURL_MARKER"
exit 1
SCRIPT
chmod 0755 "$latest_bin/curl"

pinned_ahead_result=$(
  unset SHDEPS_LIB
  DOT_SOURCE_ROOT=$latest_fixture
  SHDEPS_GIT_DEV_DIR=$latest_dev_root
  SHDEPS_DIR=$latest_installed
  DOT_SHDEPS_UPDATE_POLICY=pinned
  if _dot_shdeps_installer; then
    printf 'selected\n'
  else
    printf 'rejected\n'
  fi
)
assert_eq rejected "$pinned_ahead_result" \
  'pinned policy rejects an ahead development checkout'

latest_cron_output=$(
  unset SHDEPS_LIB SHDEPS_FORCE DOT_FORCE
  export DOT_SOURCE_ROOT=$latest_fixture
  export SHDEPS_GIT_DEV_DIR=$latest_dev_root
  export SHDEPS_DIR=$latest_installed
  export DOT_SHDEPS_UPDATE_POLICY=latest
  export DOT_TEST_LATEST_FORCE_MARKER=$latest_force_marker
  export DOT_TEST_LATEST_CURL_MARKER=$latest_curl_marker
  PATH="$latest_bin:$PATH"
  export PATH
  OVERLAYS=()
  DOT_DEPENDENCY_PROVIDER=shdeps
  _preflight_local_overlays() { :; }
  dot_config_load() { :; }
  _is_worktree_dirty() { return 1; }
  _run_pre_sync_extensions() { :; }
  _dot_update_sync_repos() { :; }
  _dot_provider_consume_checkpoint() { :; }
  _ensure_repo_config() { :; }
  _link_overlays() { :; }
  _run_shdeps_update_ui() {
    DOT_UI_SHDEPS_STATUS=ok
    DOT_UI_SHDEPS_SUMMARY='dependencies checked'
  }
  _shdeps_print_group_summaries() { :; }
  _dot_active_revision() { printf '%s\n' "$latest_revision"; }
  _dot_provider_maybe_reexec() { :; }
  _run_merges() { :; }
  _base_repo_exists() { return 1; }
  _dot_update --cron
)
assert_eq '' "$latest_cron_output" \
  'latest development checkout cron path remains quiet'
assert_eq 1 "$(<"$latest_force_marker")" \
  'latest development checkout forces Shdeps freshness without dot force'
[[ ! -e $latest_curl_marker ]] ||
  fail 'latest development checkout used the network bootstrap fallback'

cat >"$latest_dev/shdeps" <<'SCRIPT'
#!/usr/bin/env bash
if [[ ${1:-} == __api && ${2:-} == version ]]; then
  printf 'abi:2\n'
  exit 0
fi
exit 2
SCRIPT
chmod 0755 "$latest_dev/shdeps"
latest_abi_result=$(
  unset SHDEPS_LIB SHDEPS_FORCE DOT_FORCE _SHDEPSW_BIN
  export DOT_SOURCE_ROOT=$latest_fixture
  export SHDEPS_GIT_DEV_DIR=$latest_dev_root
  export SHDEPS_DIR=$latest_installed
  export DOT_SHDEPS_UPDATE_POLICY=latest
  export DOT_TEST_LATEST_FORCE_MARKER=$latest_force_marker
  HOME=$provider_home
  if _ensure_shdeps; then
    printf 'accepted\n'
  else
    printf 'rejected\n'
  fi
)
assert_eq rejected "$latest_abi_result" \
  'latest development checkout still enforces the provider ABI'
cat >"$latest_dev/shdeps" <<'SCRIPT'
#!/usr/bin/env bash
if [[ ${1:-} == __api && ${2:-} == version ]]; then
  printf 'abi:1\n'
  exit 0
fi
exit 2
SCRIPT
chmod 0755 "$latest_dev/shdeps"

# Latest mode deliberately trusts the selected development checkout's contents,
# but it must not select an arbitrary checkout merely because that checkout
# occupies the conventional path. Repository identity remains a separate guard.
git -C "$latest_dev" remote set-url origin https://github.com/example/shdeps.git
foreign_latest_result=$(
  unset SHDEPS_LIB
  DOT_SOURCE_ROOT=$latest_fixture
  SHDEPS_GIT_DEV_DIR=$latest_dev_root
  SHDEPS_DIR=$latest_installed
  DOT_SHDEPS_UPDATE_POLICY=latest
  if _dot_shdeps_installer; then
    printf 'selected\n'
  else
    printf 'rejected\n'
  fi
)
assert_eq rejected "$foreign_latest_result" \
  'latest policy rejects a foreign development checkout origin'
git -C "$latest_dev" remote set-url origin https://github.com/cgraf78/shdeps.git

chmod 0775 "$latest_dev"
unsafe_latest_result=$(
  unset SHDEPS_LIB
  DOT_SOURCE_ROOT=$latest_fixture
  SHDEPS_GIT_DEV_DIR=$latest_dev_root
  SHDEPS_DIR=$latest_installed
  DOT_SHDEPS_UPDATE_POLICY=latest
  if _dot_shdeps_installer; then
    printf 'selected\n'
  else
    printf 'rejected\n'
  fi
)
assert_eq rejected "$unsafe_latest_result" \
  'latest policy rejects a group-writable development checkout'
chmod 0755 "$latest_dev"

# Fleet clients commonly have only a managed release install. Latest mode must
# force its bootstrap freshness check even when no development checkout exists.
managed_fixture=$DOT_TEST_TMP/managed-provider-fixture
managed_dev_root=$DOT_TEST_TMP/managed-dev-root
managed_install=$DOT_TEST_TMP/managed-install/shdeps
managed_force_marker=$DOT_TEST_TMP/managed-force
managed_untrusted_marker=$DOT_TEST_TMP/managed-untrusted-dev
mkdir -p "$managed_fixture/support" "$managed_dev_root" "$managed_install"
cat >"$managed_install/install.sh" <<'SCRIPT'
case ${1:-} in
  --bootstrap)
    printf '%s\n' "${SHDEPS_FORCE:-0}" >"$DOT_TEST_MANAGED_FORCE_MARKER"
    if [[ -f $SHDEPS_GIT_DEV_DIR/shdeps/shdeps.sh ]]; then
      : >"$DOT_TEST_MANAGED_UNTRUSTED_MARKER"
    fi
    _SHDEPSW_BIN=${BASH_SOURCE[0]%/*}/shdeps
    shdeps_update() { :; }
    ;;
esac
SCRIPT
printf '# fixture library\n' >"$managed_install/shdeps.sh"
cat >"$managed_install/shdeps" <<'SCRIPT'
#!/usr/bin/env bash
if [[ ${1:-} == __api && ${2:-} == version ]]; then
  printf 'abi:1\n'
  exit 0
fi
exit 2
SCRIPT
chmod 0755 "$managed_install/shdeps"
managed_hash=$(_dot_shdeps_sha256 "$managed_install/install.sh")
printf 'revision=%s\ninstall_sha256=%s\nabi=1\n' \
  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa "$managed_hash" \
  >"$managed_fixture/support/shdeps.lock"
git clone -q "$latest_dev" "$managed_dev_root/shdeps"
(
  unset SHDEPS_LIB SHDEPS_FORCE DOT_FORCE
  export DOT_SOURCE_ROOT=$managed_fixture
  export SHDEPS_GIT_DEV_DIR=$managed_dev_root
  export SHDEPS_DIR=$managed_install
  export DOT_SHDEPS_UPDATE_POLICY=latest
  export DOT_TEST_MANAGED_FORCE_MARKER=$managed_force_marker
  export DOT_TEST_MANAGED_UNTRUSTED_MARKER=$managed_untrusted_marker
  HOME=$provider_home
  _ensure_shdeps
)
assert_eq 1 "$(<"$managed_force_marker")" \
  'latest managed release forces freshness without dot force'
[[ ! -e $managed_untrusted_marker ]] ||
  fail 'managed release bootstrap rediscovered an untrusted development checkout'

printf 'shdeps-provider-test: ok\n'
