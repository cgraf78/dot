#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
manifest=$root/docs/source-provenance-v1.tsv
revisions=$root/docs/source-revisions-v1.tsv
documentation=$root/docs/source-provenance.md
temporary=$(mktemp -d "${TMPDIR:-/tmp}/dot-provenance.XXXXXX")
trap 'rm -rf -- "$temporary"' EXIT

[[ -r $revisions ]] || {
  printf 'provenance-test: missing source revision inventory: %s\n' \
    "$revisions" >&2
  exit 1
}

awk -F '\t' '
  /^#/ { next }
  NF != 2 || $1 !~ /^[a-z][a-z0-9-]*$/ || $2 !~ /^[0-9a-f]{40}$/ { exit 1 }
  seen[$1]++ { exit 1 }
' "$revisions" || {
  printf 'provenance-test: invalid source revision inventory\n' >&2
  exit 1
}

for source_name in dotfiles-v1 dotfiles-v2; do
  dotfiles_revision=$(awk -F '\t' -v source="$source_name" \
    '$1 == source { print $2 }' "$revisions")
  [[ $dotfiles_revision =~ ^[0-9a-f]{40}$ ]] || {
    printf 'provenance-test: missing %s source revision\n' "$source_name" >&2
    exit 1
  }
done

awk -F '\t' '
  /^#/ { next }
  NF != 2 || $1 == "" || $2 == "" { exit 1 }
  seen[$1]++ { exit 1 }
  { print $1 }
' "$manifest" | sort >"$temporary/expected"

git -C "$root" ls-files install.sh bin lib/dot support tests |
  sort >"$temporary/actual"

expected_hash=$(git hash-object --no-filters -- "$temporary/expected")
actual_hash=$(git hash-object --no-filters -- "$temporary/actual")
if [[ $actual_hash != "$expected_hash" ]]; then
  git diff --no-index --no-ext-diff --no-textconv -- \
    "$temporary/expected" "$temporary/actual" >&2 || true
  printf 'provenance-test: source inventory drift\n' >&2
  exit 1
fi

while IFS=$'\t' read -r path origin; do
  [[ $path == \#* ]] && continue
  [[ -e $root/$path || -L $root/$path ]] || {
    printf 'provenance-test: missing tracked path: %s\n' "$path" >&2
    exit 1
  }
  case $origin in
    standalone:new | actions:* | shdeps:*) ;;
    dotfiles:*@dotfiles-v1 | dotfiles:*@dotfiles-v1+standalone | \
      dotfiles:*@dotfiles-v2 | dotfiles:*@dotfiles-v2+standalone)
      ;;
    *)
      printf 'provenance-test: unknown origin for %s: %s\n' "$path" "$origin" >&2
      exit 1
      ;;
  esac
done <"$manifest"

if grep -Eq '[0-9a-f]{40}' "$manifest"; then
  printf 'provenance-test: source revision duplicated in path inventory\n' >&2
  exit 1
fi

grep -Fq 'source-revisions-v1.tsv' "$documentation" || {
  printf 'provenance-test: source revision inventory is undocumented\n' >&2
  exit 1
}

if grep -Eiq 'repository-wide|deny-?list|every generated artifact' "$documentation"; then
  printf 'provenance-test: documentation overstates the manifest checks\n' >&2
  exit 1
fi

printf 'provenance-test: ok\n'
