    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    OVERLAYS=()

    materialize_legacy() {
      local name=$1 phase=$2 hash_git_dir=${3:-}
      local destination=$HOME/$1 target=new-$1
      local expected physical parent_identity record transaction record_line hash
      ln -s old-$name "$destination"
      expected=$(_dot_path_identity "$destination")
      _overlay_destination_context "$destination"
      physical=$OVERLAY_PHYSICAL_DESTINATION
      parent_identity=$OVERLAY_PARENT_IDENTITY
      if [[ -n $hash_git_dir ]]; then
        hash=$(printf "%s" "$destination" |
          GIT_DIR=$hash_git_dir git hash-object --stdin)
        [[ ${#hash} -eq 64 ]]
        record=${DOT_OVERLAY_MANIFEST}.replace.$hash
      else
        _overlay_replacement_record_path "$destination"
        record=$REPLY
      fi
      transaction=${physical%/*}/.${physical##*/}.dot-overlay-replace-v1
      printf -v record_line "%s\t%s\t%s\t%s\t%s\t%s" \
        "$destination" "$physical" "$target" "$expected" \
        "$transaction" "$parent_identity"
      _overlay_write_private_line "$record" "$record_line"
      if [[ $phase != record-only ]]; then
        mkdir "$transaction"
        chmod 0700 "$transaction"
      fi
      case $phase in
        record-only) ;;
        prepared)
          ln -s "$target" "$transaction/next"
          ;;
        parked)
          ln -s "$target" "$transaction/next"
          mv "$physical" "$transaction/previous"
          ;;
        committed)
          mv "$physical" "$transaction/previous"
          ln -s "$target" "$physical"
          ;;
        terminal)
          mv "$physical" "$transaction/previous"
          ln -s "$target" "$physical"
          rm -f "$transaction/previous"
          ;;
      esac
      _overlay_recover_replacements
      [[ ! -e $record && ! -L $record && ! -e $transaction && ! -L $transaction ]]
      case $phase in
        committed | terminal)
          [[ -L $physical && $(readlink "$physical") == "$target" ]]
          ;;
