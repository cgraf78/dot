CHMOD
chmod +x "$replacement_mode_bin/chmod"
set +e
HOME=$replacement_mode_home DOT_SOURCE_ROOT=$root \
  DOT_OVERLAY_MANIFEST=$replacement_mode_state/overlay-links \
  DOT_TEST_REPLACEMENT_MODE_RECORD=$replacement_mode_record \
  DOT_TEST_REPLACEMENT_MODE_CHMOD=$replacement_mode_chmod \
  PATH="$replacement_mode_bin:$PATH" bash --noprofile --norc -c '
    set -euo pipefail
    umask 022
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    OVERLAYS=()
    expected=$(_overlay_replacement_identity "$HOME/value")
    _overlay_publish_link new-managed "$HOME/value" "$expected"
  '
replacement_mode_status=$?
set -e
assert_eq 1 "$replacement_mode_status" \
  'replacement transaction chmod failure aborts publication'
assert_eq 700 "$(<"$replacement_mode_record")" \
  'replacement transaction is private before follow-up chmod'
[[ -L $replacement_mode_home/value &&
  $(readlink "$replacement_mode_home/value") == old-managed ]] ||
  fail 'replacement transaction mode probe changed the authorized destination'

# The durable replacement record must classify and converge every filesystem
# phase independently of the current overlay configuration: preparation rolls
# back, a parked old generation is restored, and a published desired link
# commits by retiring only the exact parked generation.
replacement_recovery_home=$DOT_TEST_TMP/replacement-recovery-home
replacement_recovery_state=$DOT_TEST_TMP/replacement-recovery-state
mkdir -p "$replacement_recovery_home" "$replacement_recovery_state"
HOME=$replacement_recovery_home XDG_STATE_HOME=$replacement_recovery_state \
  DOT_SOURCE_ROOT=$root \
  DOT_OVERLAY_MANIFEST=$replacement_recovery_state/overlay-links \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    OVERLAYS=()

    materialize() {
      local name=$1 phase=$2 destination=$HOME/$1 target=new-$1
      local expected physical parent_identity record transaction record_line
      ln -s old-$name "$destination"
      expected=$(_overlay_replacement_identity "$destination")
      _overlay_destination_context "$destination"
      physical=$OVERLAY_PHYSICAL_DESTINATION
      parent_identity=$OVERLAY_PARENT_IDENTITY
      _overlay_replacement_record_path "$destination"
      record=$REPLY
      transaction=${physical%/*}/.${physical##*/}.dot-overlay-replace-v1
      printf -v record_line "%s\t%s\t%s\t%s\t%s\t%s" \
        "$destination" "$physical" "$target" "$expected" \
        "$transaction" "$parent_identity"
      _overlay_write_private_line "$record" "$record_line"
      mkdir "$transaction"
      chmod 0700 "$transaction"
      case $phase in
        prepared)
          ln -s "$target" "$transaction/next"
          ;;
        parked)
          ln -s "$target" "$transaction/next"
          mv "$physical" "$transaction/previous"
          ;;
        committed)
          mv "$physical" "$transaction/previous"
          ln -s "$target" "$physical"
          ;;
      esac
      _overlay_recover_replacements
      [[ ! -e $record && ! -L $record && ! -e $transaction && ! -L $transaction ]]
      if [[ $phase == committed ]]; then
        [[ -L $physical && $(readlink "$physical") == "$target" ]]
      else
        [[ -L $physical && $(readlink "$physical") == old-$name ]]
      fi
    }

    materialize prepared prepared
    materialize parked parked
    materialize committed committed

    destination=$HOME/malformed
    ln -s old-malformed "$destination"
    expected=$(_overlay_replacement_identity "$destination")
    _overlay_destination_context "$destination"
    physical=$OVERLAY_PHYSICAL_DESTINATION
    parent_identity=$OVERLAY_PARENT_IDENTITY
    _overlay_replacement_record_path "$destination"
    record=$REPLY
    transaction=${physical%/*}/.${physical##*/}.dot-overlay-replace-v1
    printf -v record_line "%s\t%s\t%s\t%s\t%s\t%s" \
      "$destination" "$physical" new-malformed "$expected" \
      "$transaction" "$parent_identity"
    _overlay_write_private_line "$record" "$record_line"
    mkdir "$transaction"
    chmod 0700 "$transaction"
    : >"$transaction/foreign"
    if _overlay_recover_replacements; then
      exit 1
    fi
    [[ -L $destination && $(readlink "$destination") == old-malformed ]]
    [[ -f $record && -d $transaction && -f $transaction/foreign ]]
  '

# Update snapshots run before unstash. They must first recover an interrupted
# per-path replacement, then capture the exact restored live target from the
# installed authority union so a later policy failure can roll it back.
rollback_recovery_home=$DOT_TEST_TMP/rollback-recovery-home
rollback_recovery_state=$DOT_TEST_TMP/rollback-recovery-state
mkdir -p "$rollback_recovery_home" "$rollback_recovery_state"
HOME=$rollback_recovery_home XDG_STATE_HOME=$rollback_recovery_state \
  DOT_SOURCE_ROOT=$root \
  DOT_OVERLAY_MANIFEST=$rollback_recovery_state/overlay-links \
  DOT_OVERLAY_LEGACY_MANIFEST=$rollback_recovery_state/legacy-links \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _overlay_skip_worktree() { return 0; }
    dot_candidate_path_is_reserved() { return 1; }

    destination=$HOME/value
    target=.dotfiles-example/home/value
    ln -s "$target" "$destination"
    printf "value\texample\t%s\n" "$target" >"$DOT_OVERLAY_MANIFEST"
    chmod 0600 "$DOT_OVERLAY_MANIFEST"

    expected=$(_overlay_replacement_identity "$destination")
    _overlay_destination_context "$destination"
    physical=$OVERLAY_PHYSICAL_DESTINATION
    parent_identity=$OVERLAY_PARENT_IDENTITY
    _overlay_replacement_record_path "$destination"
    record=$REPLY
    transaction=${physical%/*}/.${physical##*/}.dot-overlay-replace-v1
    printf -v record_line "%s\t%s\t%s\t%s\t%s\t%s" \
      "$destination" "$physical" replacement-target "$expected" \
      "$transaction" "$parent_identity"
    _overlay_write_private_line "$record" "$record_line"
    mkdir "$transaction"
    chmod 0700 "$transaction"
    ln -s replacement-target "$transaction/next"
    mv "$physical" "$transaction/previous"

    _overlay_snapshot_installed_links
    [[ -L $destination && $(readlink "$destination") == "$target" ]]
    [[ ! -e $record && ! -L $record && ! -e $transaction && ! -L $transaction ]]
    [[ ${DOT_OVERLAY_ROLLBACK_PATHS[*]} == value ]]
    [[ ${DOT_OVERLAY_ROLLBACK_TARGETS[*]} == "$target" ]]
  '

# Overlay-only paths are not tracked by the base repository. If a user replaces
# one after the snapshot, rollback must fail closed rather than treating an
# untracked regular file as a clean base generation and overwriting it.
rollback_untracked_home=$DOT_TEST_TMP/rollback-untracked-home
mkdir -p "$rollback_untracked_home"
HOME=$rollback_untracked_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base\n" >"$HOME/README"
    git -C "$HOME" add README
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    _overlay_destination_outside_local_sources() { return 0; }
    OVERLAYS=()
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-source/home"
    printf "overlay source\n" >"$HOME/.dotfiles-source/home/value"
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)
    printf "USER DATA MUST SURVIVE\n" >"$HOME/value"

    status=0
    _overlay_restore_installed_links || status=$?
    [[ $status -ne 0 ]]
    [[ -f $HOME/value && ! -L $HOME/value ]]
    [[ $(<"$HOME/value") == "USER DATA MUST SURVIVE" ]]
  '

# A failed update may invoke rollback more than once. Once a missing prior
# owner has been replaced by an available active fallback, repeated recovery
# must accept that same fallback as already converged.
rollback_fallback_home=$DOT_TEST_TMP/rollback-fallback-home
mkdir -p "$rollback_fallback_home"
HOME=$rollback_fallback_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base\n" >"$HOME/README"
    git -C "$HOME" add README
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-target/home"
    printf "fallback\n" >"$HOME/.dotfiles-target/home/value"
    ACTIVE_OVERLAYS=("target|$HOME/.dotfiles-target|||false|git")
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)

    _overlay_restore_installed_links
    [[ -L $HOME/value &&
      $(readlink "$HOME/value") == .dotfiles-target/home/value ]]
    _overlay_restore_installed_links
    [[ -L $HOME/value &&
      $(readlink "$HOME/value") == .dotfiles-target/home/value ]]
  '

# If publishing a fallback succeeds but restoring the base index bit fails,
# the next rollback pass must retry the index repair instead of accepting the
# link alone as complete.
rollback_index_retry_home=$DOT_TEST_TMP/rollback-index-retry-home
mkdir -p "$rollback_index_retry_home"
HOME=$rollback_index_retry_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base value\n" >"$HOME/value"
    git -C "$HOME" add value
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    update_index_attempts=0
    _base_git() {
      if [[ $1 == update-index && $2 == --skip-worktree ]]; then
        update_index_attempts=$((update_index_attempts + 1))
        [[ $update_index_attempts -gt 1 ]] || return 1
      fi
      git -C "$HOME" "$@"
    }
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-target/home"
    printf "fallback\n" >"$HOME/.dotfiles-target/home/value"
    ACTIVE_OVERLAYS=("target|$HOME/.dotfiles-target|||false|git")
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)

    status=0
    _overlay_restore_installed_links || status=$?
    [[ $status -ne 0 ]]
    [[ -L $HOME/value &&
      $(readlink "$HOME/value") == .dotfiles-target/home/value ]]
    _overlay_restore_installed_links
    [[ $(git -C "$HOME" ls-files -v -- value) == "S value" ]]
  '

# Eligible overlays that failed active-source validation cannot become
# rollback fallbacks. In particular, a dangling sync=none source must not be
# republished merely because it remained in the eligible set.
rollback_inactive_home=$DOT_TEST_TMP/rollback-inactive-home
mkdir -p "$rollback_inactive_home"
HOME=$rollback_inactive_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base\n" >"$HOME/README"
    git -C "$HOME" add README
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/local-overlay/home"
    ln -s missing "$HOME/local-overlay/home/value"
    OVERLAYS=("local|$HOME/local-overlay|||false|none")
    ACTIVE_OVERLAYS=()
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)

    status=0
    _overlay_restore_installed_links || status=$?
    [[ $status -ne 0 ]]
    [[ ! -e $HOME/value && ! -L $HOME/value ]]
  '

rollback_directory_home=$DOT_TEST_TMP/rollback-directory-home
mkdir -p "$rollback_directory_home"
HOME=$rollback_directory_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base\n" >"$HOME/README"
    git -C "$HOME" add README
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-target/home/value"
    printf "child\n" >"$HOME/.dotfiles-target/home/value/child"
    ACTIVE_OVERLAYS=("target|$HOME/.dotfiles-target|||false|git")
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)

    status=0
    _overlay_restore_installed_links || status=$?
    [[ $status -ne 0 ]]
    [[ ! -e $HOME/value && ! -L $HOME/value ]]
  '

# A former file owner that now exposes a directory cannot satisfy rollback.
# Prefer the clean tracked base version rather than retaining a type-changing
# live symlink that normal overlay inventory would never publish.
rollback_source_directory_home=$DOT_TEST_TMP/rollback-source-directory-home
mkdir -p "$rollback_source_directory_home"
HOME=$rollback_source_directory_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base value\n" >"$HOME/value"
    git -C "$HOME" add value
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    OVERLAYS=()
    ACTIVE_OVERLAYS=()
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-source/home/value"
    printf "child\n" >"$HOME/.dotfiles-source/home/value/child"
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)

    _overlay_restore_installed_links
    [[ -f $HOME/value && ! -L $HOME/value ]]
    [[ $(<"$HOME/value") == "base value" ]]
  '

# Git-tracked symlink payloads are valid overlay leaves even when their own
# referent is absent. Rollback must preserve that file type for both the prior
# owner and an explicitly active fallback.
rollback_dangling_home=$DOT_TEST_TMP/rollback-dangling-home
mkdir -p "$rollback_dangling_home"
HOME=$rollback_dangling_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base\n" >"$HOME/README"
    git -C "$HOME" add README
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    OVERLAYS=()
    ACTIVE_OVERLAYS=()
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-source/home"
    ln -s missing "$HOME/.dotfiles-source/home/value"
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)

    _overlay_restore_installed_links
    [[ -L $HOME/value &&
      $(readlink "$HOME/value") == .dotfiles-source/home/value ]]
  '

rollback_dangling_fallback_home=$DOT_TEST_TMP/rollback-dangling-fallback-home
mkdir -p "$rollback_dangling_fallback_home"
HOME=$rollback_dangling_fallback_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base\n" >"$HOME/README"
    git -C "$HOME" add README
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-target/home"
    ln -s missing "$HOME/.dotfiles-target/home/value"
    ACTIVE_OVERLAYS=("target|$HOME/.dotfiles-target|||false|git")
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(.dotfiles-source/home/value)

    _overlay_restore_installed_links
    [[ -L $HOME/value &&
      $(readlink "$HOME/value") == .dotfiles-target/home/value ]]
  '

# One user-owned conflict must not prevent later independent paths in the
# captured generation from being restored safely.
rollback_bulk_home=$DOT_TEST_TMP/rollback-bulk-home
mkdir -p "$rollback_bulk_home"
HOME=$rollback_bulk_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    git -C "$HOME" init -q
    git -C "$HOME" config user.name fixture
    git -C "$HOME" config user.email fixture@example.invalid
    printf "base\n" >"$HOME/README"
    git -C "$HOME" add README
    git -C "$HOME" -c core.hooksPath=/dev/null commit -qm seed
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _base_git() { git -C "$HOME" "$@"; }
    OVERLAYS=()
    DOT_OVERLAY_MANIFEST="$HOME/.state/manifest"
    DOT_OVERLAY_LEGACY_MANIFEST="$HOME/.state/legacy"
    mkdir -p "$HOME/.state" "$HOME/.dotfiles-source/home"
    printf "managed b\n" >"$HOME/.dotfiles-source/home/b"
    DOT_OVERLAY_ROLLBACK_PATHS=(a b)
    DOT_OVERLAY_ROLLBACK_TARGETS=(
      .dotfiles-source/home/a
      .dotfiles-source/home/b
    )
    printf "USER A\n" >"$HOME/a"

    status=0
    _overlay_restore_installed_links || status=$?
    [[ $status -ne 0 ]]
    [[ -f $HOME/a && ! -L $HOME/a && $(<"$HOME/a") == "USER A" ]]
    [[ -L $HOME/b &&
      $(readlink "$HOME/b") == .dotfiles-source/home/b ]]
  '

# Managed-link adoption must not delete a user replacement that wins a race
# after authorization, including through a swapped parent symlink.
adoption_race_home=$DOT_TEST_TMP/adoption-race-home
mkdir -p "$adoption_race_home"
HOME=$adoption_race_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/pull.sh"
    _warn() { :; }
    DOT_OVERLAY_ROLLBACK_PATHS=(value)
    DOT_OVERLAY_ROLLBACK_TARGETS=(managed-target)
    ln -s managed-target "$HOME/value"
    log=$HOME/pull.log
    printf "%s\n" \
      "error: The following untracked working tree files would be overwritten by checkout:" \
      "        value" \
      "Please move or remove them before you switch branches." >"$log"
    eval "$(declare -f _dot_move_noreplace |
      sed "1s/_dot_move_noreplace/_dot_move_noreplace_original/")"
    _dot_move_noreplace() {
      if [[ $1 == "$HOME/value" && -L $HOME/value ]]; then
        command rm -f -- "$HOME/value"
        printf "USER DATA WON THE RACE\n" >"$HOME/value"
      fi
      _dot_move_noreplace_original "$@"
    }
    status=0
    _backup_pull_conflicts "$log" "$HOME" || status=$?
    [[ $status -ne 0 ]]
    [[ -f $HOME/value && ! -L $HOME/value ]]
    [[ $(<"$HOME/value") == "USER DATA WON THE RACE" ]]
  '

adoption_parent_race_home=$DOT_TEST_TMP/adoption-parent-race-home
mkdir -p "$adoption_parent_race_home/a" "$adoption_parent_race_home/outside"
HOME=$adoption_parent_race_home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
