fixture_repo overlay-base main .config/example/value $'base\n' 100644
base_origin=$REPLY
fixture_home overlay
overlay_home=$REPLY
overlay_state=$DOT_TEST_TMP/overlay-state
run_dot "$overlay_home" "$overlay_state" init --yes "file://$base_origin" >/dev/null
local_overlay=$DOT_TEST_TMP/local-overlay
mkdir -p "$local_overlay/home/.config/example"
printf 'local-overlay\n' >"$local_overlay/home/.config/example/value"
mkdir -p "$overlay_home/.config/dot/overlays.d"
printf 'sync=none\npath=%s\n' "$local_overlay" \
  >"$overlay_home/.config/dot/overlays.d/10-alpha.local.conf"
run_dot "$overlay_home" "$overlay_state" update >/dev/null
[[ -L $overlay_home/.config/example/value ]] || fail 'local overlay did not publish link'
