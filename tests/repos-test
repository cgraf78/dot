#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"
# shellcheck source=lib/repo.sh
. "$root/tests/lib/repo.sh"
# shellcheck source=../lib/dot/platform.sh
. "$root/lib/dot/platform.sh"
DOT_TEST_REAL_MV=$(type -P mv)
export DOT_TEST_REAL_MV

fixture_repo update topic .testrc $'one\n' 100644
origin=$REPLY
fixture_home update
home=$REPLY
state=$DOT_TEST_TMP/update-state
run_dot "$home" "$state" init --yes "file://$origin" >/dev/null
fixture_push update topic .testrc $'two\n' 100644
run_dot "$home" "$state" update >/dev/null
assert_eq two "$(<"$home/.testrc")" 'base update follows configured non-main upstream'
assert_eq false "$(git --git-dir="$home/.dotfiles" config core.fsmonitor)" \
  'base model disables fsmonitor'
assert_eq no "$(git --git-dir="$home/.dotfiles" config status.showUntrackedFiles)" \
  'base model suppresses untracked scan'
assert_eq '' "$(git --git-dir="$home/.dotfiles" config --local --get pull.rebase 2>/dev/null || true)" \
  'base update does not write pull policy'

# A fetch can confirm that the active commit is already the exact upstream
# generation. That result must return current before candidate validation,
# snapshotting, or an empty rebase; those checks only protect a new generation
# that could become visible beneath HOME.
fixture_repo unchanged-base main .testrc $'current\n' 100644
unchanged_base_origin=$REPLY
fixture_home unchanged-base
unchanged_base_home=$REPLY
unchanged_base_state=$DOT_TEST_TMP/unchanged-base-state
unchanged_base_trace=$DOT_TEST_TMP/unchanged-base-trace.json
run_dot "$unchanged_base_home" "$unchanged_base_state" init --yes \
  "file://$unchanged_base_origin" >/dev/null
# The fetch-boundary fixture deliberately forces a real rebase below. Give its
# synthetic client repository an identity instead of inheriting the operator's
# global Git config, which CI intentionally isolates by setting HOME to the
# checkout.
git --git-dir="$unchanged_base_home/.dotfiles" config user.name fixture
git --git-dir="$unchanged_base_home/.dotfiles" config user.email \
  fixture@example.invalid
GIT_TRACE2_EVENT=$unchanged_base_trace \
  run_dot "$unchanged_base_home" "$unchanged_base_state" update >/dev/null
unchanged_base_fetch=$(grep -Fc '"name":"fetch"' "$unchanged_base_trace" || true)
unchanged_base_ls_tree=$(grep -Fc '"name":"ls-tree"' "$unchanged_base_trace" || true)
unchanged_base_rebase=$(grep -Fc '"name":"rebase"' "$unchanged_base_trace" || true)
assert_eq 1 "$unchanged_base_fetch" \
  'unchanged base still fetches before taking the fast path'
assert_eq 0 "$unchanged_base_ls_tree" \
  'unchanged base skips candidate-tree validation after fetch'
assert_eq 0 "$unchanged_base_rebase" \
  'unchanged base skips an empty rebase after fetch'

# Fetch is an external boundary. A direct Git operation can move HEAD while it
# runs even though Dot serializes its own updates, so the equality decision must
# use a fresh HEAD read after fetch rather than a snapshot from before it.
unchanged_base_head=$(git --git-dir="$unchanged_base_home/.dotfiles" rev-parse HEAD)
unchanged_base_tree=$(git --git-dir="$unchanged_base_home/.dotfiles" \
  rev-parse 'HEAD^{tree}')
unchanged_base_moved=$(printf 'out-of-band move\n' |
  git --git-dir="$unchanged_base_home/.dotfiles" \
    -c user.name=fixture -c user.email=fixture@example.invalid \
    commit-tree "$unchanged_base_tree" -p "$unchanged_base_head")
# Advance the remote independently so the fetched generation and the
# out-of-band local commit are siblings. A fresh ancestry check must reject
# the fast path and follow ordinary validation/rebase.
fixture_push unchanged-base main .remote $'remote\n' 100644
unchanged_base_race_bin=$DOT_TEST_TMP/unchanged-base-race-bin
unchanged_base_race_trace=$DOT_TEST_TMP/unchanged-base-race-trace.json
unchanged_base_race_marker=$DOT_TEST_TMP/unchanged-base-race-marker
unchanged_base_real_git=$(type -P git)
mkdir -p "$unchanged_base_race_bin"
cat >"$unchanged_base_race_bin/git" <<'GIT'
#!/usr/bin/env bash
set -e
is_fetch=0
for arg in "$@"; do
  [[ $arg == fetch ]] && is_fetch=1
done
"$DOT_TEST_HEAD_RACE_REAL_GIT" "$@"
status=$?
if [[ $status -eq 0 && $is_fetch -eq 1 && ! -e $DOT_TEST_HEAD_RACE_MARKER ]]; then
  "$DOT_TEST_HEAD_RACE_REAL_GIT" --git-dir="$DOT_TEST_HEAD_RACE_GIT_DIR" \
    update-ref HEAD "$DOT_TEST_HEAD_RACE_MOVED" "$DOT_TEST_HEAD_RACE_EXPECTED"
  : >"$DOT_TEST_HEAD_RACE_MARKER"
fi
exit "$status"
GIT
chmod +x "$unchanged_base_race_bin/git"
GIT_TRACE2_EVENT=$unchanged_base_race_trace \
  DOT_TEST_HEAD_RACE_REAL_GIT=$unchanged_base_real_git \
  DOT_TEST_HEAD_RACE_GIT_DIR="$unchanged_base_home/.dotfiles" \
  DOT_TEST_HEAD_RACE_MOVED=$unchanged_base_moved \
  DOT_TEST_HEAD_RACE_EXPECTED=$unchanged_base_head \
  DOT_TEST_HEAD_RACE_MARKER=$unchanged_base_race_marker \
  PATH="$unchanged_base_race_bin:$PATH" \
  run_dot "$unchanged_base_home" "$unchanged_base_state" update >/dev/null
[[ -e $unchanged_base_race_marker ]] || fail 'base fetch-boundary race fixture did not run'
unchanged_base_race_ls_tree=$(grep -Fc '"name":"ls-tree"' \
  "$unchanged_base_race_trace" || true)
unchanged_base_race_rebase=$(grep -Fc '"name":"rebase"' \
  "$unchanged_base_race_trace" || true)
assert_eq 1 "$unchanged_base_race_ls_tree" \
  'base HEAD move during fetch bypasses the unchanged fast path'
assert_eq 1 "$unchanged_base_race_rebase" \
  'base HEAD move during fetch follows the ordinary pull path'

# The post-fetch HEAD read is still an external observation. Bind a fast-path
# decision to the same generation immediately before returning so a direct Git
# writer cannot move the checkout during the ancestry decision unnoticed.
base_fast_path_head_race_status=0
HOME=$DOT_TEST_TMP/base-fast-path-head-race-home DOT_SOURCE_ROOT=$root \
  DOT_TEST_HEAD_MARKER=$DOT_TEST_TMP/base-fast-path-head-race-marker \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/repos/pull.sh"
    DOT_QUIET=1
    _repo_has_upstream() { return 0; }
    _repo_prepare_base_upstream() { REPLY=upstream; }
    _repo_head() {
      if [[ ! -e $DOT_TEST_HEAD_MARKER ]]; then
        printf "local\n"
      else
        printf "moved\n"
      fi
    }
    _repo_head_contains_upstream() {
      : >"$DOT_TEST_HEAD_MARKER"
      return 0
    }
    _repo_validate_ahead_delta() { return 0; }

    if _pull_base; then
      exit 1
    fi
    [[ $REPLY_STATUS == failed ]]
  ' || base_fast_path_head_race_status=$?
assert_eq 0 "$base_fast_path_head_race_status" \
  'base fast path fails closed when HEAD moves after capture'

overlay_fast_path_head_race_status=0
overlay_fast_path_head_race_home=$DOT_TEST_TMP/overlay-fast-path-head-race-home
mkdir -p "$overlay_fast_path_head_race_home/checkout"
HOME=$overlay_fast_path_head_race_home DOT_SOURCE_ROOT=$root \
  DOT_TEST_HEAD_MARKER=$DOT_TEST_TMP/overlay-fast-path-head-race-marker \
  DOT_TEST_OVERLAY_PATH=$overlay_fast_path_head_race_home/checkout \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/repos/pull.sh"
    DOT_QUIET=1
    DOT_UI_TOTAL=0
    _warn() { :; }
    _overlay_effective_url() { REPLY=$1; }
    _overlay_is_worktree() { return 0; }
    _overlay_origin_matches() { return 0; }
    _repo_has_upstream() { return 0; }
    _repo_prepare_overlay_upstream() { REPLY=upstream; }
    _repo_head() {
      if [[ ! -e $DOT_TEST_HEAD_MARKER ]]; then
        printf "local\n"
      else
        printf "moved\n"
      fi
    }
    _repo_head_contains_upstream() {
      : >"$DOT_TEST_HEAD_MARKER"
      return 0
    }
    _repo_validate_ahead_delta() { return 0; }

    _pull_overlay example "$DOT_TEST_OVERLAY_PATH" file:///unused false
    [[ $REPLY_STATUS == failed ]]
  ' || overlay_fast_path_head_race_status=$?
assert_eq 0 "$overlay_fast_path_head_race_status" \
  'overlay fast path fails closed when HEAD moves after capture'

# The non-fast path snapshots parent generations against head_before. Confirm
# that same generation is still checked out immediately before pull mutates the
# worktree; otherwise its normalization and rollback evidence is stale.
base_pull_head_race_status=0
HOME=$DOT_TEST_TMP/base-pull-head-race-home DOT_SOURCE_ROOT=$root \
  DOT_TEST_HEAD_MARKER=$DOT_TEST_TMP/base-pull-head-race-marker \
  DOT_TEST_PARENT_SNAPSHOT=$DOT_TEST_TMP/base-pull-head-race-parents \
  DOT_TEST_PULL_MARKER=$DOT_TEST_TMP/base-pull-head-race-pulled \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/repos/pull.sh"
    DOT_QUIET=1
    _repo_has_upstream() { return 0; }
    _repo_prepare_base_upstream() { REPLY=upstream; }
    _repo_head() {
      if [[ ! -e $DOT_TEST_HEAD_MARKER ]]; then
        : >"$DOT_TEST_HEAD_MARKER"
        printf "local\n"
      else
        printf "moved\n"
      fi
    }
    _repo_head_contains_upstream() { return 1; }
    _repo_validate_candidate_tree() { return 0; }
    _repo_snapshot_updated_path_parents() {
      : >"$DOT_TEST_PARENT_SNAPSHOT"
      REPLY=$DOT_TEST_PARENT_SNAPSHOT
    }
    _pull_repo() {
      : >"$DOT_TEST_PULL_MARKER"
      return 0
    }
    _repo_normalize_updated_paths() { return 0; }
    _dot_cleanup_remove_path() { rm -f -- "$1"; }

    if _pull_base; then
      exit 1
    fi
    [[ $REPLY_STATUS == failed ]]
    [[ ! -e $DOT_TEST_PULL_MARKER ]]
  ' || base_pull_head_race_status=$?
assert_eq 0 "$base_pull_head_race_status" \
  'base pull rejects a stale pre-mutation HEAD snapshot'

overlay_pull_head_race_status=0
overlay_pull_head_race_home=$DOT_TEST_TMP/overlay-pull-head-race-home
mkdir -p "$overlay_pull_head_race_home/checkout"
HOME=$overlay_pull_head_race_home DOT_SOURCE_ROOT=$root \
  DOT_TEST_HEAD_MARKER=$DOT_TEST_TMP/overlay-pull-head-race-marker \
  DOT_TEST_OVERLAY_PATH=$overlay_pull_head_race_home/checkout \
  DOT_TEST_PARENT_SNAPSHOT=$DOT_TEST_TMP/overlay-pull-head-race-parents \
  DOT_TEST_PULL_MARKER=$DOT_TEST_TMP/overlay-pull-head-race-pulled \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/repos/pull.sh"
    DOT_QUIET=1
    DOT_UI_TOTAL=0
    _warn() { :; }
    _overlay_effective_url() { REPLY=$1; }
    _overlay_is_worktree() { return 0; }
    _overlay_origin_matches() { return 0; }
    _repo_has_upstream() { return 0; }
    _repo_prepare_overlay_upstream() { REPLY=upstream; }
    _repo_head() {
      if [[ ! -e $DOT_TEST_HEAD_MARKER ]]; then
        : >"$DOT_TEST_HEAD_MARKER"
        printf "local\n"
      else
        printf "moved\n"
      fi
    }
    _repo_head_contains_upstream() { return 1; }
    _repo_validate_candidate_tree() { return 0; }
    _repo_snapshot_updated_path_parents() {
      : >"$DOT_TEST_PARENT_SNAPSHOT"
      REPLY=$DOT_TEST_PARENT_SNAPSHOT
    }
    _pull_repo() {
      : >"$DOT_TEST_PULL_MARKER"
      return 0
    }
    _repo_normalize_updated_paths() { return 0; }
    _dot_cleanup_remove_path() { rm -f -- "$1"; }

    _pull_overlay example "$DOT_TEST_OVERLAY_PATH" file:///unused false
    [[ $REPLY_STATUS == failed ]]
    [[ ! -e $DOT_TEST_PULL_MARKER ]]
  ' || overlay_pull_head_race_status=$?
assert_eq 0 "$overlay_pull_head_race_status" \
  'overlay pull rejects a stale pre-mutation HEAD snapshot'

# update.sh is sourceable, so one process can run more than one synchronization
# cycle. A later no-base failure must never inherit rollback authority captured
# by an earlier successful call.
rollback_generation_reset_status=0
HOME=$DOT_TEST_TMP/rollback-generation-reset-home DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/update.sh"
    base_present=1
    config_loads=0
    restored=-1
    _base_repo_exists() { [[ $base_present -eq 1 ]]; }
    _overlay_snapshot_installed_links() {
      DOT_OVERLAY_ROLLBACK_PATHS=(old)
      DOT_OVERLAY_ROLLBACK_TARGETS=(old-target)
    }
    _repo_pull_all() { return 0; }
    _ensure_repo_config() { :; }
    dot_config_load() {
      config_loads=$((config_loads + 1))
      [[ $config_loads -eq 1 ]]
    }
    _dot_converge_overlays() { return 0; }
    _dot_profile_lifecycle_prepare() { return 0; }
    _dot_update_repo_stage_finish() { :; }
    _overlay_restore_installed_links() {
      restored=${#DOT_OVERLAY_ROLLBACK_PATHS[@]}
    }

    _dot_update_sync_repos
    base_present=0
    if _dot_update_sync_repos; then
      exit 1
    fi
    [[ $restored -eq 0 ]]
  ' || rollback_generation_reset_status=$?
assert_eq 0 "$rollback_generation_reset_status" \
  'each sourced repository sync starts with empty rollback authority'

# Exercise the same fast path through a real overlay checkout. The base test
# above isolates its own branch; with both repositories current, no candidate
# tree or rebase command should be needed for either synchronization unit.
fixture_repo unchanged-overlay-base main .testrc $'base\n' 100644
unchanged_overlay_base_origin=$REPLY
fixture_repo unchanged-overlay main home/.config/overlay/value $'overlay\n' 100644
unchanged_overlay_origin=$REPLY
fixture_home unchanged-overlay
unchanged_overlay_home=$REPLY
unchanged_overlay_state=$DOT_TEST_TMP/unchanged-overlay-state
unchanged_overlay_trace=$DOT_TEST_TMP/unchanged-overlay-trace.json
run_dot "$unchanged_overlay_home" "$unchanged_overlay_state" init --yes \
  "file://$unchanged_overlay_base_origin" >/dev/null
mkdir -p "$unchanged_overlay_home/.config/dot/overlays.d"
printf 'url=file://%s\n' "$unchanged_overlay_origin" \
  >"$unchanged_overlay_home/.config/dot/overlays.d/10-unchanged-overlay.conf"
run_dot "$unchanged_overlay_home" "$unchanged_overlay_state" update >/dev/null
: >"$unchanged_overlay_trace"
GIT_TRACE2_EVENT=$unchanged_overlay_trace \
  run_dot "$unchanged_overlay_home" "$unchanged_overlay_state" update >/dev/null
unchanged_overlay_fetch=$(grep -Fc '"name":"fetch"' "$unchanged_overlay_trace" || true)
unchanged_overlay_ls_tree=$(grep -Fc '"name":"ls-tree"' "$unchanged_overlay_trace" || true)
unchanged_overlay_rebase=$(grep -Fc '"name":"rebase"' "$unchanged_overlay_trace" || true)
assert_eq 2 "$unchanged_overlay_fetch" \
  'unchanged base and overlay still fetch before taking their fast paths'
assert_eq 0 "$unchanged_overlay_ls_tree" \
  'unchanged overlay skips candidate-tree validation after fetch'
assert_eq 0 "$unchanged_overlay_rebase" \
  'unchanged overlay skips an empty rebase after fetch'

# A local branch may intentionally contain reviewed commits ahead of its
# configured upstream, as during a staged rollout. The fetched upstream is
# already part of that accepted generation, so validation and an empty rebase
# would add work without exposing any new tree.
fixture_repo ahead-base main .testrc $'base\n' 100644
ahead_base_origin=$REPLY
fixture_home ahead-base
ahead_base_home=$REPLY
ahead_base_state=$DOT_TEST_TMP/ahead-base-state
ahead_base_trace=$DOT_TEST_TMP/ahead-base-trace.json
run_dot "$ahead_base_home" "$ahead_base_state" init --yes \
  "file://$ahead_base_origin" >/dev/null
printf 'local\n' >"$ahead_base_home/.local-ahead"
git --git-dir="$ahead_base_home/.dotfiles" --work-tree="$ahead_base_home" \
  add .local-ahead
git --git-dir="$ahead_base_home/.dotfiles" --work-tree="$ahead_base_home" \
  -c user.name=fixture -c user.email=fixture@example.invalid \
  -c core.hooksPath=/dev/null commit -qm local-ahead
GIT_TRACE2_EVENT=$ahead_base_trace \
  run_dot "$ahead_base_home" "$ahead_base_state" update >/dev/null
ahead_base_fetch=$(grep -Fc '"name":"fetch"' "$ahead_base_trace" || true)
ahead_base_ls_tree=$(grep -Fc '"name":"ls-tree"' "$ahead_base_trace" || true)
ahead_base_diff_tree=$(grep -Fc '"name":"diff-tree"' "$ahead_base_trace" || true)
ahead_base_rebase=$(grep -Fc '"name":"rebase"' "$ahead_base_trace" || true)
assert_eq 1 "$ahead_base_fetch" \
  'ahead base still fetches before taking the ancestor fast path'
assert_eq 0 "$ahead_base_ls_tree" \
  'ahead base skips full-tree validation for an upstream already in its history'
assert_eq 1 "$ahead_base_diff_tree" \
  'ahead base validates only its unpublished local delta'
assert_eq 0 "$ahead_base_rebase" \
  'ahead base skips an empty rebase onto its ancestor'

fixture_repo ahead-overlay-base main .testrc $'base\n' 100644
ahead_overlay_base_origin=$REPLY
fixture_repo ahead-overlay main home/.config/overlay/value $'overlay\n' 100644
ahead_overlay_origin=$REPLY
fixture_home ahead-overlay
ahead_overlay_home=$REPLY
ahead_overlay_state=$DOT_TEST_TMP/ahead-overlay-state
ahead_overlay_trace=$DOT_TEST_TMP/ahead-overlay-trace.json
run_dot "$ahead_overlay_home" "$ahead_overlay_state" init --yes \
  "file://$ahead_overlay_base_origin" >/dev/null
mkdir -p "$ahead_overlay_home/.config/dot/overlays.d"
printf 'url=file://%s\n' "$ahead_overlay_origin" \
  >"$ahead_overlay_home/.config/dot/overlays.d/10-ahead-overlay.conf"
run_dot "$ahead_overlay_home" "$ahead_overlay_state" update >/dev/null
printf 'local\n' >"$ahead_overlay_home/.dotfiles-ahead-overlay/local-ahead"
git -C "$ahead_overlay_home/.dotfiles-ahead-overlay" add local-ahead
git -C "$ahead_overlay_home/.dotfiles-ahead-overlay" \
  -c user.name=fixture -c user.email=fixture@example.invalid \
  -c core.hooksPath=/dev/null commit -qm local-ahead
: >"$ahead_overlay_trace"
GIT_TRACE2_EVENT=$ahead_overlay_trace \
  run_dot "$ahead_overlay_home" "$ahead_overlay_state" update >/dev/null
ahead_overlay_fetch=$(grep -Fc '"name":"fetch"' "$ahead_overlay_trace" || true)
ahead_overlay_ls_tree=$(grep -Fc '"name":"ls-tree"' "$ahead_overlay_trace" || true)
ahead_overlay_diff_tree=$(grep -Fc '"name":"diff-tree"' "$ahead_overlay_trace" || true)
ahead_overlay_rebase=$(grep -Fc '"name":"rebase"' "$ahead_overlay_trace" || true)
assert_eq 2 "$ahead_overlay_fetch" \
  'ahead overlay and base still fetch before their fast paths'
assert_eq 0 "$ahead_overlay_ls_tree" \
  'ahead overlay skips full-tree validation for an upstream already in its history'
assert_eq 1 "$ahead_overlay_diff_tree" \
  'ahead overlay validates only its unpublished local delta'
assert_eq 0 "$ahead_overlay_rebase" \
  'ahead overlay skips an empty rebase onto its ancestor'

# The ancestor fast path trusts the fetched upstream, not arbitrary local
# commits layered on top. Validate that local delta before accepting an ahead
# checkout so reserved base paths and overlay control-plane paths cannot bypass
# the normal candidate policy.
fixture_repo ahead-unsafe-base main .testrc $'base\n' 100644
ahead_unsafe_base_origin=$REPLY
fixture_home ahead-unsafe-base
ahead_unsafe_base_home=$REPLY
ahead_unsafe_base_state=$DOT_TEST_TMP/ahead-unsafe-base-state
run_dot "$ahead_unsafe_base_home" "$ahead_unsafe_base_state" init --yes \
  "file://$ahead_unsafe_base_origin" >/dev/null
mkdir -p "$ahead_unsafe_base_home/.dotfiles-foreign"
printf 'unsafe\n' >"$ahead_unsafe_base_home/.dotfiles-foreign/value"
git --git-dir="$ahead_unsafe_base_home/.dotfiles" \
  --work-tree="$ahead_unsafe_base_home" add .dotfiles-foreign/value
git --git-dir="$ahead_unsafe_base_home/.dotfiles" \
  --work-tree="$ahead_unsafe_base_home" \
  -c user.name=fixture -c user.email=fixture@example.invalid \
  -c core.hooksPath=/dev/null commit -qm local-reserved-path
ahead_unsafe_base_status=0
run_dot "$ahead_unsafe_base_home" "$ahead_unsafe_base_state" update \
  >/dev/null 2>&1 || ahead_unsafe_base_status=$?
assert_eq 1 "$ahead_unsafe_base_status" \
  'ahead base rejects a local commit that owns a reserved path'

fixture_repo ahead-unsafe-overlay-base main .testrc $'base\n' 100644
ahead_unsafe_overlay_base_origin=$REPLY
fixture_repo ahead-unsafe-overlay main home/.config/overlay/value $'overlay\n' 100644
ahead_unsafe_overlay_origin=$REPLY
fixture_home ahead-unsafe-overlay
ahead_unsafe_overlay_home=$REPLY
ahead_unsafe_overlay_state=$DOT_TEST_TMP/ahead-unsafe-overlay-state
run_dot "$ahead_unsafe_overlay_home" "$ahead_unsafe_overlay_state" init --yes \
  "file://$ahead_unsafe_overlay_base_origin" >/dev/null
mkdir -p "$ahead_unsafe_overlay_home/.config/dot/overlays.d"
printf 'url=file://%s\n' "$ahead_unsafe_overlay_origin" \
  >"$ahead_unsafe_overlay_home/.config/dot/overlays.d/10-ahead-unsafe.conf"
run_dot "$ahead_unsafe_overlay_home" "$ahead_unsafe_overlay_state" update >/dev/null
mkdir -p \
  "$ahead_unsafe_overlay_home/.dotfiles-ahead-unsafe/home/.config/dot/profiles.d"
: >"$ahead_unsafe_overlay_home/.dotfiles-ahead-unsafe/home/.config/dot/profiles.d/evil.conf"
git -C "$ahead_unsafe_overlay_home/.dotfiles-ahead-unsafe" \
  add home/.config/dot/profiles.d/evil.conf
git -C "$ahead_unsafe_overlay_home/.dotfiles-ahead-unsafe" \
  -c user.name=fixture -c user.email=fixture@example.invalid \
  -c core.hooksPath=/dev/null commit -qm local-control-path
ahead_unsafe_overlay_status=0
run_dot "$ahead_unsafe_overlay_home" "$ahead_unsafe_overlay_state" update \
  >/dev/null 2>&1 || ahead_unsafe_overlay_status=$?
assert_eq 1 "$ahead_unsafe_overlay_status" \
  'ahead overlay rejects a local commit that owns profile control state'
[[ ! -e $ahead_unsafe_overlay_home/.config/dot/profiles.d/evil.conf &&
  ! -L $ahead_unsafe_overlay_home/.config/dot/profiles.d/evil.conf ]] ||
  fail 'ahead overlay linked an unvalidated local control-plane path'

# Link-time policy must cover source inventory that Git candidate validation
# cannot see, including untracked files in an otherwise-current checkout.
fixture_repo untracked-control-base main .testrc $'base\n' 100644
untracked_control_base_origin=$REPLY
fixture_repo untracked-control main home/.config/overlay/value $'overlay\n' 100644
untracked_control_origin=$REPLY
fixture_home untracked-control
untracked_control_home=$REPLY
untracked_control_state=$DOT_TEST_TMP/untracked-control-state
run_dot "$untracked_control_home" "$untracked_control_state" init --yes \
  "file://$untracked_control_base_origin" >/dev/null
mkdir -p "$untracked_control_home/.config/dot/overlays.d"
printf 'url=file://%s\n' "$untracked_control_origin" \
  >"$untracked_control_home/.config/dot/overlays.d/10-untracked-control.conf"
run_dot "$untracked_control_home" "$untracked_control_state" update >/dev/null
