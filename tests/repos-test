git -C "$adapter_update_seed" add .local/bin/dot
git -C "$adapter_update_seed" -c core.hooksPath=/dev/null \
  commit -qm permanent-adapter
git -C "$adapter_update_seed" push -q "$adapter_update_origin" HEAD:main
run_dot "$adapter_update_home" "$adapter_update_state" update >/dev/null
assert_files_equal "$root/support/client-launcher.sh" \
  "$adapter_update_home/.local/bin/dot" \
  'exact permanent client launcher was not accepted during update'
printf '# modified\n' >>"$adapter_update_seed/.local/bin/dot"
git -C "$adapter_update_seed" add .local/bin/dot
git -C "$adapter_update_seed" -c core.hooksPath=/dev/null commit -qm modified-adapter
git -C "$adapter_update_seed" push -q "$adapter_update_origin" HEAD:main
set +e
run_dot "$adapter_update_home" "$adapter_update_state" update >/dev/null 2>&1
adapter_update_status=$?
set -e
assert_eq 1 "$adapter_update_status" \
  'modified generated client launcher is rejected during update'
