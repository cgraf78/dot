# A caller can finish as soon as one reserved root matches, but the producer in
# its process substitution must still be drained. Hosted CI enters Bash with
# SIGPIPE ignored; closing the reader early therefore turns each later printf
# into a noisy write error instead of terminating the producer silently.
reserved_pipe_home=$DOT_TEST_TMP/reserved-pipe-home
reserved_pipe_state=$DOT_TEST_TMP/reserved-pipe-state
mkdir -p "$reserved_pipe_home" "$reserved_pipe_state"
set +e
reserved_pipe_output=$(HOME=$reserved_pipe_home \
  XDG_STATE_HOME=$reserved_pipe_state DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    trap "" PIPE
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    OVERLAYS=()

    # Delay the producer immediately after its first record so the old
    # early-return consumer deterministically closes the pipe before record 2.
    printf() {
      local rc=0
      builtin printf "$@" || rc=$?
      if [[ ${1:-} == "%s\\n" && ${2:-} == "$XDG_STATE_HOME/dot" ]]; then
        sleep 0.05
      fi
      if [[ $rc -ne 0 ]]; then
        builtin printf "reserved-root producer wrote after reader exit\\n" >&2
      fi
      return "$rc"
    }

    dot_candidate_path_is_reserved "$XDG_STATE_HOME/dot/value"
  ' 2>&1 >/dev/null)
reserved_pipe_status=$?
set -e
assert_eq 0 "$reserved_pipe_status" \
  'reserved-root lookup succeeds with an inherited ignored SIGPIPE'
assert_eq '' "$reserved_pipe_output" \
  'reserved-root lookup drains its producer without broken-pipe diagnostics'

