[[ ${overlay_index_entry:0:2} == 'S ' ]] ||
  fail 'tracked overlay path did not receive skip-worktree ownership'

# A crash can leave the pending manifest as the only complete authority for a
# live overlay symlink. The next run must consume it even after the descriptor
# and source disappear, restore the tracked base file, and clear index state.
overlay_manifest=$overlay_state/dot/overlay-links
cp "$overlay_manifest" "$overlay_manifest.pending"
chmod 0600 "$overlay_manifest.pending"
rm -f "$overlay_home/.config/dot/overlays.d/10-alpha.local.conf"
rm -rf "$local_overlay"
run_dot "$overlay_home" "$overlay_state" update >/dev/null
[[ -f $overlay_home/.config/example/value &&
  ! -L $overlay_home/.config/example/value ]] ||
  fail 'pending overlay recovery did not restore the tracked base file'
assert_eq base "$(<"$overlay_home/.config/example/value")" \
  'pending overlay recovery restored base bytes'
overlay_index_entry=$(git --git-dir="$overlay_home/.dotfiles" \
  ls-files -v -- .config/example/value)
[[ ${overlay_index_entry:0:2} != 'S ' ]] ||
  fail 'pending overlay recovery retained skip-worktree ownership'
[[ ! -e $overlay_manifest.pending && ! -L $overlay_manifest.pending ]] ||
  fail 'pending overlay recovery record was not retired'

