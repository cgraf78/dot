  [[ -s $normalize_probe/worker.pid && -s $normalize_probe/worker.flags &&
    -s $normalize_probe/child.pid ]] && break
  kill -0 "$normalize_owner" 2>/dev/null || break
  sleep 0.01
done
[[ -s $normalize_probe/worker.pid && -s $normalize_probe/worker.flags &&
  -s $normalize_probe/child.pid ]] || {
  kill -TERM "$normalize_owner" 2>/dev/null || true
  wait "$normalize_owner" 2>/dev/null || true
  fail 'normalization cancellation fixture did not start'
