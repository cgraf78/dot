    mkdir "$transaction"
    chmod 0700 "$transaction"
    : >"$transaction/foreign"
    if _overlay_recover_replacements; then
      exit 1
    fi
    [[ -L $destination && $(readlink "$destination") == old-malformed ]]
    [[ -f $record && -d $transaction && -f $transaction/foreign ]]
  '

