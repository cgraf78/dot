#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"
# shellcheck source=lib/repo.sh
. "$root/tests/lib/repo.sh"
# shellcheck source=../lib/dot/platform.sh
. "$root/lib/dot/platform.sh"
DOT_TEST_REAL_MV=$(type -P mv)
export DOT_TEST_REAL_MV

fixture_repo update topic .testrc $'one\n' 100644
origin=$REPLY
fixture_home update
home=$REPLY
state=$DOT_TEST_TMP/update-state
run_dot "$home" "$state" init --yes "file://$origin" >/dev/null
fixture_push update topic .testrc $'two\n' 100644
run_dot "$home" "$state" update >/dev/null
assert_eq two "$(<"$home/.testrc")" 'base update follows configured non-main upstream'
assert_eq false "$(git --git-dir="$home/.dotfiles" config core.fsmonitor)" \
  'base model disables fsmonitor'
assert_eq no "$(git --git-dir="$home/.dotfiles" config status.showUntrackedFiles)" \
  'base model suppresses untracked scan'
assert_eq '' "$(git --git-dir="$home/.dotfiles" config --local --get pull.rebase 2>/dev/null || true)" \
  'base update does not write pull policy'

# Client trees may not occupy deterministic same-parent init staging or
# rollback namespaces. Candidate inventories contain leaves, so cover both a
# direct file and a descendant below a stage-shaped directory at root/nested
# depths for every reserved prefix.
init_namespace_status=0
init_namespace_home=$DOT_TEST_TMP/init-namespace-home
mkdir -p \
  "$init_namespace_home/.dot-init-entry.physical" \
  "$init_namespace_home/.dot-init-parent.physical" \
  "$init_namespace_home/.dot-init-delete.physical"
ln -s .dot-init-entry.physical "$init_namespace_home/entry-alias"
ln -s .dot-init-parent.physical "$init_namespace_home/parent-alias"
ln -s .dot-init-delete.physical "$init_namespace_home/delete-alias"
HOME=$init_namespace_home DOT_SOURCE_ROOT=$root bash --noprofile --norc -c '
  set -euo pipefail
  . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
  . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
  . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
  OVERLAYS=()
  for candidate in \
    "$HOME/.dot-init-entry.fixture.path" \
    "$HOME/nested/.dot-init-entry.fixture.path/owned" \
    "$HOME/.dot-init-parent.fixture.path" \
    "$HOME/nested/.dot-init-parent.fixture.path/owned" \
    "$HOME/.dot-init-delete.fixture.path" \
    "$HOME/nested/.dot-init-delete.fixture.path/owned" \
    "$HOME/entry-alias/owned" \
    "$HOME/parent-alias/owned" \
    "$HOME/delete-alias/owned"; do
    dot_candidate_path_is_reserved "$candidate"
  done
' || init_namespace_status=$?
assert_eq 0 "$init_namespace_status" \
  'candidate validation reserves every same-parent init recovery namespace'

# A caller can finish as soon as one reserved root matches, but the producer in
# its process substitution must still be drained. Hosted CI enters Bash with
# SIGPIPE ignored; closing the reader early therefore turns each later printf
# into a noisy write error instead of terminating the producer silently.
reserved_pipe_home=$DOT_TEST_TMP/reserved-pipe-home
reserved_pipe_state=$DOT_TEST_TMP/reserved-pipe-state
mkdir -p "$reserved_pipe_home" "$reserved_pipe_state"
set +e
reserved_pipe_output=$(HOME=$reserved_pipe_home \
  XDG_STATE_HOME=$reserved_pipe_state DOT_SOURCE_ROOT=$root \
  bash --noprofile --norc -c '
    set -euo pipefail
    trap "" PIPE
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    OVERLAYS=()

    # Delay the producer immediately after its first record so the old
    # early-return consumer deterministically closes the pipe before record 2.
    printf() {
      local rc=0
      builtin printf "$@" || rc=$?
      if [[ ${1:-} == "%s\\n" && ${2:-} == "$XDG_STATE_HOME/dot" ]]; then
        sleep 0.05
      fi
      if [[ $rc -ne 0 ]]; then
        builtin printf "reserved-root producer wrote after reader exit\\n" >&2
      fi
      return "$rc"
    }

    dot_candidate_path_is_reserved "$XDG_STATE_HOME/dot/value"
  ' 2>&1 >/dev/null)
reserved_pipe_status=$?
set -e
assert_eq 0 "$reserved_pipe_status" \
  'reserved-root lookup succeeds with an inherited ignored SIGPIPE'
assert_eq '' "$reserved_pipe_output" \
  'reserved-root lookup drains its producer without broken-pipe diagnostics'

# Candidate inventories can contain hundreds of paths. Resolve the complete
# reserved-root set once per candidate, and avoid an external canonicalizer for
# ordinary roots whose leaf is not a symlink. The one symlink below still needs
# physical resolution; repeated calls expose the process-spawn regression that
# made warm repository and overlay convergence take minutes.
reserved_resolution_home=$DOT_TEST_TMP/reserved-resolution-home
reserved_resolution_state=$DOT_TEST_TMP/reserved-resolution-state
reserved_resolution_target=$DOT_TEST_TMP/reserved-resolution-target
reserved_resolution_bin=$DOT_TEST_TMP/reserved-resolution-bin
reserved_resolution_log=$DOT_TEST_TMP/reserved-resolution.log
reserved_resolution_realpath=$(type -P realpath)
mkdir -p "$reserved_resolution_home/.local/lib" \
  "$reserved_resolution_state" "$reserved_resolution_target" \
  "$reserved_resolution_bin"
ln -s "$reserved_resolution_target" \
  "$reserved_resolution_home/.local/lib/dot"
cat >"$reserved_resolution_bin/realpath" <<'REALPATH'
#!/usr/bin/env bash
printf '%s\n' "$1" >>"$DOT_TEST_RESERVED_RESOLUTION_LOG"
exec "$DOT_TEST_RESERVED_RESOLUTION_REALPATH" "$@"
REALPATH
chmod +x "$reserved_resolution_bin/realpath"
HOME=$reserved_resolution_home XDG_STATE_HOME=$reserved_resolution_state \
  DOT_SOURCE_ROOT=$root \
  DOT_TEST_RESERVED_RESOLUTION_LOG=$reserved_resolution_log \
  DOT_TEST_RESERVED_RESOLUTION_REALPATH=$reserved_resolution_realpath \
  PATH="$reserved_resolution_bin:$PATH" bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    OVERLAYS=()
    ! dot_candidate_path_is_reserved "$HOME/.config/ordinary/value"
  '
assert_eq 1 "$(wc -l <"$reserved_resolution_log")" \
  'candidate validation canonicalizes one symlinked reserved root once'

# A fetched tree is inert until validation completes, so one stable root
# snapshot can serve every entry. Re-read once after the scan to reject a root
# topology change without multiplying canonicalization by tree size.
fixture_repo reserved-resolution-tree main \
  first $'one\n' 100644 \
  second $'two\n' 100644 \
  nested/third $'three\n' 100644
reserved_resolution_origin=$REPLY
: >"$reserved_resolution_log"
HOME=$reserved_resolution_home XDG_STATE_HOME=$reserved_resolution_state \
  DOT_SOURCE_ROOT=$root \
  DOT_TEST_RESERVED_RESOLUTION_LOG=$reserved_resolution_log \
  DOT_TEST_RESERVED_RESOLUTION_REALPATH=$reserved_resolution_realpath \
  DOT_TEST_RESERVED_RESOLUTION_ORIGIN=$reserved_resolution_origin \
  PATH="$reserved_resolution_bin:$PATH" bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/resources.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/init-client.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/pull.sh"
    OVERLAYS=()
    _repo_validate_candidate_tree base HEAD \
      git --git-dir="$DOT_TEST_RESERVED_RESOLUTION_ORIGIN"
  '
assert_eq 2 "$(wc -l <"$reserved_resolution_log")" \
  'candidate tree validation snapshots reserved roots before and after its scan'

# Physical candidate resolution is sourceable library behavior. Preserve the
# caller's logical cwd and OLDPWD even when the path crosses a symlink and its
# missing suffix must be appended to the physical directory.
physical_candidate_home=$DOT_TEST_TMP/physical-candidate-home
physical_candidate_target=$DOT_TEST_TMP/physical-candidate-target
mkdir -p "$physical_candidate_home" "$physical_candidate_target"
ln -s "$physical_candidate_target" "$physical_candidate_home/alias"
physical_candidate_result=$(HOME=$physical_candidate_home \
  DOT_SOURCE_ROOT=$root DOT_TEST_PHYSICAL_TARGET=$physical_candidate_target \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    cd -L -- "$HOME/alias"
    OLDPWD=$HOME/original-oldpwd
    before=$PWD
    _dot_physical_directory_candidate "$HOME/alias/missing/leaf"
    printf "before=%s\nafter=%s\noldpwd=%s\nreply=%s\n" \
      "$before" "$PWD" "$OLDPWD" "$REPLY"
  ')
assert_eq "before=$physical_candidate_home/alias
after=$physical_candidate_home/alias
oldpwd=$physical_candidate_home/original-oldpwd
reply=$physical_candidate_target/missing/leaf" \
  "$physical_candidate_result" \
  'physical candidate resolution preserves caller directory state'

# Replacement identities are durable recovery data and therefore must use the
# engine checkout's object format, not an exported repository selection from
# the shell that happened to invoke dot. A SHA-256 decoy makes that drift
# observable without mocking Git.
replacement_identity_path=$DOT_TEST_TMP/replacement-identity-value
replacement_identity_decoy=$DOT_TEST_TMP/replacement-identity-decoy
printf 'replacement identity\n' >"$replacement_identity_path"
git init -q --object-format=sha256 "$replacement_identity_decoy"
replacement_identity_default=$(DOT_SOURCE_ROOT=$root \
  DOT_TEST_REPLACEMENT_IDENTITY_PATH=$replacement_identity_path \
  bash --noprofile --norc -c '
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _overlay_replacement_identity "$DOT_TEST_REPLACEMENT_IDENTITY_PATH"
  ')
replacement_identity_decoy_value=$(DOT_SOURCE_ROOT=$root \
  DOT_TEST_REPLACEMENT_IDENTITY_PATH=$replacement_identity_path \
  GIT_DIR=$replacement_identity_decoy/.git \
  bash --noprofile --norc -c '
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _overlay_replacement_identity "$DOT_TEST_REPLACEMENT_IDENTITY_PATH"
  ')
assert_eq "$replacement_identity_default" "$replacement_identity_decoy_value" \
  'replacement identity ignores an exported foreign Git repository'
replacement_record_manifest=$DOT_TEST_TMP/replacement-record-state/overlay-links
mkdir -p "${replacement_record_manifest%/*}"
replacement_record_default=$(DOT_SOURCE_ROOT=$root \
  DOT_OVERLAY_MANIFEST=$replacement_record_manifest \
  DOT_TEST_REPLACEMENT_IDENTITY_PATH=$replacement_identity_path \
  bash --noprofile --norc -c '
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _overlay_replacement_record_path "$DOT_TEST_REPLACEMENT_IDENTITY_PATH"
    printf "%s\n" "$REPLY"
  ')
replacement_record_decoy=$(DOT_SOURCE_ROOT=$root \
  DOT_OVERLAY_MANIFEST=$replacement_record_manifest \
  DOT_TEST_REPLACEMENT_IDENTITY_PATH=$replacement_identity_path \
  GIT_DIR=$replacement_identity_decoy/.git \
  bash --noprofile --norc -c '
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _overlay_replacement_record_path "$DOT_TEST_REPLACEMENT_IDENTITY_PATH"
    printf "%s\n" "$REPLY"
  ')
assert_eq "$replacement_record_default" "$replacement_record_decoy" \
  'replacement record path ignores an exported foreign Git repository'

replacement_record_home=$DOT_TEST_TMP/replacement-record-home
mkdir -p "$replacement_record_home"
replacement_record=$(HOME=$replacement_record_home DOT_SOURCE_ROOT=$root \
  DOT_OVERLAY_MANIFEST=$replacement_record_manifest \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/temp.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/reserved.sh"
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    OVERLAYS=()
    destination=$HOME/value
    target=new-value
    ln -s old-value "$destination"
    expected=$(_overlay_replacement_identity "$destination")
    _overlay_destination_context "$destination"
    physical=$OVERLAY_PHYSICAL_DESTINATION
    parent_identity=$OVERLAY_PARENT_IDENTITY
    _overlay_replacement_record_path "$destination"
    record=$REPLY
    transaction=${physical%/*}/.${physical##*/}.dot-overlay-replace-v1
    printf -v record_line "%s\t%s\t%s\t%s\t%s\t%s" \
      "$destination" "$physical" "$target" "$expected" \
      "$transaction" "$parent_identity"
    _overlay_write_private_line "$record" "$record_line"
    printf "%s\n" "$record"
  ')
HOME=$replacement_record_home DOT_SOURCE_ROOT=$root \
  DOT_OVERLAY_MANIFEST=$replacement_record_manifest \
  DOT_TEST_REPLACEMENT_RECORD=$replacement_record \
  GIT_DIR=$replacement_identity_decoy/.git \
  bash --noprofile --norc -c '
    set -euo pipefail
    . "$DOT_SOURCE_ROOT/lib/dot/repos/overlays.sh"
    _overlay_replacement_read "$DOT_TEST_REPLACEMENT_RECORD"
    [[ $OVERLAY_REPLACE_IDENTITY_KIND == content ]]
  '

# Cron repair follows the configured upstream rather than assuming main.
fixture_push update topic .testrc $'three\n' 100644
printf 'three\n' >"$home/.testrc"
run_dot "$home" "$state" update --cron >/dev/null
assert_eq "$(git --git-dir="$home/.dotfiles" rev-parse origin/topic)" \
  "$(git --git-dir="$home/.dotfiles" rev-parse HEAD)" \
  'cron dirty repair follows non-main base upstream'

fixture_repo reserved-update main .testrc $'safe\n' 100644
reserved_origin=$REPLY
fixture_home reserved-update
reserved_home=$REPLY
reserved_state=$DOT_TEST_TMP/reserved-update-state
run_dot "$reserved_home" "$reserved_state" init --yes "file://$reserved_origin" >/dev/null
before=$(git --git-dir="$reserved_home/.dotfiles" rev-parse HEAD)
