    unlink "$HOME/alias"
    ln -s "$DOT_TEST_REPLACEMENT_PARENT_NEW" "$HOME/alias"
    _overlay_recover_replacements

    [[ -L $physical && $(readlink "$physical") == old-parent-generation ]]
    [[ ! -e $record && ! -L $record && ! -e $transaction && ! -L $transaction ]]
    [[ ! -e $HOME/alias/value && ! -L $HOME/alias/value ]]
  '

