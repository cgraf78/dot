mkdir -p "$adapter_update_seed/.local/bin"
cp "$root/support/client-launcher-v4.sh" "$adapter_update_seed/.local/bin/dot"
chmod 0755 "$adapter_update_seed/.local/bin/dot"
git -C "$adapter_update_seed" add .local/bin/dot
git -C "$adapter_update_seed" -c core.hooksPath=/dev/null commit -qm adapter-v4
