  'failed handoff keeps base destination content available'
mv "$base_fallback_blocker_origin.offline" "$base_fallback_blocker_origin"
run_dot "$base_fallback_home" "$base_fallback_state" update -f >/dev/null
assert_eq 'base destination' \
  "$(<"$base_fallback_home/.config/base-fallback/value")" \
  'base handoff retry converges'

