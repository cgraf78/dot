fixture_home mixed-conflict
mixed_conflict_home=$REPLY
mixed_conflict_state=$DOT_TEST_TMP/mixed-conflict-state
run_dot "$mixed_conflict_home" "$mixed_conflict_state" init --yes \
  "file://$mixed_conflict_origin" >/dev/null
mkdir -p "$mixed_conflict_home/.config/mixed-conflict"
printf 'user\n' >"$mixed_conflict_home/.config/mixed-conflict/user"

mixed_conflict_seed=$DOT_TEST_TMP/mixed-conflict-base-seed
rm "$mixed_conflict_seed/.config/dot/overlays.d/20-source.conf"
mkdir -p "$mixed_conflict_seed/.config/mixed-conflict"
printf 'base-managed\n' >"$mixed_conflict_seed/.config/mixed-conflict/managed"
printf 'base-user\n' >"$mixed_conflict_seed/.config/mixed-conflict/user"
commit_seed mixed-conflict-base adopt-with-user-conflict
mixed_conflict_log=$DOT_TEST_TMP/mixed-conflict.log
run_dot "$mixed_conflict_home" "$mixed_conflict_state" update -f \
  >"$mixed_conflict_log" 2>&1
assert_eq base-managed \
  "$(<"$mixed_conflict_home/.config/mixed-conflict/managed")" \
  'managed conflict converges to base content'
assert_eq base-user \
  "$(<"$mixed_conflict_home/.config/mixed-conflict/user")" \
  'user conflict converges to base content'
mixed_conflict_backup_count=0
mixed_conflict_user_backup=''
for candidate in "$mixed_conflict_home"/.dot-backup/pull/*; do
  [[ -d $candidate ]] || continue
  mixed_conflict_backup_count=$((mixed_conflict_backup_count + 1))
  mixed_conflict_user_backup=$candidate/.config/mixed-conflict/user
  [[ ! -e $candidate/.config/mixed-conflict/managed &&
    ! -L $candidate/.config/mixed-conflict/managed ]] ||
    fail 'managed overlay link leaked into the user-conflict backup'
done
assert_eq 1 "$mixed_conflict_backup_count" \
  'mixed conflicts create one backup generation'
assert_eq user "$(<"$mixed_conflict_user_backup")" \
  'mixed conflicts preserve user-owned content in the backup'
assert_contains 'backed up 1 conflicting untracked files' \
  "$(<"$mixed_conflict_log")" \
  'mixed conflicts report only the user-owned backup'
assert_contains 'adopted 1 managed overlay path for the base repository' \
  "$(<"$mixed_conflict_log")" \
  'mixed conflicts report managed adoption separately'

printf '%s\n' '=== overlay to base rollback and retry ==='
