#!/usr/bin/env bash
# Verify that tracked content can move between the base and overlays without
# leaving stale links, losing rollback authority, or backing up managed links
# as though they were user-owned conflicts.

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"
# shellcheck source=lib/repo.sh
. "$root/tests/lib/repo.sh"

# Some minimal distribution images do not install `hostname`. Keep profile
# resolution deterministic without making this ownership suite depend on an
# unrelated base package.
fixture_bin=$DOT_TEST_TMP/bin
mkdir -p "$fixture_bin"
# shellcheck disable=SC2016 # The generated helper expands its own argument.
printf '%s\n' \
  '#!/bin/sh' \
  'case ${1:-} in ""|-s) printf "%s\\n" ownership.invalid ;; *) exit 2 ;; esac' \
  >"$fixture_bin/hostname"
chmod +x "$fixture_bin/hostname"
PATH=$fixture_bin:$PATH
export PATH

commit_seed() {
  local name=$1 message=$2 branch=${3:-main}
  local seed=$DOT_TEST_TMP/$name-seed origin=$DOT_TEST_TMP/$name.git

  git -C "$seed" add -A
  git -C "$seed" -c core.hooksPath=/dev/null commit -qm "$message"
  git -C "$seed" push -q "$origin" "HEAD:$branch"
}

assert_link_owner() {
  local home=$1 relative=$2 owner=$3 label=$4 target
  [[ -L $home/$relative ]] || fail "$label: destination is not a symlink"
  target=$(readlink "$home/$relative") || fail "$label: cannot read symlink"
  assert_contains ".dotfiles-$owner/home/$relative" "$target" "$label"
}

assert_no_pull_backup() {
  local home=$1 label=$2 candidate
  for candidate in "$home"/.dot-backup/pull/*; do
    [[ ! -e $candidate && ! -L $candidate ]] ||
      fail "$label: unexpected pull backup: $candidate"
  done
}

printf '%s\n' '=== base to overlay ==='
fixture_repo base-to-overlay-target main README.md $'target\n' 100644
base_to_overlay_target_origin=$REPLY
fixture_repo base-to-overlay-base main \
  .config/dot/overlays.d/20-target.conf \
  "url=file://$base_to_overlay_target_origin" 100644 \
  .config/base-to-overlay/value $'base\n' 100644
base_to_overlay_origin=$REPLY
fixture_home base-to-overlay
base_to_overlay_home=$REPLY
base_to_overlay_state=$DOT_TEST_TMP/base-to-overlay-state
run_dot "$base_to_overlay_home" "$base_to_overlay_state" init --yes \
  "file://$base_to_overlay_origin" >/dev/null
[[ -f $base_to_overlay_home/.config/base-to-overlay/value &&
  ! -L $base_to_overlay_home/.config/base-to-overlay/value ]] ||
  fail 'base-to-overlay fixture did not start with a base-owned file'

fixture_push base-to-overlay-target main \
  home/.config/base-to-overlay/value $'overlay\n' 100644
rm "$DOT_TEST_TMP/base-to-overlay-base-seed/.config/base-to-overlay/value"
commit_seed base-to-overlay-base extract
run_dot "$base_to_overlay_home" "$base_to_overlay_state" update -f >/dev/null
assert_link_owner "$base_to_overlay_home" .config/base-to-overlay/value target \
  'base-to-overlay transfer publishes the target link'
assert_eq overlay "$(<"$base_to_overlay_home/.config/base-to-overlay/value")" \
  'base-to-overlay transfer publishes target content'
assert_no_pull_backup "$base_to_overlay_home" \
  'base-to-overlay transfer avoids conflict backups'

printf '%s\n' '=== overlay to base ==='
fixture_repo overlay-to-base-source main \
  home/.config/overlay-to-base/value $'overlay\n' 100644
overlay_to_base_source_origin=$REPLY
fixture_repo overlay-to-base-base main \
  .config/dot/overlays.d/20-source.conf \
  "url=file://$overlay_to_base_source_origin" 100644 \
  README.md $'base\n' 100644
overlay_to_base_origin=$REPLY
fixture_home overlay-to-base
overlay_to_base_home=$REPLY
overlay_to_base_state=$DOT_TEST_TMP/overlay-to-base-state
run_dot "$overlay_to_base_home" "$overlay_to_base_state" init --yes \
  "file://$overlay_to_base_origin" >/dev/null
assert_link_owner "$overlay_to_base_home" .config/overlay-to-base/value source \
  'overlay-to-base fixture starts with the source link'

overlay_to_base_seed=$DOT_TEST_TMP/overlay-to-base-base-seed
rm "$overlay_to_base_seed/.config/dot/overlays.d/20-source.conf"
mkdir -p "$overlay_to_base_seed/.config/overlay-to-base"
printf 'base\n' >"$overlay_to_base_seed/.config/overlay-to-base/value"
commit_seed overlay-to-base-base adopt
overlay_to_base_log=$DOT_TEST_TMP/overlay-to-base.log
run_dot "$overlay_to_base_home" "$overlay_to_base_state" update -f \
  >"$overlay_to_base_log" 2>&1
[[ -f $overlay_to_base_home/.config/overlay-to-base/value &&
  ! -L $overlay_to_base_home/.config/overlay-to-base/value ]] ||
  fail 'overlay-to-base transfer did not publish the base-owned file'
assert_eq base "$(<"$overlay_to_base_home/.config/overlay-to-base/value")" \
  'overlay-to-base transfer publishes base content'
[[ -d $overlay_to_base_home/.dotfiles-source/.git ]] ||
  fail 'overlay-to-base transfer removed the cached source checkout'
assert_no_pull_backup "$overlay_to_base_home" \
  'overlay-to-base transfer avoids managed-link backups'
assert_contains 'adopted 1 managed overlay path for the base repository' \
  "$(<"$overlay_to_base_log")" \
  'overlay-to-base transfer reports base adoption'

fixture_push overlay-to-base-source main \
  home/.config/overlay-to-base/value $'overlay-returned\n' 100644
rm "$overlay_to_base_seed/.config/overlay-to-base/value"
mkdir -p "$overlay_to_base_seed/.config/dot/overlays.d"
printf 'url=file://%s\n' "$overlay_to_base_source_origin" \
  >"$overlay_to_base_seed/.config/dot/overlays.d/20-source.conf"
commit_seed overlay-to-base-base return-to-overlay
run_dot "$overlay_to_base_home" "$overlay_to_base_state" update -f >/dev/null
assert_link_owner "$overlay_to_base_home" .config/overlay-to-base/value source \
  'reverse transfer reuses the retained source checkout'
assert_eq overlay-returned \
  "$(<"$overlay_to_base_home/.config/overlay-to-base/value")" \
  'reverse transfer publishes the updated overlay content'
assert_no_pull_backup "$overlay_to_base_home" \
  'reverse transfer avoids conflict backups'

printf '%s\n' '=== user replacement at a formerly managed path ==='
fixture_repo replaced-managed-source main \
  home/.config/replaced-managed/value $'overlay\n' 100644
replaced_managed_source_origin=$REPLY
fixture_repo replaced-managed-base main \
  .config/dot/overlays.d/20-source.conf \
  "url=file://$replaced_managed_source_origin" 100644 \
  README.md $'base\n' 100644
replaced_managed_origin=$REPLY
fixture_home replaced-managed
replaced_managed_home=$REPLY
replaced_managed_state=$DOT_TEST_TMP/replaced-managed-state
run_dot "$replaced_managed_home" "$replaced_managed_state" init --yes \
  "file://$replaced_managed_origin" >/dev/null
rm "$replaced_managed_home/.config/replaced-managed/value"
printf 'user replacement\n' \
  >"$replaced_managed_home/.config/replaced-managed/value"

