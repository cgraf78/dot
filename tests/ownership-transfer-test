assert_eq target \
  "$(<"$overlay_fallback_home/.config/overlay-fallback/value")" \
  'failed overlay handoff keeps destination content available'
mv "$overlay_fallback_blocker_origin.offline" "$overlay_fallback_blocker_origin"
run_dot "$overlay_fallback_home" "$overlay_fallback_state" update -f >/dev/null
assert_link_owner "$overlay_fallback_home" .config/overlay-fallback/value target \
