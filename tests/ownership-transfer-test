mkdir -p "$overlay_rollback_seed/.config/overlay-rollback" \
  "$overlay_rollback_seed/.config/dot/overlays.d" \
  "$overlay_rollback_seed/.config/dot/profiles.d" \
  "$overlay_rollback_seed/.config/dot/profile-selectors.d"
printf 'base\n' >"$overlay_rollback_seed/.config/overlay-rollback/value"
printf 'version=1\ndefault_profile=base\n' \
  >"$overlay_rollback_seed/.config/dot/config"
printf 'url=file://%s\n' "$overlay_rollback_common_origin" \
  >"$overlay_rollback_seed/.config/dot/overlays.d/10-common.conf"
printf 'version=1\noverlays=common\n' \
  >"$overlay_rollback_seed/.config/dot/profiles.d/base.conf"
printf 'version=1\nprofiles=base\n' \
  >"$overlay_rollback_seed/.config/dot/profiles.d/editor.conf"
printf 'version=1\nprofile=base\n' \
  >"$overlay_rollback_seed/.config/dot/profile-selectors.d/10-base.conf"
printf 'version=1\nprofile=editor\n' \
  >"$overlay_rollback_seed/.config/dot/profile-selectors.d/20-editor.conf"
commit_seed overlay-rollback-base broken-adoption

overlay_rollback_log=$DOT_TEST_TMP/overlay-rollback.log
overlay_rollback_status=0
run_dot "$overlay_rollback_home" "$overlay_rollback_state" update -f \
  >"$overlay_rollback_log" 2>&1 || overlay_rollback_status=$?
assert_eq 1 "$overlay_rollback_status" \
  'failed overlay-to-base transfer reports failure'
assert_contains 'adopted 1 managed overlay path for the base repository' \
  "$(<"$overlay_rollback_log")" \
  'failed transfer reached managed-link adoption before rollback'
[[ -L $overlay_rollback_home/.config/overlay-rollback/value ]] ||
  fail 'failed overlay-to-base transfer did not restore the source link'
assert_eq "$overlay_rollback_target" \
  "$(readlink "$overlay_rollback_home/.config/overlay-rollback/value")" \
  'failed overlay-to-base transfer restores the exact source target'
assert_eq overlay "$(<"$overlay_rollback_home/.config/overlay-rollback/value")" \
  'failed overlay-to-base transfer restores source content'
assert_no_pull_backup "$overlay_rollback_home" \
  'failed overlay-to-base transfer avoids managed-link backups'

rm "$overlay_rollback_seed/.config/dot/profile-selectors.d/20-editor.conf"
commit_seed overlay-rollback-base repair-adoption
run_dot "$overlay_rollback_home" "$overlay_rollback_state" update -f >/dev/null
[[ -f $overlay_rollback_home/.config/overlay-rollback/value &&
  ! -L $overlay_rollback_home/.config/overlay-rollback/value ]] ||
  fail 'repaired overlay-to-base transfer did not publish the base file'
assert_eq base "$(<"$overlay_rollback_home/.config/overlay-rollback/value")" \
  'repaired overlay-to-base transfer converges'
assert_no_pull_backup "$overlay_rollback_home" \
  'repaired overlay-to-base transfer avoids managed-link backups'

