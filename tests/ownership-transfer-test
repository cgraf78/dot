rm "$replaced_managed_seed/.config/dot/overlays.d/20-source.conf"
mkdir -p "$replaced_managed_seed/.config/replaced-managed"
printf 'base\n' >"$replaced_managed_seed/.config/replaced-managed/value"
commit_seed replaced-managed-base adopt-replaced-path
replaced_managed_log=$DOT_TEST_TMP/replaced-managed.log
run_dot "$replaced_managed_home" "$replaced_managed_state" update -f \
  >"$replaced_managed_log" 2>&1
assert_eq base \
  "$(<"$replaced_managed_home/.config/replaced-managed/value")" \
  'user-replaced path converges to base content'
replaced_managed_backup=''
for candidate in "$replaced_managed_home"/.dot-backup/pull/*; do
  [[ -d $candidate ]] || continue
  if [[ -f $candidate/.config/replaced-managed/value ]]; then
    replaced_managed_backup=$candidate/.config/replaced-managed/value
  fi
done
[[ -n $replaced_managed_backup ]] ||
  fail 'user replacement was not preserved in a pull backup'
assert_eq 'user replacement' "$(<"$replaced_managed_backup")" \
  'pull backup preserves replacement bytes'
[[ $(<"$replaced_managed_log") != *'adopted 1 managed overlay path'* ]] ||
  fail 'user replacement was incorrectly classified as managed adoption'

printf '%s\n' '=== mixed managed and user-owned base conflicts ==='
fixture_repo mixed-conflict-source main \
  home/.config/mixed-conflict/managed $'overlay\n' 100644
mixed_conflict_source_origin=$REPLY
fixture_repo mixed-conflict-base main \
  .config/dot/overlays.d/20-source.conf \
  "url=file://$mixed_conflict_source_origin" 100644 \
  README.md $'base\n' 100644
