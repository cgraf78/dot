  "file://$overlay_rollback_origin" >/dev/null
overlay_rollback_target=$(readlink \
  "$overlay_rollback_home/.config/overlay-rollback/value")

overlay_rollback_seed=$DOT_TEST_TMP/overlay-rollback-base-seed
