cleanup() {
  if [[ -n $guarded_escape_pid && -n $guarded_escape_identity ]] \
    && process_is_live "$guarded_escape_pid" "$guarded_escape_identity"; then
    kill -KILL "$guarded_escape_pid" 2>/dev/null || :
