    && process_is_live "$guarded_stderr_relay_pid" "$guarded_stderr_relay_identity"; then
    kill -KILL "$guarded_stderr_relay_pid" 2>/dev/null || :
  fi
  if [[ -n $guarded_output_holder_pid ]]; then
    kill -KILL "$guarded_output_holder_pid" 2>/dev/null || :
    wait "$guarded_output_holder_pid" 2>/dev/null || :
  fi
  if [[ -n $guarded_output_filler_pid ]]; then
    kill -KILL "$guarded_output_filler_pid" 2>/dev/null || :
    wait "$guarded_output_filler_pid" 2>/dev/null || :
  fi
  if [[ -n $guarded_job_pid && -n $guarded_job_identity ]] \
    && process_is_live "$guarded_job_pid" "$guarded_job_identity"; then
    kill -KILL "$guarded_job_pid" 2>/dev/null || :
