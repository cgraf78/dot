    # shellcheck disable=SC2034 # The sourced validator consumes this global.
    PERF_RUNNER_IMAGE=$runner_image
    mkdir -p "$directory"
    {
      printf 'key\tvalue\n'
      printf 'format\tperformance-metadata-v2\n'
      printf 'run_id\t%s\n' "$run_id"
      printf 'shell_commit\t%s\n' "$shell_commit"
      printf 'shell_tree\t%s\n' "$shell_tree"
      printf 'rust_commit\t%s\n' "$rust_commit"
      printf 'rust_tree\t%s\n' "$rust_tree"
      printf 'rust_worktree_dirty\tfalse\n'
      printf 'profile\trelease\n'
      printf 'samples\t30\n'
      printf 'startup_warmups\t10\nupdate_warmups\t2\n'
      printf 'disjoint_overlays\t3\nfeature_selected_overlays\t3\n'
      printf 'feature_declared_overlays\t4\nfiles_per_overlay\t20\n'
      printf 'os\tlinux\narch\tx86_64\ncpu_count\t2\ncpu_class\tsmall\n'
      printf 'runner_image\t%s\n' "$runner_image"
      printf 'command_timeout_ns\t30000000000\n'
      printf 'artifact_location\tconfigured-output\nclient_path_policy\tcontrolled\n'
      printf 'git_location\tsystem-tool\ngit_version\t%s\n' "$git_version"
      printf 'git_blob\t%s\n' "$git_blob"
      printf 'bash_location\tsystem-tool\nbash_version\t%s\n' "$bash_version"
      printf 'bash_blob\t%s\n' "$bash_blob"
      printf 'cargo_location\tselected-build-tool\ncargo_version\t%s\n' "$cargo_version"
      printf 'cargo_blob\t%s\n' "$cargo_blob"
      printf 'rustc_location\tselected-build-tool\nrustc_version\t%s\n' "$rustc_version"
      printf 'rustc_blob\t%s\n' "$rustc_blob"
      printf 'shell_executable_location\thistorical-checkout/bin/dot\n'
      printf 'shell_executable_blob\t%s\n' "$shell_blob"
      printf 'rust_executable_location\trun-private-target/dot/release/dot\n'
      printf 'rust_executable_blob\t%s\n' "$rust_blob"
      printf 'shdeps_location\tprovider-checkout\n'
      printf 'current_shdeps_lock_revision\t%s\n' "$shdeps_commit"
      printf 'shell_shdeps_lock_revision\t%s\n' "$shell_shdeps_commit"
      printf 'shdeps_abi\t%s\n' "$shdeps_abi"
      printf 'shdeps_commit\t%s\n' "$shdeps_commit"
      printf 'shdeps_tree\t%s\n' "$shdeps_tree"
      printf 'shdeps_executable_location\trun-private-target/shdeps/release/shdeps\n'
      printf 'shdeps_executable_blob\t%s\n' "$shdeps_blob"
      printf 'fixture_filesystem\ttype=other;options=rw\n'
      printf 'source_filesystem\ttype=other;options=rw\n'
      printf 'binary_filesystem\ttype=other;options=rw\n'
    } >"$directory/metadata.tsv"
    printf 'run_id\tengine\tworkload\titeration\torder\tposition\telapsed_ns\texit_code\tvalidated\n' \
      >"$directory/samples.tsv"
    printf '%s\trust\tfirst-spawn\t0\trust-only\t1\t10\t0\ttrue\n' "$run_id" \
      >>"$directory/samples.tsv"
    for workload in help version base-clean disjoint-clean disjoint-dirty \
      profile-provider-hooks-collision pre-sync-failure; do
      for iteration in {1..30}; do
        if ((iteration % 2 == 1)); then
          order=shell-rust
          printf '%s\tshell\t%s\t%s\t%s\t1\t100\t%s\ttrue\n' \
            "$run_id" "$workload" "$iteration" "$order" \
            "$([[ $workload == pre-sync-failure ]] && printf 1 || printf 0)" \
            >>"$directory/samples.tsv"
          printf '%s\trust\t%s\t%s\t%s\t2\t50\t%s\ttrue\n' \
            "$run_id" "$workload" "$iteration" "$order" \
            "$([[ $workload == pre-sync-failure ]] && printf 1 || printf 0)" \
            >>"$directory/samples.tsv"
        else
          order=rust-shell
          printf '%s\trust\t%s\t%s\t%s\t1\t50\t%s\ttrue\n' \
            "$run_id" "$workload" "$iteration" "$order" \
            "$([[ $workload == pre-sync-failure ]] && printf 1 || printf 0)" \
            >>"$directory/samples.tsv"
          printf '%s\tshell\t%s\t%s\t%s\t2\t100\t%s\ttrue\n' \
            "$run_id" "$workload" "$iteration" "$order" \
            "$([[ $workload == pre-sync-failure ]] && printf 1 || printf 0)" \
            >>"$directory/samples.tsv"
        fi
      done
    done
    printf 'run_id\tworkload\tsamples\tshell_median_ns\tshell_p95_ns\trust_median_ns\trust_p95_ns\tmax_rust_percent\trust_p95_budget_ns\tresult\n' \
      >"$directory/summary.tsv"
    printf '%s\tfirst-spawn\t1\t\t\t10\t10\t\t100000000\tpass\n' "$run_id" \
      >>"$directory/summary.tsv"
    while read -r workload budget max_percent; do
      [[ $max_percent != - ]] || max_percent=
      printf '%s\t%s\t30\t100\t100\t50\t50\t%s\t%s\tpass\n' \
        "$run_id" "$workload" "$max_percent" "$budget"
    done >>"$directory/summary.tsv" <<'EOF'
help 24075000 75
version 23850000 75
base-clean 4000000000 75
disjoint-clean 1602500000 75
disjoint-dirty 2010000000 75
profile-provider-hooks-collision 12000000000 75
pre-sync-failure 4000000000 75
EOF
    bind_calibration "$directory"
    perf_write_final_driver "$directory" "$run_id" "$shell_commit" "$shell_tree" \
      "$rust_commit" "$rust_tree" false "$shdeps_commit" "$shdeps_tree"
  }

  bind_calibration() {
    local directory=$1 metadata_blob samples_blob summary_blob
    local workload samples shell_median rust_median rust_p95 budget observed_percent headroom
    local git_blob bash_blob cargo_blob rustc_blob shell_blob rust_blob shdeps_blob
    local line first=true
    metadata_blob=$(evidence_blob "$directory/metadata.tsv")
    samples_blob=$(evidence_blob "$directory/samples.tsv")
    summary_blob=$(evidence_blob "$directory/summary.tsv")
    git_blob=$(evidence_blob "$PERF_GIT")
    bash_blob=$(evidence_blob "$PERF_BASH")
    cargo_blob=$(evidence_blob "$PERF_CARGO")
    rustc_blob=$(evidence_blob "$PERF_RUSTC")
    shell_blob=$(evidence_blob "$shell_executable")
    rust_blob=$(evidence_blob "$rust_executable")
    shdeps_blob=$(evidence_blob "$shdeps_executable")
    printf 'run_id\tshell_commit\tshell_tree\trust_commit\trust_tree\tshdeps_commit\tshdeps_tree\tgit_blob\tbash_blob\tcargo_blob\trustc_blob\tshell_executable_blob\trust_executable_blob\tshdeps_executable_blob\tmetadata_blob\tsamples_blob\tsummary_blob\tworkload\tsamples\tshell_median_ns\trust_median_ns\trust_p95_ns\trust_p95_budget_ns\tobserved_rust_percent\tbudget_headroom_percent\n' \
      >"$directory/calibration.tsv"
    while IFS= read -r line; do
      if [[ $first == true ]]; then
        first=false
        continue
      fi
      perf_split_tsv_line "$line" 10
      workload=${REPLY_FIELDS[1]}
      samples=${REPLY_FIELDS[2]}
      shell_median=${REPLY_FIELDS[3]}
      rust_median=${REPLY_FIELDS[5]}
      rust_p95=${REPLY_FIELDS[6]}
      budget=${REPLY_FIELDS[8]}
      result=${REPLY_FIELDS[9]}
      [[ $result == pass ]] || continue
      if [[ -n $shell_median ]]; then
        observed_percent=$(((rust_median * 100 + shell_median - 1) / shell_median))
      else
        observed_percent=
      fi
      headroom=$(((budget - rust_p95) * 100 / budget))
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$run_id" "$shell_commit" "$shell_tree" "$rust_commit" "$rust_tree" \
        "$shdeps_commit" "$shdeps_tree" \
        "$git_blob" "$bash_blob" "$cargo_blob" "$rustc_blob" \
        "$shell_blob" "$rust_blob" "$shdeps_blob" "$metadata_blob" \
        "$samples_blob" "$summary_blob" "$workload" "$samples" \
        "$shell_median" "$rust_median" "$rust_p95" "$budget" \
        "$observed_percent" "$headroom"
    done >>"$directory/calibration.tsv" <"$directory/summary.tsv"
  }

  evidence_args=("$run_id" "$shell_commit" "$shell_tree" "$rust_commit" "$rust_tree" \
    false "$shdeps_commit" "$shdeps_tree" "$shell_shdeps_commit" "$shdeps_abi" \
    "$shell_executable" "$rust_executable" "$shdeps_executable")

  finalize_fixture() {
    local directory=$1
    rm -f "$directory/completion.tsv"
    perf_validate_provisional_run "$directory" "${evidence_args[@]}" || return 1
    perf_write_completion_manifest "$directory/completion.tsv"
  }

  validate_fixture() {
    perf_validate_completed_run "$1" "${evidence_args[@]}"
  }

  valid=$evidence_validation_root/valid
  write_evidence_results "$valid"
  finalize_fixture "$valid"
  validate_fixture "$valid" || {
    printf 'validator rejected complete evidence\n' >&2
    exit 1
  }
  validate_fixture "$valid" || {
    printf 'validator could not reload immutable evidence\n' >&2
    exit 1
  }

  truncated=$evidence_validation_root/truncated
  cp -R "$valid" "$truncated"
  truncate -s -1 "$truncated/samples.tsv"
  if validate_fixture "$truncated"; then
    printf 'validator accepted a truncated sample file\n' >&2
    exit 1
  fi

  mixed=$evidence_validation_root/mixed-run
  cp -R "$valid" "$mixed"
  sed -i '2s/^1111111111111111111111111111111111111111/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/' \
    "$mixed/samples.tsv"
  if validate_fixture "$mixed"; then
    printf 'validator accepted mixed run identities\n' >&2
    exit 1
  fi

  reordered=$evidence_validation_root/reordered
  cp -R "$valid" "$reordered"
  awk 'NR == 3 { held = $0; next } NR == 4 { print; print held; next } { print }' \
    "$reordered/samples.tsv" \
    >"$reordered/samples.reordered"
  mv "$reordered/samples.reordered" "$reordered/samples.tsv"
  if validate_fixture "$reordered"; then
    printf 'validator accepted samples recorded out of execution order\n' >&2
    exit 1
  fi

  wrong_count=$evidence_validation_root/wrong-count
  cp -R "$valid" "$wrong_count"
  sed -i '$d' "$wrong_count/samples.tsv"
  if validate_fixture "$wrong_count"; then
    printf 'validator accepted incomplete sample coverage\n' >&2
    exit 1
  fi

  altered=$evidence_validation_root/altered-summary
  cp -R "$valid" "$altered"
  sed -i '2s/pass$/fail/' "$altered/summary.tsv"
  if validate_fixture "$altered"; then
    printf 'validator accepted an altered summary result\n' >&2
    exit 1
  fi

  unexpected=$evidence_validation_root/unexpected-file
  cp -R "$valid" "$unexpected"
  printf 'PRIVATE_UNKNOWN_DEBUG_FILE\n' >"$unexpected/debug.log"
  if validate_fixture "$unexpected"; then
    printf 'validator accepted an unexpected artifact file\n' >&2
    exit 1
  fi

  altered_calibration=$evidence_validation_root/altered-calibration
  cp -R "$valid" "$altered_calibration"
  sed -i '3s/\t50\t99$/\t51\t99/' "$altered_calibration/calibration.tsv"
  if validate_fixture "$altered_calibration"; then
    printf 'validator accepted a miscomputed calibration ratio\n' >&2
    exit 1
  fi

  stale_calibration=$evidence_validation_root/stale-calibration
  cp -R "$valid" "$stale_calibration"
  sed -i '2s/4444444444444444444444444444444444444444/5555555555555555555555555555555555555555/' \
    "$stale_calibration/calibration.tsv"
  if validate_fixture "$stale_calibration"; then
    printf 'validator accepted stale calibration provenance\n' >&2
    exit 1
  fi

  for immutable in driver metadata samples summary calibration; do
    mutated=$evidence_validation_root/mutated-$immutable
    cp -R "$valid" "$mutated"
    printf '# mutation\n' >>"$mutated/$immutable.tsv"
    if validate_fixture "$mutated"; then
      printf 'validator accepted a mutated %s file\n' "$immutable" >&2
      exit 1
    fi
  done

  wrong_invocation=$evidence_validation_root/wrong-invocation
  cp -R "$valid" "$wrong_invocation"
  sed -i 's/--exact/--ignored/' "$wrong_invocation/driver.tsv"
  if validate_fixture "$wrong_invocation"; then
    printf 'validator accepted a mismatched Cargo invocation\n' >&2
    exit 1
  fi

  for metadata_case in extra missing control absolute private version lock omitted-lock; do
    malformed=$evidence_validation_root/metadata-$metadata_case
    cp -R "$valid" "$malformed"
    case $metadata_case in
      extra) printf 'extra_field\tvalue\n' >>"$malformed/metadata.tsv" ;;
      missing) sed -i '/^cpu_class\t/d' "$malformed/metadata.tsv" ;;
      control) printf 'extra_control\tbad\001value\n' >>"$malformed/metadata.tsv" ;;
      absolute) sed -i 's/^runner_image\t.*/runner_image\t\/private\/runner/' "$malformed/metadata.tsv" ;;
      private) sed -i 's/^runner_image\t.*/runner_image\tPRIVATE_SENTINEL/' "$malformed/metadata.tsv" ;;
      version) sed -i 's/^git_version\t.*/git_version\tgit malformed version/' "$malformed/metadata.tsv" ;;
      lock) sed -i "s/^shell_shdeps_lock_revision\t.*/shell_shdeps_lock_revision\t$shdeps_commit/" "$malformed/metadata.tsv" ;;
      omitted-lock) sed -i '/^shell_shdeps_lock_revision\t/d' "$malformed/metadata.tsv" ;;
    esac
    if validate_fixture "$malformed"; then
      printf 'validator accepted malformed metadata case %s\n' "$metadata_case" >&2
      exit 1
    fi
  done

  for completion_case in extra missing hash invocation; do
    malformed=$evidence_validation_root/completion-$completion_case
    cp -R "$valid" "$malformed"
    case $completion_case in
      extra) printf 'extra_field\tvalue\n' >>"$malformed/completion.tsv" ;;
      missing) sed -i '/^driver_blob\t/d' "$malformed/completion.tsv" ;;
      hash) sed -i 's/^driver_blob\t.*/driver_blob\t0000000000000000000000000000000000000000/' "$malformed/completion.tsv" ;;
      invocation) sed -i 's/--exact/--ignored/' "$malformed/completion.tsv" ;;
    esac
    if validate_fixture "$malformed"; then
      printf 'validator accepted malformed completion case %s\n' "$completion_case" >&2
      exit 1
    fi
  done

  invalid_provisional=$evidence_validation_root/invalid-provisional
  cp -R "$valid" "$invalid_provisional"
  rm "$invalid_provisional/completion.tsv"
  sed -i '$d' "$invalid_provisional/samples.tsv"
  if perf_validate_provisional_run "$invalid_provisional" "${evidence_args[@]}" &&
    perf_write_completion_manifest "$invalid_provisional/completion.tsv"; then
    printf 'invalid provisional evidence reached completion\n' >&2
    exit 1
  fi
  [[ ! -e $invalid_provisional/completion.tsv ]] || {
    printf 'validation failure after Rust left a passed completion\n' >&2
    exit 1
  }

  publication=$evidence_validation_root/publication
  staging=$evidence_validation_root/publication-staging
  cp -R "$valid" "$staging"
  rm "$staging/completion.tsv"
  perf_acquire_artifact_lifecycle / "$publication"
  publication=$REPLY
  perf_prepare_artifacts / "$publication"
  validate_fixture "$valid"
  perf_publish_completed_run "$staging" "$valid/completion.tsv" "$publication" "$run_id"
  published=$REPLY
  [[ $published == "$publication.run-$run_id" ]] || {
    printf 'publication did not use its unique run identity\n' >&2
    exit 1
  }
  validate_fixture "$published" || {
    printf 'publication did not preserve validated evidence\n' >&2
    exit 1
  }
  perf_require_empty_artifact_directory "$publication"
  perf_release_artifact_lifecycle

  validate_upload() {
    DOT_PERF_GIT=$PERF_GIT DOT_PERF_BASH=$PERF_BASH \
      DOT_PERF_CARGO=$PERF_CARGO DOT_PERF_RUSTC=$PERF_RUSTC \
      "$DOT_TEST_ROOT/scripts/benchmark-port.sh" --validate-publication "$1"
  }
  validate_upload "$published" || {
    printf 'standalone upload validation rejected a sealed publication\n' >&2
    exit 1
  }
  github_output=$evidence_validation_root/github-output
  : >"$github_output"
  GITHUB_OUTPUT=$github_output perf_expose_publication_path "$published"
  [[ $(cat "$github_output") == "publication_dir=$published" ]] || {
    printf 'performance driver did not expose the exact publication path\n' >&2
    exit 1
  }
  published_completion_blob=$(git hash-object --no-filters -- "$published/completion.tsv")
  perf_acquire_artifact_lifecycle / "$publication"
  publication=$REPLY
  perf_prepare_artifacts / "$publication"
  validate_fixture "$valid"
  if perf_publish_completed_run "$staging" "$valid/completion.tsv" \
    "$publication" "$run_id" 2>/dev/null; then
    printf 'later publisher reused an existing run-specific publication\n' >&2
    exit 1
  fi
  perf_release_artifact_lifecycle
  [[ $published_completion_blob == \
    "$(git hash-object --no-filters -- "$published/completion.tsv")" ]] || {
    printf 'later publisher changed an existing run-specific publication\n' >&2
    exit 1
  }

  publication_link=$evidence_validation_root/publication-root-symlink.run-$run_id
  ln -s "$published" "$publication_link"
  if validate_upload "$publication_link" 2>/dev/null; then
    printf 'standalone upload validation accepted a symlink publication root\n' >&2
    exit 1
  fi
  for immutable in driver metadata samples summary calibration completion; do
    post_confirm=$evidence_validation_root/post-confirmation-$immutable.run-$run_id
    cp -R "$published" "$post_confirm"
    validate_upload "$post_confirm" || exit 1
    printf '# post-confirmation mutation\n' >>"$post_confirm/$immutable.tsv"
    if validate_upload "$post_confirm" 2>/dev/null; then
      printf 'standalone upload validation accepted mutated %s evidence\n' \
        "$immutable" >&2
      exit 1
    fi
  done
  partial_upload=$evidence_validation_root/partial-upload.run-$run_id
  cp -R "$published" "$partial_upload"
  rm "$partial_upload/summary.tsv"
  if validate_upload "$partial_upload" 2>/dev/null; then
    printf 'standalone upload validation accepted a partial publication\n' >&2
    exit 1
  fi
  mixed_upload=$evidence_validation_root/mixed-upload.run-$run_id
  cp -R "$published" "$mixed_upload"
  sed -i '2s/^1111111111111111111111111111111111111111/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/' \
    "$mixed_upload/samples.tsv"
  if validate_upload "$mixed_upload" 2>/dev/null; then
    printf 'standalone upload validation accepted mixed-run evidence\n' >&2
    exit 1
  fi

  for injected in debug completion-directory completion-symlink; do
    rejected_publication=$evidence_validation_root/rejected-$injected
    perf_acquire_artifact_lifecycle / "$rejected_publication"
    rejected_publication=$REPLY
    perf_prepare_artifacts / "$rejected_publication"
    rejected_target=$rejected_publication.run-$run_id
    mkdir "$rejected_target"
    case $injected in
      debug) printf 'PRIVATE_UNKNOWN_DEBUG_FILE\n' >"$rejected_target/debug.log" ;;
      completion-directory) mkdir "$rejected_target/completion.tsv" ;;
      completion-symlink) ln -s "$valid/completion.tsv" "$rejected_target/completion.tsv" ;;
    esac
    validate_fixture "$valid"
    if perf_publish_completed_run "$staging" "$valid/completion.tsv" \
      "$rejected_publication" "$run_id" 2>/dev/null; then
      printf 'publication accepted injected %s target\n' "$injected" >&2
      exit 1
    fi
    [[ ! -f $rejected_target/completion.tsv \
      || -L $rejected_target/completion.tsv ]] || {
      printf 'rejected %s target exposed passed completion\n' "$injected" >&2
      exit 1
    }
    perf_release_artifact_lifecycle
  done

  for immutable in driver metadata samples summary calibration completion; do
    failed=$evidence_validation_root/post-copy-mutation-$immutable
    sealed=$evidence_validation_root/.post-copy-$immutable
    validate_fixture "$valid"
    perf_build_sealed_publication "$staging" "$valid/completion.tsv" "$sealed"
    printf '# post-copy mutation\n' >>"$sealed/$immutable.tsv"
    if perf_publish_sealed_directory "$sealed" "$failed" 2>/dev/null; then
      printf 'publication accepted post-copy %s mutation\n' "$immutable" >&2
      exit 1
    fi
    [[ ! -e $failed/completion.tsv ]] || {
      printf 'post-copy %s mutation exposed passed completion\n' "$immutable" >&2
      exit 1
    }
    rm -rf "$sealed"
  done

  eval "$(declare -f perf_validate_expected_completed_run | \
    sed '1s/perf_validate_expected_completed_run/perf_validate_expected_completed_run_original/')"
  # shellcheck disable=SC2329 # Called indirectly by perf_publish_sealed_directory.
  perf_validate_expected_completed_run() {
    if [[ -n ${injected_post_rename_file:-} ]]; then
      post_rename_validation_calls=$((post_rename_validation_calls + 1))
      if ((post_rename_validation_calls == 2)); then
        printf '# post-rename mutation\n' >>"$1/$injected_post_rename_file.tsv"
      fi
    fi
    perf_validate_expected_completed_run_original "$@"
  }
  for immutable in driver metadata samples summary calibration completion; do
    failed=$evidence_validation_root/post-rename-mutation-$immutable
    sealed=$evidence_validation_root/.post-rename-$immutable
    validate_fixture "$valid"
    perf_build_sealed_publication "$staging" "$valid/completion.tsv" "$sealed"
    injected_post_rename_file=$immutable
    post_rename_validation_calls=0
    if perf_publish_sealed_directory "$sealed" "$failed" 2>/dev/null; then
      printf 'publication accepted post-rename %s mutation\n' "$immutable" >&2
      exit 1
    fi
    unset injected_post_rename_file
    [[ ! -e $failed ]] || {
      printf 'post-rename %s mutation remained workflow-visible\n' "$immutable" >&2
      exit 1
    }
    rm -rf "$sealed"
  done

  real_cp=$PERF_CP
  real_mv=$PERF_MV
  failure_tool=$evidence_validation_root/failure-tool
  cat >"$failure_tool" <<'EOF'
#!/bin/bash
last=
for argument do last=$argument; done
if [[ $last == *"$PERF_FAIL_DEST" ]]; then
  exit 91
fi
exec "$PERF_REAL_TOOL" "$@"
EOF
  chmod 0700 "$failure_tool"
  export PERF_FAIL_DEST PERF_REAL_TOOL

  PERF_CP=$failure_tool
  PERF_REAL_TOOL=$real_cp
  for file in driver metadata samples summary calibration completion; do
    failed=$evidence_validation_root/fail-copy-$file
    perf_acquire_artifact_lifecycle / "$failed"
    failed=$REPLY
    perf_prepare_artifacts / "$failed"
    PERF_FAIL_DEST=/$file.tsv
    validate_fixture "$valid"
    if perf_publish_completed_run "$staging" "$valid/completion.tsv" \
      "$failed" "$run_id" 2>/dev/null; then
      printf 'publication ignored %s copy failure\n' "$file" >&2
      exit 1
    fi
    [[ ! -e $failed.run-$run_id/completion.tsv ]] || {
      printf '%s copy failure exposed passed completion\n' "$file" >&2
      exit 1
    }
    perf_release_artifact_lifecycle
  done
  PERF_CP=$real_cp

  PERF_MV=$failure_tool
  PERF_REAL_TOOL=$real_mv
  failed=$evidence_validation_root/fail-final-rename
  perf_acquire_artifact_lifecycle / "$failed"
  failed=$REPLY
  perf_prepare_artifacts / "$failed"
  PERF_FAIL_DEST=$failed.run-$run_id
  validate_fixture "$valid"
  if perf_publish_completed_run "$staging" "$valid/completion.tsv" \
    "$failed" "$run_id" 2>/dev/null; then
    printf 'publication ignored final directory rename failure\n' >&2
    exit 1
