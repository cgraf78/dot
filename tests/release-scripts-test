  if [[ -n $guarded_guardian_pid && -n $guarded_guardian_identity ]] \
    && process_is_live "$guarded_guardian_pid" "$guarded_guardian_identity"; then
    kill -KILL "$guarded_guardian_pid" 2>/dev/null || :
  fi
  if [[ -n $guarded_inner_pid && -n $guarded_inner_identity ]] \
    && process_is_live "$guarded_inner_pid" "$guarded_inner_identity"; then
    kill -KILL "$guarded_inner_pid" 2>/dev/null || :
  fi
  if [[ -n $guarded_fixture_pid && -n $guarded_fixture_identity ]] \
    && process_is_live "$guarded_fixture_pid" "$guarded_fixture_identity"; then
    kill -KILL "$guarded_fixture_pid" 2>/dev/null || :
  fi
  rm -rf "$DOT_TEST_ROOT/dist"
  if [[ -n $previous_dist ]]; then
    mv "$previous_dist" "$DOT_TEST_ROOT/dist"
  fi
  rm -rf "$DOT_TEST_TMP"
}
