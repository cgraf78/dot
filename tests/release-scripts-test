  ((authority_clears >= 3)) ||
    fail 'perf_cargo must clear signal authority on every definitive reap'
  # shellcheck disable=SC2016 # The reaped-PID probe must remain literal.
  if [[ $perf_cargo_body == *'kill -0 "$supervisor_pid"'* ]]; then
    fail 'perf_cargo must not probe a reaped numeric PID'
  fi
}

check_perf_process_identity_helper() {
  local record
  record=$(bash -c '
    set -euo pipefail
    . "$1"
    self_tick=$(perf_process_start_tick "$$") || exit 10
    [[ $(perf_process_start_tick "$$") == "$self_tick" ]] || exit 11
    /bin/sleep 30 &
    child=$!
    child_tick=$(perf_process_start_tick "$child") || exit 12
    perf_process_identity_matches "$child" "$child_tick" || exit 13
    perf_process_identity_matches "$child" "0" && exit 14
    kill -KILL "$child"
    wait "$child" 2>/dev/null || :
    perf_process_identity_matches "$child" "$child_tick" && exit 15
    if new_tick=$(perf_process_start_tick "$child" 2>/dev/null); then
      [[ $new_tick != "$child_tick" ]] || exit 16
    fi
    perf_process_start_tick 999999999 >/dev/null 2>&1 && exit 17
    printf ok
  ' _ "$DOT_TEST_ROOT/scripts/benchmark-port.sh") || fail "perf process-identity helper failed: $record"
  assert_eq ok "$record" 'perf process-identity helper pins exact start identity'
}

