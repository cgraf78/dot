#!/usr/bin/env bash

set -euo pipefail

root=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/test.sh
. "$root/tests/lib/test.sh"
# shellcheck source=lib/repo.sh
. "$root/tests/lib/repo.sh"

fixture_repo nonmain trunk .testrc $'hello\n' 100644
origin=$REPLY
fixture_home nonmain
home=$REPLY
state=$DOT_TEST_TMP/nonmain-state
run_dot "$home" "$state" init --yes "file://$origin" >/dev/null
assert_eq hello "$(<"$home/.testrc")" 'non-main checkout content'
assert_eq false "$(git --git-dir="$home/.dotfiles" config core.bare)" \
  'canonical client is non-bare'
assert_eq "$home" "$(git --git-dir="$home/.dotfiles" config core.worktree)" \
  'canonical client has explicit worktree'
assert_eq no "$(git --git-dir="$home/.dotfiles" config status.showUntrackedFiles)" \
  'canonical client suppresses HOME untracked scans'
status=$(run_dot "$home" "$state" init --status)
assert_contains 'initialization: complete' "$status" 'completion status'
assert_contains 'branch: trunk' "$status" 'remote symbolic HEAD branch'

# The canonical transaction path is authority only after a complete record is
# atomically published. Recordless lookalikes are foreign evidence: exact retry
# must reject and preserve them rather than guessing that dot created them.
for partial_shape in empty tree prior conflicts record-temp; do
  partial_transaction=$state/dot/init/transaction
  mkdir -p "$partial_transaction"
  chmod 0700 "$partial_transaction"
  case $partial_shape in
    empty) ;;
    tree) printf 'partial\n' >"$partial_transaction/tree.tsv" ;;
    prior)
      printf 'partial\n' >"$partial_transaction/tree.tsv"
      printf 'partial\n' >"$partial_transaction/prior.tsv"
      ;;
    conflicts)
      printf 'partial\n' >"$partial_transaction/tree.tsv"
      printf 'partial\n' >"$partial_transaction/prior.tsv"
      printf 'partial\n' >"$partial_transaction/conflicts.tsv"
      ;;
    record-temp) printf 'partial\n' >"$partial_transaction/record.tmp.fixture" ;;
  esac
  chmod 0600 "$partial_transaction"/* 2>/dev/null || true
  set +e
  run_dot "$home" "$state" init --yes "file://$origin" >/dev/null 2>&1
  partial_status=$?
  set -e
  assert_eq 1 "$partial_status" \
    "recordless transaction lookalike is rejected: $partial_shape"
  [[ -d $partial_transaction && ! -L $partial_transaction ]] ||
    fail "recordless transaction evidence was removed: $partial_shape"
  rm -rf "$partial_transaction"
done

# Transaction preparation happens beside the canonical authority directory and
# is published with one no-replace rename. If the process dies immediately
# before that rename, the next exact invocation must recognize only dot's
# durable preparation marker, discard that pre-mutation stage, and leave no
# abandoned stage behind. A similarly named foreign directory remains outside
# dot's authority.
fixture_repo transaction-stage main .testrc $'transaction-stage\n' 100644
transaction_stage_origin=$REPLY
fixture_home transaction-stage
transaction_stage_home=$REPLY
transaction_stage_state=$DOT_TEST_TMP/transaction-stage-state
transaction_stage_bin=$DOT_TEST_TMP/transaction-stage-bin
mkdir -p "$transaction_stage_bin"
real_mv=$(type -P mv)
cat >"$transaction_stage_bin/mv" <<'MV'
#!/usr/bin/env bash
set -e
real=${DOT_TEST_REAL_MV:?}
target=${!#}
if [[ ${DOT_TEST_KILL_TRANSACTION_PUBLISH:-} == 1 &&
  $target == "$XDG_STATE_HOME/dot/init/transaction" ]]; then
  kill -KILL "$PPID"
  exit 137
fi
exec "$real" "$@"
MV
chmod 0755 "$transaction_stage_bin/mv"
set +e
PATH="$transaction_stage_bin:$PATH" DOT_TEST_REAL_MV=$real_mv \
  DOT_TEST_KILL_TRANSACTION_PUBLISH=1 \
  run_dot "$transaction_stage_home" "$transaction_stage_state" init --yes \
  "file://$transaction_stage_origin" >/dev/null 2>&1
transaction_stage_first=$?
set -e
[[ $transaction_stage_first -ne 0 ]] ||
  fail 'transaction publication interruption unexpectedly completed'
transaction_stage_candidates=("$transaction_stage_state"/dot/init/transaction.prepare.*)
[[ -d ${transaction_stage_candidates[0]} ]] ||
  fail 'transaction publication interruption left no preparation stage'
run_dot "$transaction_stage_home" "$transaction_stage_state" init --yes \
  "file://$transaction_stage_origin" >/dev/null
transaction_stage_candidates=("$transaction_stage_state"/dot/init/transaction.prepare.*)
[[ ! -e ${transaction_stage_candidates[0]} && ! -L ${transaction_stage_candidates[0]} ]] ||
  fail 'exact retry retained an owned transaction preparation stage'

