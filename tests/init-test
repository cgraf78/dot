  entry:publish-intent.* | parent:parent-intent.*)
    if [[ $phase == pending && ! -e $HOME/$stage && ! -L $HOME/$stage ]]; then
      mkdir "$HOME/$stage"
      chmod 0700 "$HOME/$stage"
      identity=$(stat -c '%d:%i' "$HOME/$stage" 2>/dev/null ||
        stat -f '%d:%i' "$HOME/$stage")
      printf '%s\t%s\n' "$HOME/$stage" "$identity" >"${DOT_TEST_LATE_STAGE_RECORD:?}"
