#!/usr/bin/env bash
set -e
real=${DOT_TEST_REAL_MV:?}
target=${!#}
"$real" "$@"
case ${DOT_TEST_LATE_STAGE_KIND:-}:"${target##*/}" in
  entry:publish-intent.*)
    IFS=$'\t' read -r phase _ _ _ stage _ <"$target"
    ;;
  parent:parent-intent.*)
    IFS=$'\t' read -r phase _ stage _ <"$target"
    ;;
  *) exit 0 ;;
